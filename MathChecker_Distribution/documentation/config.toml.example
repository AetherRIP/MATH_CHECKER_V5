# ============================================================================
#  Math Checker — configuration template (NO SECRETS IN THIS FILE)
# ============================================================================
#
#  This is a REFERENCE COPY of the settings the application keeps in
#
#      <this folder>\Data\config.toml
#
#  The running app writes that file itself the first time it starts, and every
#  setting below can be changed from inside the app (Settings, or the AI page
#  for provider keys). Editing this example file has NO effect — the app only
#  reads Data\config.toml.
#
#  WHY YOU PROBABLY DO NOT NEED TO EDIT ANYTHING
#  ---------------------------------------------
#  * API keys, Google OAuth tokens and login passwords are NOT kept here.
#    They live in Data\secrets.toml and Data\secrets\google_oauth_client.json,
#    which the app creates on the machine that uses it. Neither file is part of
#    this package, and neither is ever written by the build.
#  * To copy settings from an existing install, close the app and copy
#    Data\config.toml over this one. Delete the copy's secrets.toml and
#    secrets\google_oauth_client.json — those belong to the other computer.
#
#  If you do edit Data\config.toml by hand:
#    1. close the app first (Stop.bat) — a running app rewrites the file when
#       you change a setting, which would discard your edit;
#    2. keep the TOML syntax (strings in "quotes", [sections] on their own
#       line);
#    3. when in doubt, delete the file — the app recreates it with the values
#       below and nothing is lost except these settings.
#
# ============================================================================


[app]
# "teacher" is the normal mode. Leave it alone unless support asks you to
# change it (the shared-backend role is used by a deployment, not by a teacher).
role = "teacher"
# Marks without calling Gemini, using canned results. Only for trying the app
# out; never enable it for real marking.
mock_mode = false
# Extra diagnostics in the log. Not needed for normal use.
debug = false


[teacher]
# Filled in by the first-run wizard, and changeable later in
# Settings -> "Teacher & school".
teacher_name = ""
school_name = ""
# Set to true once the first-run wizard has been completed. The wizard appears
# while this is false — that is why a fresh copy always asks for the teacher's
# name instead of silently using somebody else's.
onboarded = false
onboarded_at = 0.0


[reports]
# Letterhead of every PDF report. Every value starts EMPTY on purpose: the
# app ships no teacher's name, centre, year, quote or monogram, so a new
# install never prints somebody else's identity. Fill these in from
# Settings -> "Report branding" (or the first-run wizard) and they become the
# permanent letterhead of every report you produce.
teacher_title = ""
center_name = ""
academic_year = ""
# Short motivating line under the centred mark.
quote = ""
# Path to YOUR logo image (absolute, or relative to the Data folder). Empty =
# a monogram drawn from the letters below (or from your own initial).
logo_path = ""
# Path to YOUR signature image. Empty = no signature. A distribution never
# carries anybody else's signature.
signature_path = ""
monogram = ""
# Internal switch for the branding images that live inside the application
# folder. Always false in a released build: those files belong to whoever
# built the app, not to you.
use_bundled_assets = false
# Small print under the footer rule. Empty = the built-in note.
footer_note = ""
# Accent colour as #RRGGBB. Empty = the design-system default.
accent = ""
# Label under a report title, e.g. TEACHER COPY / STUDENT COPY.
document_label = "TEACHER COPY"


[gemini]
# The provider chain the corrector tries, in order. These are MODEL NAMES —
# the API keys that go with them are stored in Data\secrets.toml, never here.
#
# Verified 2026-10-24 against ai.google.dev/gemini-api/docs/deprecations:
#   gemini-3.5-flash and gemini-3.7-flash are DEPRECATED aliases — Google
#   accepts them but serves gemini-3.6-flash / gemini-3.8-flash, so they are
#   deliberately absent here (an alias would retry a model that just failed).
#   On load, any deprecated ID is replaced by the model that actually serves
#   it and duplicates are removed.
primary_models = ["gemini-3.8-flash", "gemini-3.6-flash", "gemini-3.5-flash-lite"]
# The second-opinion model used by the double-check pass.
audit_models = ["gemini-3.8-flash", "gemini-3.6-flash", "gemini-3.5-flash-lite"]
# Per-request timeout in milliseconds (180000 = 3 minutes).
request_timeout_ms = 180000


[classroom]
# Google Classroom sync. Requires your own OAuth client file at
# Data\secrets\google_oauth_client.json; without it this stays off and the
# Classroom pages explain what is missing instead of failing.
enabled = false
# When true, a released mark is also written back as a draft grade.
write_draft_grades = false


[worker]
# How many correction workers may run at once. 2 suits a laptop.
concurrency = 2
# Retries when a provider call fails or returns an unusable answer.
max_retries = 2


[double_check]
# Second-opinion marking pass on a random sample of answers.
enabled = true
# Sample size as a percentage of the paper (95% = whole paper).
threshold_percentage = 95.0
low_threshold_percentage = 10.0
# How far the two passes may disagree before the answer is flagged.
disagreement_points = 15.0


[usage]
# Bandwidth guard rails for the provider API (megabytes per hour / per day).
hourly_mb = 500
daily_mb = 2000


[grades]
# Free-text label for the exam session, e.g. "June 2026".
session_label = ""
# Grade boundaries: [grade, minimum percentage]. Grades stay 1-9; the AI never
# invents a grade, it is a lookup of marks -> percentage -> band. Replace these
# with the real boundaries for your session (Settings -> Grades).
boundaries = [["1", 0.0], ["2", 20.0], ["3", 30.0], ["4", 40.0], ["5", 50.0], ["6", 60.0], ["7", 70.0], ["8", 80.0], ["9", 90.0]]


[automation]
# The automatic Classroom sweep (the "Tiny Agent"). It is OFF unless you turn
# it on, and the app never starts a background agent while this is false.
enabled = false
interval_minutes = 10
attach_report = true
submit_grade = true
return_work = true
draft_only = false
# true = new marks wait for your approval before anything is released.
review_mode = true
# "brief" or "detailed" attachments.
report_detail = "detailed"


[assignment_naming]
# How synced Classroom assignments are named: "original", "custom",
# "prefix"/"suffix".
mode = "original"
custom_name = ""
prefix = ""
suffix = ""


[retention]
# How long downloaded submissions are kept: "until_complete" or "days".
keep_submissions = "until_complete"
keep_days = 30
# Clear Data\tmp when the app starts.
cleanup_temp_on_start = true


[network]
# "local" = this computer only. "lan" is an explicit opt-in; public/tunnel
# access is switched on from Settings -> Public Address, not here.
access_mode = "local"
# Backend port. The user interface talks to http://127.0.0.1:<port>.
port = 8642


[security]
# Login gate. Public Address always requires it, whatever this says.
enabled = false
login_required = true
# How long a signed-in session lasts before re-login is required.
session_hours = 12


[accounts]
# Multi-account support (several teachers on one install). Keep the column
# structures intact even while this is false.
multi_account = false


[testing]
# Puts the app into its guarded testing mode. Leave false.
only = false


[scheme_audit]
# Disagreement records and teacher review; never authorizes bulk changes.
enabled = true
# Minimum confidence for staging supported recommendations, NOT proof of truth.
confirm_confidence = 0.85

[lifecycle]
# Start on demand and stop when nobody is using the app.
# ``enabled`` is the STOP half: the backend stops itself once no browser
# session has been seen for the grace period and nothing is running.
# ``supervisor`` is the START half: a tiny relay owns the public port and
# starts the backend on the first connection, so a stopped app is one page
# load away. Turning it off restores one always-on process on the port.
enabled = true
supervisor = true
# Seconds between browser heartbeats.
heartbeat_seconds = 30
# A session with no heartbeat for this long is treated as gone.
session_timeout_seconds = 90
# Grace period after the last session before an idle shutdown is considered.
idle_grace_seconds = 120
# Longest a shutdown will wait for running work (a correction, a long
# document, an open database write) before it gives up and keeps running.
max_shutdown_wait_seconds = 900
# Final cancellation window before the process actually exits.
last_chance_seconds = 5
# Private port the backend listens on behind the relay. 0 lets the operating
# system choose a free one, which is what almost every install wants.
backend_port = 0

# Browser development backend (read by vite.config.ts).
#
# Copy this file to `.env.local` and change the port only if your backend runs
# somewhere else. There is no default: `npm run dev` stops with an explanation
# when this value is missing, because guessing a port is how a demo backend
# ended up looking like the teacher's real class.
#
#   python main.py 8642            real local backend on 8642
#   python main.py 8643            a second, separate install
#   python main.py --demo 8642     DEMO data (the UI labels it DEMO)
#
# Never put API keys, OAuth client secrets or tokens in this file: they belong
# in the backend's own data folder (Settings → AI keys / Classroom setup) and
# must never reach a browser bundle.
MC5_DEV_API=http://127.0.0.1:8642

<UserControl x:Class="MathChecker.Desktop.Views.StudentProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <Grid Margin="0,2,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Compact identity strip: avatar, name, class and the source of each fact.
             Deliberately not a half-screen hero. -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48" CornerRadius="10" VerticalAlignment="Center"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding Profile.Initials}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Profile.Name}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <WrapPanel Margin="0,3,0,0">
                        <TextBlock Text="{Binding Profile.ClassText}" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="  ·  Google Classroom ID " FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Profile.StudentId}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Profile.Email, StringFormat=  ·  {0}}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Profile.IdentitySource}" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource AccentChip}" HorizontalAlignment="Right"
                            Visibility="{Binding ShowTrackingWarning, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="Classroom data connected" FontSize="11"
                                   Foreground="{DynamicResource CanvasDeepBrush}" />
                    </Border>
                    <Border Style="{StaticResource WarningChip}" HorizontalAlignment="Right"
                            Visibility="{Binding ShowTrackingWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="No Classroom data" FontSize="11"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                    </Border>
                    <TextBlock Text="Loading…" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Section tabs use the shell's own space-tab style, so a profile reads
             as part of the application rather than a nested website. -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                 Style="{StaticResource SpaceTabs}" Margin="0,0,0,10"
                 AutomationProperties.Name="Student profile sections" />

        <Grid Grid.Row="2">

            <!-- ============================================================
                 OVERVIEW
                 ============================================================ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"
                          Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,10"
                            Visibility="{Binding ShowTrackingWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding TrackingWarning}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource StatTile}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Assignments" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding AssignmentsText}" Style="{StaticResource DisplayFigure}"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Profile.Sources.SubmissionStatus}"
                                           Style="{StaticResource CardSubtitle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource StatTile}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Submitted" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding SubmittedText}" Style="{StaticResource DisplayFigure}"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="Google Classroom states" Style="{StaticResource CardSubtitle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource StatTile}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Not submitted" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding OutstandingText}" Style="{StaticResource DisplayFigure}"
                                           Margin="0,2,0,0" Foreground="{DynamicResource WarningTextBrush}" />
                                <TextBlock Text="No work handed in, draft or reclaimed" Style="{StaticResource CardSubtitle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource StatTile}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Average (Math Checker)" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding McAverageText}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Profile.ScoresSource}"
                                           Style="{StaticResource CardSubtitle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Performance" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="Classroom grades and Math Checker marks stay separate"
                                           Style="{StaticResource CardSubtitle}" Margin="0,2,0,8" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Google Classroom" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="{Binding ClassroomAverageText}" FontSize="22"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="average, marked work only"
                                                   Style="{StaticResource CardSubtitle}" />
                                        <TextBlock Text="{Binding ClassroomGradedText}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding ClassroomSpreadText, StringFormat=High / low  {0}}"
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Math Checker" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="{Binding OverallText}" FontSize="18"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="all stored corrections"
                                                   Style="{StaticResource CardSubtitle}" />
                                        <TextBlock Text="{Binding McSpreadText, StringFormat=High / low  {0}}"
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding ZerosText, StringFormat=Actual zeros  {0}}"
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource Divider}" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding Profile.ScoresSource}" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Status and activity" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="Submission behaviour and correction activity"
                                           Style="{StaticResource CardSubtitle}" Margin="0,2,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding OnTimeText, StringFormat=On time  {0}}"
                                                   FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding LateCountText, StringFormat=Late  {0}}"
                                                   FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding MissingCountText, StringFormat=Outstanding incl. 0  {0}}"
                                                   FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding DraftText, StringFormat=Draft  {0}}"
                                                   FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding CorrectionsValueText, StringFormat=Corrections  {0}}"
                                                   FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding PendingText, StringFormat=Pending jobs  {0}}"
                                                   FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding NeedsReviewText, StringFormat=Need review  {0}}"
                                                   FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding FailedJobsText, StringFormat=Failed jobs  {0}}"
                                                   FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding LastCorrectionText, StringFormat=Last corrected  {0}}"
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="{Binding Profile.CorrectionSource}" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Patterns are shown only when the stored question breakdowns
                         support them; otherwise the honest empty line is shown. -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Patterns" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="From the topic marks stored with recent corrections"
                                       Style="{StaticResource CardSubtitle}" Margin="0,2,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Highest-scoring topics" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding StrengthText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Lowest-scoring topics" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding FocusText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Repeated difficulty" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding RepeatedText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding TopicNote}" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================================================
                 ASSIGNMENTS
                 ============================================================ -->
            <Grid Visibility="{Binding IsAssignments, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource FilterBar}">
                    <WrapPanel>
                        <TextBlock Text="Show" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="160" ItemsSource="{Binding AssignmentFilters}"
                                  SelectedItem="{Binding AssignmentFilter}"
                                  AutomationProperties.Name="Filter assignments"
                                  AutomationProperties.AutomationId="AssignmentFilterCombo"
                                  AutomationProperties.HelpText="Filters the assignment list. Alt+Down opens the list, arrow keys choose, Enter applies." />
                        <Border Style="{StaticResource Chip}" Padding="9,3" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding AssignmentCountText}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <TextBlock Text="Click a column header to sort." FontSize="11" VerticalAlignment="Center"
                                   Margin="12,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                    </WrapPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource TableCard}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Open correction" Style="{StaticResource PrimaryButton}"
                                            Height="28" Padding="10,2" Margin="0,0,6,0"
                                            Command="{Binding OpenAssignmentCorrectionCommand}" />
                                    <Button Content="Export PDF" Style="{StaticResource GhostButton}"
                                            Height="28" Padding="10,2" Margin="0"
                                            Command="{Binding ExportAssignmentReportCommand}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Assignment history" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Submission state from Google Classroom; marks from local corrections."
                                               Style="{StaticResource CardSubtitle}" Margin="0,1,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Padding="12,7"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
                            <TextBlock Text="{Binding SelectedAssignmentHint}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Grid>
                            <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="0"
                                      ItemsSource="{Binding Assignments}" SelectedItem="{Binding SelectedAssignment}"
                                      AutomationProperties.Name="Student assignments">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Assignment" Binding="{Binding TitleText}"
                                                        Width="*" MinWidth="170" />
                                    <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedText}" Width="118"
                                                        ui:TableLayout.Priority="1" />
                                    <DataGridTextColumn Header="Due" Binding="{Binding DueText}" Width="118"
                                                        ui:TableLayout.Priority="3" />
                                    <DataGridTextColumn Header="Submission" Binding="{Binding StatusText}" Width="118"
                                                        ui:TableLayout.Priority="1" />
                                    <DataGridTextColumn Header="Late" Binding="{Binding LateText}" Width="66"
                                                        ui:TableLayout.Priority="2" />
                                    <DataGridTextColumn Header="Classroom" Binding="{Binding ClassroomGradeText}"
                                                        Width="104" ui:TableLayout.Priority="2" />
                                    <DataGridTextColumn Header="Math Checker" Binding="{Binding ScoreText}"
                                                        Width="108" ui:TableLayout.Priority="2" />
                                    <DataGridTextColumn Header="%" Binding="{Binding PercentageText}" Width="58"
                                                        ui:TableLayout.Priority="3" />
                                    <DataGridTextColumn Header="Correction" Binding="{Binding CorrectionState}"
                                                        Width="104" ui:TableLayout.Priority="2" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Style="{StaticResource EmptyState}" MaxWidth="380"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding AssignmentsEmpty, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="No assignments here" Style="{StaticResource EmptyTitle}" />
                                    <TextBlock Text="Sync a class in Classroom, or clear the filter, to see this student's work."
                                               Style="{StaticResource EmptyText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============================================================
                 CORRECTIONS
                 ============================================================ -->
            <Grid Visibility="{Binding IsCorrections, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" MinWidth="260" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.5*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TableCard}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                            <StackPanel>
                                <TextBlock Text="Correction history" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{Binding CorrectionCountText}" Style="{StaticResource CardSubtitle}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="1"
                                      ItemsSource="{Binding Corrections}" SelectedItem="{Binding SelectedCorrection}"
                                      AutomationProperties.Name="Student corrections">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="When" Binding="{Binding CreatedText}" Width="118" />
                                    <DataGridTextColumn Header="Assignment" Binding="{Binding TitleText}"
                                                        Width="*" MinWidth="96" />
                                    <DataGridTextColumn Header="Score" Binding="{Binding ScoreText}" Width="88" />
                                    <DataGridTextColumn Header="%" Binding="{Binding PercentageText}" Width="52"
                                                        ui:TableLayout.Priority="2" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="84"
                                                        ui:TableLayout.Priority="1" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Style="{StaticResource EmptyState}" MaxWidth="320"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding CorrectionsEmpty, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="No corrections yet" Style="{StaticResource EmptyTitle}" />
                                    <TextBlock Text="Run a correction in Classroom or New correction; the stored result appears here."
                                               Style="{StaticResource EmptyText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top"
                                    Visibility="{Binding HasCorrections, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Selected correction" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding SelectedCorrectionTitle}" Style="{StaticResource CardTitle}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            <WrapPanel Margin="0,3,0,0">
                                <TextBlock Text="{Binding SelectedCorrectionScore}" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding SelectedCorrectionStatus, StringFormat=  ·  {0}}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding SelectedCorrectionWhen, StringFormat=  ·  {0}}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                <Button Content="Open in marking desk" Style="{StaticResource GhostButton}"
                                        Height="28" Padding="10,2" Margin="0,0,6,0"
                                        Command="{Binding OpenSelectedInDeskCommand}" />
                                <Button Content="Export PDF" Style="{StaticResource GhostButton}"
                                        Height="28" Padding="10,2" Margin="0"
                                        Command="{Binding ExportCorrectionReportCommand}" />
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" Margin="0,0,0,6" />
                        </StackPanel>

                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Questions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
                                                    Padding="0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46" />
                                                        <ColumnDefinition Width="74" />
                                                        <ColumnDefinition Width="1*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding NumberText}"
                                                               FontWeight="SemiBold" FontSize="12"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding MarkText}"
                                                               FontSize="12" Foreground="{DynamicResource TextBrush}" />

                                                    <StackPanel Grid.Column="2">
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding Topic, StringFormat=Topic: {0}}"
                                                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding Status, StringFormat=  ·  {0}}"
                                                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                                       Visibility="{Binding Status, Converter={StaticResource NullToVisibility}}" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding LossReason}" FontSize="11.5"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock Text="{Binding ReviewReason}" FontSize="11"
                                                                   TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Style="{StaticResource EmptyState}" MaxWidth="340"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding QuestionsEmpty, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="No question breakdown" Style="{StaticResource EmptyTitle}" />
                                    <TextBlock Text="{Binding CorrectionDetailNote}" Style="{StaticResource EmptyText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============================================================
                 PROGRESS
                 ============================================================ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"
                          Visibility="{Binding IsProgress, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Score trend" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding TrendNote}" Style="{StaticResource CardSubtitle}"
                                       Margin="0,2,0,8" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding Trend}" MaxHeight="150">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="72" Height="118" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding ValueText}" FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Border Height="{Binding BarHeight}" Width="26" VerticalAlignment="Bottom"
                                                    Background="{DynamicResource AccentBrush}" CornerRadius="3"
                                                    Margin="0,4,0,4" />
                                            <TextBlock Text="{Binding Label}" FontSize="11"
                                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Not enough corrected work to show a trend."
                                       Style="{StaticResource EmptyText}"
                                       Visibility="{Binding HasTrend, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Performance by topic" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding TopicNote}" Style="{StaticResource CardSubtitle}"
                                       Margin="0,2,0,8" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding Topics}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="96" Height="142" Margin="0,0,8,8">
                                            <TextBlock Text="{Binding ValueText}" FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Border Height="{Binding BarHeight}" Width="34" VerticalAlignment="Bottom"
                                                    Background="{DynamicResource AccentBrush}" CornerRadius="3"
                                                    Margin="0,4,0,4" />
                                            <TextBlock Text="{Binding Topic}" FontSize="11" TextWrapping="Wrap"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Text="{Binding QuestionText}" FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="No topic data in the stored corrections yet."
                                       Style="{StaticResource EmptyText}"
                                       Visibility="{Binding HasTopics, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Insights" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Only statements the stored marks support are shown."
                                       Style="{StaticResource CardSubtitle}" Margin="0,2,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Highest-scoring topics" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding StrengthText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Lowest-scoring topics" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding FocusText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding RepeatedText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Submission behaviour" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding Profile.SubmissionSource, StringFormat=SOURCE: {0}}"
                                       Style="{StaticResource CardSubtitle}" Margin="0,2,0,8" />
                            <WrapPanel>
                                <TextBlock Text="{Binding OnTimeText, StringFormat=On time {0}}" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,18,6" />
                                <TextBlock Text="{Binding LateCountText, StringFormat=Late {0}}" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,18,6" />
                                <TextBlock Text="{Binding MissingCountText, StringFormat=Outstanding {0}}" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,18,6" />
                                <TextBlock Text="{Binding DraftText, StringFormat=Draft {0}}" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,18,6" />
                                <TextBlock Text="{Binding TurnedInText, StringFormat=Turned in {0}}" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,18,6" />
                                <TextBlock Text="{Binding ReturnedText, StringFormat=Returned {0}}" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,18,6" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================================================
                 DETAILS
                 ============================================================ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"
                          Visibility="{Binding IsDetails, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Edit details" Style="{StaticResource GhostButton}"
                                        Height="28" Padding="10,2" Margin="0"
                                        Command="{Binding BeginEditCommand}"
                                        Visibility="{Binding IsReadingDetails, Converter={StaticResource BoolToVis}}" />
                                <StackPanel>
                                    <TextBlock Text="Student information" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="Local metadata only — Google Classroom is never changed."
                                               Style="{StaticResource CardSubtitle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Google Classroom name" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding Profile.OfficialName, TargetNullValue=—}" FontSize="12.5"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,3,0,8" />

                                    <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding Profile.Email, TargetNullValue=—}" FontSize="12.5"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,3,0,8" />

                                    <TextBlock Text="Student ID" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding Profile.StudentId}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,3,0,8" />

                                    <TextBlock Text="Class / grade" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding Profile.ClassText}" FontSize="12.5"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,3,0,2" />
                                    <TextBlock Text="{Binding Profile.CourseText, StringFormat=Classroom course: {0}}"
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               Visibility="{Binding Profile.CourseText, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <StackPanel Visibility="{Binding IsReadingDetails, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Nickname" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Profile.NicknameText}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,3,0,8" />

                                        <TextBlock Text="Teacher-assigned class" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Profile.ClassName, TargetNullValue=Not set}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,3,0,8" />

                                        <TextBlock Text="Name shown in the app" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Profile.Name}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,3,0,2" />
                                        <TextBlock Text="Nickname when set, otherwise the Classroom name."
                                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsEditingDetails, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Nickname (up to 60 characters)" Style="{StaticResource FieldLabel}" />
                                        <TextBox MaxLength="60" Margin="0,3,0,8"
                                                 Text="{Binding NicknameDraft, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Student nickname" />

                                        <TextBlock Text="Class / grade (up to 40 characters)" Style="{StaticResource FieldLabel}" />
                                        <ComboBox IsEditable="True" Margin="0,3,0,8"
                                                  ItemsSource="{Binding ClassOptions}"
                                                  Text="{Binding ClassDraft, UpdateSourceTrigger=PropertyChanged}"
                                                  AutomationProperties.Name="Student class" />

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Save" Style="{StaticResource PrimaryButton}"
                                                    Height="30" Padding="14,3" Margin="0,0,8,0"
                                                    Command="{Binding SaveDetailsCommand}" />
                                            <Button Content="Cancel" Style="{StaticResource GhostButton}"
                                                    Height="30" Padding="12,3" Margin="0"
                                                    Command="{Binding CancelEditCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource ErrorBanner}" Margin="0,10,0,0"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Data sources" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Every figure on this profile names where it came from."
                                       Style="{StaticResource CardSubtitle}" Margin="0,2,0,8" />
                            <TextBlock Text="{Binding Profile.IdentitySource}" FontSize="11.5"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding Profile.SubmissionSource}" FontSize="11.5"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding Profile.ScoresSource}" FontSize="11.5"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding Profile.CorrectionSource}" FontSize="11.5"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,3" />
                            <TextBlock Text="SOURCE: Local application data (nickname, class)" FontSize="11.5"
                                       Foreground="{DynamicResource TextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Reports" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Exports use the same stored records shown above."
                                       Style="{StaticResource CardSubtitle}" Margin="0,2,0,8" />
                            <WrapPanel>
                                <Button Content="Export tracking report" Style="{StaticResource PrimaryButton}"
                                        Height="30" Padding="12,3" Margin="0,0,8,0"
                                        Command="{Binding ReportCommand}" />
                                <Button Content="Open results" Style="{StaticResource GhostButton}"
                                        Height="30" Padding="12,3" Margin="0"
                                        Command="{Binding OpenResultsCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="MathChecker.Desktop.Views.PeerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">

    <UserControl.Resources>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="StateValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
    </UserControl.Resources>

    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="Department peer networking. Nothing is sent anywhere in this phase: switching it on starts a supervised helper on this machine and reports what it observes."
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,16,0,0">
        <ui:PageFrame.Actions>
            <Button Content="Refresh" Command="{Binding RefreshCommand}"
                    ToolTip="Ask the backend again what it observes. This starts nothing." />
        </ui:PageFrame.Actions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <StackPanel>

                <!-- ============================================ 1 · the switch -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="1 · PEER NETWORKING" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="Off by default. Turning it on writes the preference to the backend, which then starts the supervisor; turning it off asks that supervisor to stop."
                                   Style="{StaticResource FieldHint}" Margin="0,8,0,14" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Enable peer networking" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding EnableCommand}" Margin="0"
                                    IsEnabled="{Binding IsIdle}"
                                    AutomationProperties.Name="Enable peer networking"
                                    ToolTip="Start the peer supervisor on this machine" />
                            <Button Content="Disable" Command="{Binding DisableCommand}" Margin="8,0,0,0"
                                    IsEnabled="{Binding IsIdle}"
                                    AutomationProperties.Name="Disable peer networking"
                                    ToolTip="Ask the peer supervisor to stop" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,16,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" MinWidth="180" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Stored preference" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding PreferenceText}"
                                       Style="{StaticResource FieldLabel}"
                                       AutomationProperties.Name="Stored peer preference" />

                            <TextBlock Grid.Row="1" Text="Observed state" Margin="0,10,0,0"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding State}" Margin="0,8,0,0"
                                       Style="{StaticResource StateValue}"
                                       AutomationProperties.Name="Observed peer state" />

                            <TextBlock Grid.Row="2" Text="What that means" Margin="0,10,0,0"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Label}" Margin="0,10,0,0"
                                       TextWrapping="Wrap" Style="{StaticResource FieldLabel}"
                                       AutomationProperties.Name="Peer state label" />
                        </Grid>

                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                   Style="{StaticResource FieldHint}" Margin="0,10,0,0"
                                   AutomationProperties.Name="Peer state detail" />
                    </StackPanel>
                </Border>

                <!-- ========================================= 2 · what it reports -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="2 · WHAT THE BACKEND REPORTS" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="Read-only. A stored preference of On does not mean the service is running: the state above is observed separately."
                                   Style="{StaticResource FieldHint}" Margin="0,8,0,10" />
                        <ItemsControl ItemsSource="{Binding Facts}"
                                      ItemTemplate="{StaticResource FactRowTemplate}" />
                    </StackPanel>
                </Border>

                <!-- ============================================== 3 · limits -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="3 · WHAT THIS PHASE DOES NOT DO" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="No peer is reachable yet: there is no socket, no discovery and no session. This page controls a local supervisor and nothing on the network."
                                   Style="{StaticResource FieldHint}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="The helper's keys are held in the Windows-protected store. If that protection is unavailable the helper refuses to start rather than writing the key unprotected."
                                   Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </ui:PageFrame>
</UserControl>

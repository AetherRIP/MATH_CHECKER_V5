<Window x:Class="MathChecker.Desktop.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in — Math Checker" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="22" TextElement.Foreground="{DynamicResource TextBrush}">
        <TextBlock Text="Sign in" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="This backend requires an account. The password is sent only to the local backend and is never stored by this application."
                   Style="{StaticResource Muted}" Margin="0,4,0,12" />
        <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="UsernameBox" Margin="0,2,0,10" />
        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PasswordBox" Margin="0,2,0,10" />
        <CheckBox x:Name="RememberBox" Content="Keep me signed in on this computer" Margin="0,0,0,10" />
        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}"
                   Margin="0,0,0,8" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Sign in" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="OnSignIn" />
        </StackPanel>
    </StackPanel>
</Window>

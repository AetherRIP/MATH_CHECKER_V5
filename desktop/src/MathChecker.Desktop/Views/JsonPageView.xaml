<UserControl x:Class="MathChecker.Desktop.Views.JsonPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}" Description="{Binding Description}"
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,18,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Copy all" Command="{Binding CopyCommand}" Margin="0" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <!-- A closed area is stated once, in plain language, instead of
                     being repeated as an HTTP error on every card. -->
                <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,12"
                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Not available on this installation" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding Notice}" FontSize="11.5" Margin="0,3,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14"
                    Visibility="{Binding Actions.Count, Converter={StaticResource NonZeroToVis}}">
                <StackPanel>
                    <TextBlock Text="WHAT YOU CAN DO HERE" Style="{StaticResource SectionLabel}" />
                    <ItemsControl ItemsSource="{Binding Actions}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Command="{Binding Command}"
                                        Height="34" Padding="12,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />

                                    <TextBlock Text="{Binding Notice}" Style="{StaticResource CardSubtitle}"
                                               Margin="0,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}" />

                                    <ItemsControl ItemsSource="{Binding Facts}" Margin="0,10,0,0"
                                                  ItemTemplate="{StaticResource FactRowTemplate}"
                                                  Visibility="{Binding HasFacts, Converter={StaticResource BoolToVis}}" />

                                    <Expander Header="Technical details" Margin="0,12,0,0"
                                              Visibility="{Binding HasRaw, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Path, StringFormat=Endpoint: /api/{0}}"
                                                       FontSize="10.5" Margin="0,4,0,6"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBox Style="{StaticResource JsonBox}" Text="{Binding Raw}"
                                                     MinHeight="120" MaxHeight="280" Margin="0" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </ui:PageFrame>
</UserControl>
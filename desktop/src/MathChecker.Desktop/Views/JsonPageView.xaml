<UserControl x:Class="MathChecker.Desktop.Views.JsonPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}" Description="{Binding Description}"
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,16,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        ToolTip="Read every area on this page from the backend again" />
                <Button Content="Copy all" Command="{Binding CopyCommand}" Margin="0"
                        ToolTip="Copy every value on this page to the clipboard" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- A closed area is stated once, in plain language, instead of
                 being repeated as an HTTP error on every card. -->
            <Border Grid.Row="0" Style="{StaticResource InfoBanner}" Margin="0,0,0,12"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Not available on this installation" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{Binding Notice}" FontSize="11.5" Margin="0,3,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <StackPanel>

                    <!-- The actions belong to the page, but they are grouped
                         and explained rather than left as a bare row of
                         buttons whose effect the reader has to guess. -->
                    <Border Style="{StaticResource Card}" Padding="14"
                            Visibility="{Binding Actions.Count, Converter={StaticResource NonZeroToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="What you can do here"
                                           Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                <TextBlock Text="Each one asks the backend; Refresh reads every area again"
                                           FontSize="11" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Actions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Command="{Binding Command}"
                                                Height="32" Padding="12,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- The areas this page reports, numbered so the reader can
                         see how many there are and tell them apart. -->
                    <DockPanel Margin="2,4,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="What this page reports"
                                   Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Sections.Count, StringFormat={}{0} areas reported by the backend}"
                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </DockPanel>

                    <!-- AlternationCount lets each card number itself: 1, 2, 3…
                         even for an area added after the page loaded (an import
                         preview appends one). -->
                    <ItemsControl ItemsSource="{Binding Sections}" AlternationCount="512">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource SectionLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,5,0"
                                                       Text="{Binding (ItemsControl.AlternationIndex),
                                                                      RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                                                      Converter={StaticResource Ordinal},
                                                                      StringFormat={}{0} ·}" />
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Notice}" Style="{StaticResource CardSubtitle}"
                                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}" />

                                        <ItemsControl ItemsSource="{Binding Facts}" Margin="0,10,0,0"
                                                      ItemTemplate="{StaticResource FactRowTemplate}"
                                                      Visibility="{Binding HasFacts, Converter={StaticResource BoolToVis}}" />

                                        <Expander Header="Technical details" Margin="0,12,0,0"
                                                  Visibility="{Binding HasRaw, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Path, StringFormat=Endpoint: /api/{0}}"
                                                           FontSize="11" Margin="0,4,0,6"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBox Style="{StaticResource JsonBox}" Text="{Binding Raw}"
                                                         MinHeight="120" MaxHeight="280" Margin="0" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </ui:PageFrame>
</UserControl>

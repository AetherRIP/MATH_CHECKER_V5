<UserControl x:Class="MathChecker.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                    <Button Content="Save settings" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Teacher and report branding" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Teacher name" Width="110" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="240" Text="{Binding TeacherName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="School" Width="60" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="240" Text="{Binding SchoolName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Report centre" Width="110" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="240" Text="{Binding CenterName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Title" Width="60" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="240" Text="{Binding TeacherTitle, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Academic year" Width="110" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="240" Text="{Binding AcademicYear, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Document label" Width="100" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="240" Text="{Binding DocumentLabel, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Workers and limits" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Workers" Width="110" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="60" Text="{Binding Concurrency, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Max retries" Width="80" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="60" Text="{Binding MaxRetries, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Keep originals (days)" Width="130" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="60" Text="{Binding KeepDays, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Hourly MB" Width="110" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="80" Text="{Binding HourlyMb, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Daily MB" Width="70" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="80" Text="{Binding DailyMb, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="0 means unlimited." Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Behaviour" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <CheckBox Content="Mock marking (no AI calls; results are marked as mock)"
                              IsChecked="{Binding MockMode}" />
                    <CheckBox Content="Debug logging" IsChecked="{Binding Debug}" />
                    <CheckBox Content="Google Classroom enabled" IsChecked="{Binding ClassroomEnabled}" />
                    <CheckBox Content="Write draft grades back to Classroom"
                              IsChecked="{Binding WriteDraftGrades}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Read-only backend facts" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,2" />
                    <TextBox Style="{StaticResource JsonBox}" Text="{Binding ReadOnlyText, Mode=OneWay}" Height="90" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

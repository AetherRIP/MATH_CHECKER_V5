<UserControl x:Class="MathChecker.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="Branding, workers and behaviour. Every value is stored by the backend, not by the desktop client."
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,18,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TEACHER AND REPORT BRANDING" Style="{StaticResource SectionLabel}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Teacher name" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" MaxWidth="280" HorizontalAlignment="Stretch"
                                     Text="{Binding TeacherName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="School" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="3" MaxWidth="280" HorizontalAlignment="Stretch"
                                     Text="{Binding SchoolName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Report centre" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" MaxWidth="280" HorizontalAlignment="Stretch"
                                     Text="{Binding CenterName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="Title" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="3" MaxWidth="280" HorizontalAlignment="Stretch"
                                     Text="{Binding TeacherTitle, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Academic year" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" MaxWidth="280" HorizontalAlignment="Stretch"
                                     Text="{Binding AcademicYear, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="Document label" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="3" MaxWidth="280" HorizontalAlignment="Stretch"
                                     Text="{Binding DocumentLabel, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="WORKERS AND LIMITS" Style="{StaticResource SectionLabel}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Workers" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                     Text="{Binding Concurrency, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="Max retries" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="3" Width="70" HorizontalAlignment="Left"
                                     Text="{Binding MaxRetries, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Keep originals (days)" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                     Text="{Binding KeepDays, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="Hourly MB" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="3" Width="80" HorizontalAlignment="Left"
                                     Text="{Binding HourlyMb, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Daily MB" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="80" Text="{Binding DailyMb, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="0 means unlimited." Style="{StaticResource CardSubtitle}"
                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                        <CheckBox Content="Mock marking (no AI calls; results are marked as mock)"
                                  IsChecked="{Binding MockMode}" />
                        <CheckBox Content="Debug logging" IsChecked="{Binding Debug}" />
                        <CheckBox Content="Google Classroom enabled" IsChecked="{Binding ClassroomEnabled}" />
                        <CheckBox Content="Write draft grades back to Classroom"
                                  IsChecked="{Binding WriteDraftGrades}" />

                        <TextBlock Text="APPEARANCE" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Light" GroupName="appearance"
                                         Style="{StaticResource SegmentToggle}"
                                         IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                         Command="{Binding LightThemeCommand}"
                                         AutomationProperties.Name="Light appearance" />
                            <RadioButton Content="Dark" GroupName="appearance"
                                         Style="{StaticResource SegmentToggle}"
                                         IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                         Command="{Binding DarkThemeCommand}"
                                         AutomationProperties.Name="Dark appearance" />
                        </StackPanel>
                        <TextBlock Text="Applies immediately and is remembered for the next launch."
                                   Style="{StaticResource CardSubtitle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="WHAT THE BACKEND REPORTS" Style="{StaticResource SectionLabel}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Read-only facts gathered by the backend at startup."
                                   Style="{StaticResource CardSubtitle}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding ReadOnlyFacts}"
                                      ItemTemplate="{StaticResource FactRowTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </ui:PageFrame>
</UserControl>
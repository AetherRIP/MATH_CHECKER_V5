<UserControl x:Class="MathChecker.Desktop.Views.AssignmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}" Description="{Binding Summary}"
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  Sync="{Binding SyncService}"
                  BodyPadding="0,18,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <!-- Both read the selected assignment's mark scheme. -->
                <Button Content="Recheck mark scheme" Command="{Binding RecheckMarkSchemeCommand}"
                        IsEnabled="{Binding HasSelection}" ToolTip="Select an assignment row first" />
                <Button Content="Open first page image" Command="{Binding OpenMarkSchemePageCommand}" Margin="0"
                        IsEnabled="{Binding HasSelection}" ToolTip="Select an assignment row first" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <Border Style="{StaticResource FilterBar}">
                <WrapPanel>
                    <TextBlock Text="Search" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="200" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search assignments" />
                    <TextBlock Text="Kind" Style="{StaticResource FieldLabel}" Margin="10,0,6,0" />
                    <ComboBox Width="120" ItemsSource="{Binding Kinds}" SelectedValuePath="Value"
                              SelectedValue="{Binding Kind}" />
                    <Border Style="{StaticResource Chip}" Padding="9,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Items.Count, StringFormat={}{0} assignments}"
                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </WrapPanel>
            </Border>

            <Border Style="{StaticResource TableCard}" Height="300">
                <Grid>
                    <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="0" ItemsSource="{Binding Items}"
                              SelectedItem="{Binding Selected}" AutomationProperties.Name="Assignments">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Assignment" Binding="{Binding DisplayTitle}" Width="*" MinWidth="160"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Class" Binding="{Binding CourseLabel}" Width="180"
                                                ElementStyle="{StaticResource CellText}"
                                                ui:TableLayout.Priority="1" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="78"
                                                ui:TableLayout.Priority="2" />
                            <DataGridTextColumn Header="Students" Binding="{Binding StudentsTotal}" Width="84"
                                                ui:TableLayout.Priority="2" />
                            <DataGridTextColumn Header="Checked" Binding="{Binding Checked}" Width="80"
                                                ui:TableLayout.Priority="2" />
                            <DataGridTextColumn Header="Review" Binding="{Binding NeedsReview}" Width="74"
                                                ui:TableLayout.Priority="3" />
                            <DataGridTextColumn Header="Average" Binding="{Binding AverageText}" Width="84"
                                                ui:TableLayout.Priority="1" />
                            <DataGridTextColumn Header="Scheme" Binding="{Binding MarkSchemeText}" Width="76"
                                                ui:TableLayout.Priority="3" />
                            <DataGridTextColumn Header="Due" Binding="{Binding DueDate}" Width="124"
                                                ui:TableLayout.Priority="3" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Style="{StaticResource EmptyState}" MaxWidth="340"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVis}}">
                        <StackPanel>
                            <TextBlock Text="No assignments match" Style="{StaticResource EmptyTitle}" />
                            <TextBlock Text="Change the search or kind, or create a local assignment below."
                                       Style="{StaticResource EmptyText}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                <WrapPanel>
                    <TextBlock Text="New local assignment" Style="{StaticResource SectionLabel}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="220" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Max points" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="70" Text="{Binding NewPoints, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Due" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="130" Text="{Binding NewDueDate, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Create" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CreateLocalCommand}" Height="38" Padding="16,6" Margin="0" />
                </WrapPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="MARK SCHEME" Style="{StaticResource SectionLabel}" />
                    <!-- An instruction before a selection is a hint, not data. -->
                    <TextBlock Text="Select an assignment to read its mark scheme."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />

                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding MarkSchemeNote}" Style="{StaticResource CardSubtitle}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding MarkSchemeFacts}" Margin="0,10,0,0"
                                      ItemTemplate="{StaticResource FactRowTemplate}"
                                      Visibility="{Binding HasMarkSchemeFacts, Converter={StaticResource BoolToVis}}" />

                        <Border Style="{StaticResource Divider}" Margin="0,12,0,10"
                                Visibility="{Binding HasMarkSchemeContent, Converter={StaticResource BoolToVis}}" />
                        <TextBox Text="{Binding MarkSchemeContent, Mode=OneWay}" IsReadOnly="True"
                                 TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                 MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding HasMarkSchemeContent, Converter={StaticResource BoolToVis}}" />

                        <Expander Header="Technical details" Margin="0,12,0,0"
                                  Visibility="{Binding HasMarkSchemeRaw, Converter={StaticResource BoolToVis}}">
                            <TextBox Style="{StaticResource JsonBox}" Margin="0,4,0,0"
                                     Text="{Binding MarkSchemeRaw, Mode=OneWay}"
                                     MinHeight="120" MaxHeight="260" />
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </ui:PageFrame>
</UserControl>
<UserControl x:Class="MathChecker.Desktop.Views.AssignmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageTitle}" />

        <DockPanel Grid.Row="1" Margin="0,4,0,4">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="Search" Style="{StaticResource FieldLabel}" />
                <TextBox Width="200" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Kind" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="120" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Recheck mark scheme" Command="{Binding RecheckMarkSchemeCommand}" />
                <Button Content="Open first page image" Command="{Binding OpenMarkSchemePageCommand}" />
            </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Assignment" Binding="{Binding DisplayTitle}" Width="*" />
                <DataGridTextColumn Header="Class" Binding="{Binding CourseLabel}" Width="200" />
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80" />
                <DataGridTextColumn Header="Students" Binding="{Binding StudentsTotal}" Width="80" />
                <DataGridTextColumn Header="Checked" Binding="{Binding Checked}" Width="80" />
                <DataGridTextColumn Header="Review" Binding="{Binding NeedsReview}" Width="70" />
                <DataGridTextColumn Header="Average" Binding="{Binding AverageText}" Width="80" />
                <DataGridTextColumn Header="Scheme" Binding="{Binding MarkSchemeText}" Width="70" />
                <DataGridTextColumn Header="Due" Binding="{Binding DueDate}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="New local assignment" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="Title" Style="{StaticResource FieldLabel}" Margin="10,0,4,0" />
                <TextBox Width="240" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Max points" Style="{StaticResource FieldLabel}" />
                <TextBox Width="70" Text="{Binding NewPoints, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Due" Style="{StaticResource FieldLabel}" />
                <TextBox Width="130" Text="{Binding NewDueDate, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Create" Command="{Binding CreateLocalCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Mark scheme" Style="{StaticResource SectionTitle}"
                           Margin="0,0,0,2" />
                <TextBox Style="{StaticResource JsonBox}" Text="{Binding MarkSchemeText, Mode=OneWay}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

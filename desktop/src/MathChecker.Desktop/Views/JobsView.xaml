<UserControl x:Class="MathChecker.Desktop.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Muted}">
                    <Run Text="Updates: " />
                    <Run Text="{Binding LiveMode, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                        HorizontalAlignment="Right">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Cancel job" Command="{Binding CancelJobCommand}" />
                <Button Content="Retry job" Command="{Binding RetryJobCommand}" />
                <Button Content="Open result" Command="{Binding OpenResultCommand}" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="160" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" />
            </StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,8,0,0"
                    Visibility="{Binding ShowWorkers, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Worker pool" Style="{StaticResource FieldLabel}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding WorkersText}" VerticalAlignment="Center" Margin="8,0,16,0" />
                    <TextBlock Text="Size" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="60" Text="{Binding WorkerCount, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Resize" Command="{Binding ResizeWorkersCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="160" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                <DataGridTextColumn Header="Stage" Binding="{Binding StageText}" Width="*" />
                <DataGridTextColumn Header="Progress" Binding="{Binding Progress, StringFormat={}{0:P0}}" Width="80" />
                <DataGridTextColumn Header="Attempt" Binding="{Binding Attempts}" Width="70" />
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" Width="140" />
                <DataGridTextColumn Header="Result" Binding="{Binding ResultId}" Width="180" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0">
            <TextBox Style="{StaticResource JsonBox}" Text="{Binding SelectedDetail, Mode=OneWay}" />
        </Border>
    </Grid>
</UserControl>

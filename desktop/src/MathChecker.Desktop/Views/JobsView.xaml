<UserControl x:Class="MathChecker.Desktop.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="Every correction this desk has queued, and what each one is doing."
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,16,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource FilterBar}" Margin="0,0,0,12">
                <WrapPanel>
                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="160" ItemsSource="{Binding StatusFilters}"
                              SelectedValuePath="Value" SelectedValue="{Binding StatusFilter}" />
                    <Border Style="{StaticResource Chip}" Padding="9,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Items.Count, StringFormat={}{0} jobs}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Padding="9,3" Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowWorkers, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding WorkersText}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                    <TextBlock Text="Size" Style="{StaticResource FieldLabel}" Margin="14,0,6,0"
                               Visibility="{Binding ShowWorkers, Converter={StaticResource BoolToVis}}" />
                    <TextBox Width="56" Text="{Binding WorkerCount, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ShowWorkers, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Resize" Command="{Binding ResizeWorkersCommand}" Height="34" Padding="12,4"
                            Visibility="{Binding ShowWorkers, Converter={StaticResource BoolToVis}}" />
                </WrapPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource TableCard}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                        <DockPanel>
                            <TextBlock Text="{Binding Title, StringFormat=All {0}}"
                                       Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LiveMode}"
                                       Style="{StaticResource CardSubtitle}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>

                    <Grid>
                        <!-- One stage column, not a status beside a stage that repeats
                             it; PhaseText names what the pipeline is actually doing. -->
                        <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="1"
                                  ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding Selected}" AutomationProperties.Name="Jobs">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="150"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Stage" Binding="{Binding PhaseText}" Width="*" MinWidth="160"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Progress"
                                                    Binding="{Binding ProgressText}" Width="88"
                                                    HeaderStyle="{StaticResource NumberHeader}"
                                                    ElementStyle="{StaticResource CellNumber}"
                                                    ui:TableLayout.Priority="2" />
                                <DataGridTextColumn Header="Attempt" Binding="{Binding Attempts}" Width="76"
                                                    HeaderStyle="{StaticResource NumberHeader}"
                                                    ElementStyle="{StaticResource CellNumber}"
                                                    ui:TableLayout.Priority="2" />
                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" Width="150"
                                                    ElementStyle="{StaticResource CellText}"
                                                    ui:TableLayout.Priority="1" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Style="{StaticResource EmptyState}" MaxWidth="360"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="No jobs in this filter" Style="{StaticResource EmptyTitle}" />
                                <TextBlock Text="New corrections appear here as soon as they are queued."
                                           Style="{StaticResource EmptyText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                <DockPanel>
                    <!-- The actions that only make sense with a row picked live on that
                         row's own card, not in the page header where they outnumbered
                         the page's one real action. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                Margin="16,0,0,0"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Button Content="Cancel job" Command="{Binding CancelJobCommand}"
                                Height="30" Padding="12,4"
                                ToolTip="Stop this correction" />
                        <Button Content="Retry job" Command="{Binding RetryJobCommand}"
                                Height="30" Padding="12,4"
                                ToolTip="Queue this correction again" />
                        <Button Content="Open result" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenResultCommand}" Height="30" Padding="14,4" Margin="0"
                                ToolTip="Read the marked paper" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Selected job" Style="{StaticResource SectionLabel}" />
                        <!-- An instruction is not data: before a row is picked the
                             hint reads as plain muted text, not a monospace field. -->
                        <TextBlock Text="Select a job to see its stage, attempts and error."
                                   Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding SelectedFacts}" Margin="0,4,0,0"
                                      ItemTemplate="{StaticResource FactRowTemplate}"
                                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </ui:PageFrame>
</UserControl>

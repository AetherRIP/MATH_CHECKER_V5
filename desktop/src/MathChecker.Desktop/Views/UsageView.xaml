<UserControl x:Class="MathChecker.Desktop.Views.UsageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="Provider traffic measured by the backend, not estimated by the desk."
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,18,0,0">
        <ui:PageFrame.Actions>
            <Button Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
        </ui:PageFrame.Actions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Border Style="{StaticResource StatTile}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="THIS HOUR" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding HourText}" Style="{StaticResource DisplayFigure}"
                                   FontSize="32" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TODAY" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding DayText}" Style="{StaticResource DisplayFigure}"
                                   FontSize="32" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="LIMITS" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding HourlyLimitText}" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DailyLimitText}" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding RemainingText}" FontSize="12.5" />
                    <TextBlock Text="{Binding LimitWarning}" Style="{StaticResource WarningText}"
                               Margin="0,6,0,0"
                               Visibility="{Binding LimitWarning, Converter={StaticResource NullToVisibility}}" />
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,10,0,10" />
                    <TextBlock Text="AI PROVIDER TRAFFIC" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding ApiText}" FontSize="12" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="AI REQUESTS PER CORRECTION" Style="{StaticResource SectionLabel}"
                               Margin="0,12,0,0" />
                    <TextBlock Text="{Binding AiText}" FontSize="12" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="AI requests per correction" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TableCard}" Height="320">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                        <TextBlock Text="Hourly history" Style="{StaticResource RowTitle}" />
                    </Border>
                    <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="3" ItemsSource="{Binding History}"
                              AutomationProperties.Name="Hourly usage">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hour" Binding="{Binding BucketText}" Width="160" />
                            <DataGridTextColumn Header="Up (bytes)" Binding="{Binding Up}" Width="120"
                                                ui:TableLayout.Priority="1" />
                            <DataGridTextColumn Header="Down (bytes)" Binding="{Binding Down}" Width="130"
                                                ui:TableLayout.Priority="1" />
                            <DataGridTextColumn Header="Total (MB)"
                                                Binding="{Binding Megabytes, StringFormat={}{0:0.###}}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </ui:PageFrame>
</UserControl>
<Window x:Class="MathChecker.Desktop.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="First run — Math Checker" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24" TextElement.Foreground="{StaticResource TextBrush}">
        <TextBlock Text="Finish setting up Math Checker" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="These details are stored by the backend and used on reports. You can change them later in Settings."
                   Style="{StaticResource Muted}" Margin="0,4,0,14" />

        <TextBlock Text="Teacher name" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="TeacherBox" Margin="0,2,0,10" />

        <TextBlock Text="School / centre" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="SchoolBox" Margin="0,2,0,12" />

        <TextBlock x:Name="ChecksText" Style="{StaticResource Muted}" Margin="0,0,0,12" />

        <CheckBox x:Name="KeysBox" Content="Open AI &amp; keys after saving (a Gemini key is required before any correction)"
                  Margin="0,0,0,12" IsChecked="True" />

        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}"
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Skip" IsCancel="True" Click="OnSkip" />
            <Button Content="Save and continue" Style="{StaticResource PrimaryButton}"
                    Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="MathChecker.Desktop.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="First run — Math Checker" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}">
    <!-- Same rule as the sign-in dialog: the surface comes from the theme, so
         the text colour can never land on a plain white background. -->
    <StackPanel Margin="24" TextElement.Foreground="{DynamicResource TextBrush}">
        <TextBlock Text="Finish setting up Math Checker" Style="{StaticResource PageTitle}" />
        <TextBlock Text="These details are stored by the backend and used on reports. You can change them later in Settings."
                   Style="{StaticResource Muted}" Margin="0,6,0,18" />

        <TextBlock Text="Teacher name" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="TeacherBox" Margin="0,3,0,12" AutomationProperties.Name="Teacher name" />

        <TextBlock Text="School / centre" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="SchoolBox" Margin="0,3,0,14" AutomationProperties.Name="School or centre" />

        <TextBlock x:Name="ChecksText" Style="{StaticResource Muted}" Margin="0,0,0,14" />

        <CheckBox x:Name="KeysBox" Content="Open AI &amp; keys after saving (a Gemini key is required before any correction)"
                  Margin="0,0,0,14" IsChecked="True" />

        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Skip" IsCancel="True" Click="OnSkip" />
            <Button Content="Save and continue" Style="{StaticResource PrimaryButton}"
                    Margin="0" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>

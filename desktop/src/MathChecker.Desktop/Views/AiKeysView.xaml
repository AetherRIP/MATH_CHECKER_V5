<UserControl x:Class="MathChecker.Desktop.Views.AiKeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Test selected" Command="{Binding TestSelectedCommand}" />
                <Button Content="Test all" Command="{Binding TestAllCommand}" />
                <Button Content="Disable" Command="{Binding DisableCommand}" />
                <Button Content="Re-enable" Command="{Binding EnableCommand}" />
                <Button Content="Remove" Command="{Binding RemoveCommand}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="Add keys" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                <TextBlock Text="One key per line. Keys are sent to the backend, tested against the real API and stored in its secret store — the desktop app never keeps a copy."
                           Style="{StaticResource Muted}" Margin="0,0,0,6" />
                <TextBox Height="60" AcceptsReturn="True" Text="{Binding NewKeys, UpdateSourceTrigger=PropertyChanged}"
                         VerticalScrollBarVisibility="Auto" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Submit keys" Command="{Binding AddKeysCommand}" />
                    <ProgressBar Width="120" Height="8" IsIndeterminate="True" Margin="6,0,12,0"
                                 Visibility="{Binding TestingAll, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="Worker pool" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding WorkersText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="50" Text="{Binding WorkerCount, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Resize" Command="{Binding ResizeWorkersCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Keys}" SelectedItem="{Binding Selected}" Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="140" />
                <DataGridTextColumn Header="Fingerprint" Binding="{Binding Fingerprint}" Width="180" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="120" />
                <DataGridTextColumn Header="Cooldown" Binding="{Binding CooldownText}" Width="90" />
                <DataGridTextColumn Header="Error" Binding="{Binding ErrorKind}" Width="140" />
                <DataGridTextColumn Header="Message" Binding="{Binding ErrorMessage}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="Backend response" Style="{StaticResource SectionTitle}" />

        <TextBox Grid.Row="4" Style="{StaticResource JsonBox}" Text="{Binding ResultText, Mode=OneWay}" />
    </Grid>
</UserControl>

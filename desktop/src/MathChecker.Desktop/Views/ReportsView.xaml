<UserControl x:Class="MathChecker.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="Build a class or assignment report from stored corrections, then export the exact payload."
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,18,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Build report" Style="{StaticResource PrimaryButton}"
                        Command="{Binding BuildCommand}" />
                <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" />
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="0" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="REPORT SCOPE" Style="{StaticResource SectionLabel}" />
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="Report" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="170" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" />
                        <TextBlock Text="Class" Style="{StaticResource FieldLabel}" Margin="10,0,6,0" />
                        <ComboBox Width="240" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Assignment" Style="{StaticResource FieldLabel}" Margin="10,0,6,0" />
                        <ComboBox Width="280" ItemsSource="{Binding Assignments}"
                                  SelectedItem="{Binding SelectedAssignment}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayTitle}" TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </WrapPanel>
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource CardSubtitle}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource TableCard}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                        <DockPanel>
                            <TextBlock Text="Report rows" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="9,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Rows.Count, StringFormat={}{0} rows}"
                                           FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="4" ItemsSource="{Binding Rows}"
                                  AutomationProperties.Name="Report rows">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Student" Binding="{Binding Name}" Width="190" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="170"
                                                    ui:TableLayout.Priority="1" />
                                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="110" />
                                <DataGridTextColumn Header="Percentage" Binding="{Binding Percentage}" Width="104"
                                                    ui:TableLayout.Priority="2" />
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Style="{StaticResource EmptyState}" MaxWidth="360"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVis}}">
                            <StackPanel>
                                <TextBlock Text="No report built yet" Style="{StaticResource EmptyTitle}" />
                                <TextBlock Text="Choose a scope and build the report to see its rows here."
                                           Style="{StaticResource EmptyText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <Expander Grid.Row="2" Header="Raw report payload" IsExpanded="False" Margin="0,10,0,0">
                <TextBox Style="{StaticResource JsonBox}" Text="{Binding RawText, Mode=OneWay}" Height="180" />
            </Expander>
        </Grid>
    </ui:PageFrame>
</UserControl>
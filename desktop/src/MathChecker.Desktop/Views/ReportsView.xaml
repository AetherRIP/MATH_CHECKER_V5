<UserControl x:Class="MathChecker.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageTitle}" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Report" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="170" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" />
                    <TextBlock Text="Class" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="240" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Assignment" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="280" ItemsSource="{Binding Assignments}"
                              SelectedItem="{Binding SelectedAssignment}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayTitle}" TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Build report" Command="{Binding BuildCommand}" />
                    <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" />
                    <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" />
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Student" Binding="{Binding Name}" Width="200" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180" />
                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="120" />
                <DataGridTextColumn Header="Percentage" Binding="{Binding Percentage}" Width="110" />
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="The backend's exact payload is kept below for verification."
                   Style="{StaticResource Muted}" Margin="0,8,0,4" />

        <Expander Grid.Row="4" Header="Raw report payload" IsExpanded="False">
            <TextBox Style="{StaticResource JsonBox}" Text="{Binding RawText, Mode=OneWay}" Height="220" />
        </Expander>
    </Grid>
</UserControl>

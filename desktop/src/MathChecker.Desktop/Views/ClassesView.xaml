<UserControl x:Class="MathChecker.Desktop.Views.ClassesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Open students" Command="{Binding OpenStudentsCommand}" />
                <Button Content="Open assignments" Command="{Binding OpenAssignmentsCommand}" />
                <Button Content="Export class report" Command="{Binding ExportClassReportCommand}" />
            </StackPanel>
        </DockPanel>

        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Height="460">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Class" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="Students" Binding="{Binding Students}" Width="80" />
                <DataGridTextColumn Header="Assignments" Binding="{Binding Assignments}" Width="100" />
                <DataGridTextColumn Header="Submitted" Binding="{Binding Submitted}" Width="90" />
                <DataGridTextColumn Header="Missing" Binding="{Binding Missing}" Width="80" />
                <DataGridTextColumn Header="Checked" Binding="{Binding Checked}" Width="80" />
                <DataGridTextColumn Header="Review" Binding="{Binding Review}" Width="70" />
                <DataGridTextColumn Header="Average" Binding="{Binding AverageText}" Width="80" />
                <DataGridTextColumn Header="Last sync" Binding="{Binding LastSyncText}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>

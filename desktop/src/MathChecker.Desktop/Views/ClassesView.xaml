<UserControl x:Class="MathChecker.Desktop.Views.ClassesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}" Description="{Binding Summary}"
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  Sync="{Binding SyncService}"
                  BodyPadding="0,18,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Open students" Command="{Binding OpenStudentsCommand}" />
                <Button Content="Open assignments" Command="{Binding OpenAssignmentsCommand}" />
                <Button Content="Export class report" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ExportClassReportCommand}" Margin="0" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <Border Style="{StaticResource TableCard}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="9,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Items.Count, StringFormat={}{0} classes}"
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <TextBlock Text="Classes" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Grid>
                    <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="0" ItemsSource="{Binding Items}"
                              SelectedItem="{Binding Selected}" AutomationProperties.Name="Classes">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Class" Binding="{Binding Title}" Width="*" MinWidth="160" />
                            <DataGridTextColumn Header="Students" Binding="{Binding Students}" Width="84" />
                            <DataGridTextColumn Header="Assignments" Binding="{Binding Assignments}" Width="100"
                                                ui:TableLayout.Priority="1" />
                            <DataGridTextColumn Header="Submitted" Binding="{Binding Submitted}" Width="92"
                                                ui:TableLayout.Priority="2" />
                            <DataGridTextColumn Header="Missing" Binding="{Binding Missing}" Width="80"
                                                ui:TableLayout.Priority="2" />
                            <DataGridTextColumn Header="Checked" Binding="{Binding Checked}" Width="82"
                                                ui:TableLayout.Priority="2" />
                            <DataGridTextColumn Header="Review" Binding="{Binding Review}" Width="74"
                                                ui:TableLayout.Priority="3" />
                            <DataGridTextColumn Header="Average" Binding="{Binding AverageText}" Width="86"
                                                ui:TableLayout.Priority="1" />
                            <DataGridTextColumn Header="Last sync" Binding="{Binding LastSyncText}" Width="132"
                                                ui:TableLayout.Priority="3" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Style="{StaticResource EmptyState}" MaxWidth="340"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVis}}">
                        <StackPanel>
                            <TextBlock Text="No classes yet" Style="{StaticResource EmptyTitle}" />
                            <TextBlock Text="Connect Google Classroom or import a package to bring classes in."
                                       Style="{StaticResource EmptyText}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </ui:PageFrame>
</UserControl>
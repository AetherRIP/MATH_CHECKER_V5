<UserControl x:Class="MathChecker.Desktop.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="Local database only — no Google request is made."
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,18,0,0">
        <ui:PageFrame.Actions>
            <Button Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
        </ui:PageFrame.Actions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource FilterBar}">
                <WrapPanel>
                    <TextBox Width="360" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnQueryKeyDown" AutomationProperties.Name="Search the database" />
                    <Button Content="Search" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCommand}" Height="38" Padding="18,7" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource CardSubtitle}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </WrapPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource TableCard}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                        <TextBlock Text="Search results" Style="{StaticResource RowTitle}" />
                    </Border>
                    <Grid>
                        <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="2" ItemsSource="{Binding Hits}"
                                  MouseDoubleClick="OnRowDoubleClick" AutomationProperties.Name="Search results">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding Group}" Width="120" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Title}" Width="240" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Subtitle}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Style="{StaticResource EmptyState}" MaxWidth="360"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Hits.Count, Converter={StaticResource ZeroToVis}}">
                            <StackPanel>
                                <TextBlock Text="Nothing found" Style="{StaticResource EmptyTitle}" />
                                <TextBlock Text="Search students, classes, assignments or corrections by name."
                                           Style="{StaticResource EmptyText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </ui:PageFrame>
</UserControl>
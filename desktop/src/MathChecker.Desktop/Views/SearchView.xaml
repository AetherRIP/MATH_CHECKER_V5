<UserControl x:Class="MathChecker.Desktop.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Local database only — no Google request is made."
                   Style="{StaticResource Muted}" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal">
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Width="360"
                     KeyDown="OnQueryKeyDown" />
            <Button Content="Search" Command="{Binding SearchCommand}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       Margin="10,0,0,0" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Hits}" Height="420" MouseDoubleClick="OnRowDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding Group}" Width="120" />
                <DataGridTextColumn Header="Name" Binding="{Binding Title}" Width="240" />
                <DataGridTextColumn Header="Detail" Binding="{Binding Subtitle}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>

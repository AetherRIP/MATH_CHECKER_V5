<UserControl x:Class="MathChecker.Desktop.Views.PromptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="Overrides are stored by the backend and only affect future corrections."
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,18,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Save overrides" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                <Button Content="Restore built-in" Command="{Binding ClearCommand}" Margin="0" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Expander Grid.Row="0" Header="Prompt metadata" IsExpanded="False" Margin="0,0,0,8">
                <TextBox Style="{StaticResource JsonBox}" Text="{Binding Info, Mode=OneWay}" Height="110" Margin="0" />
            </Expander>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="SYSTEM PROMPT OVERRIDE" Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="Applies to every correction"
                                   Style="{StaticResource CardSubtitle}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}"
                             FontSize="12" Margin="0" />
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="USER PROMPT OVERRIDE" Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="Wraps each uploaded paper"
                                   Style="{StaticResource CardSubtitle}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBox Text="{Binding UserPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}"
                             FontSize="12" Margin="0" />
                </DockPanel>
            </Border>
        </Grid>
    </ui:PageFrame>
</UserControl>
<UserControl x:Class="MathChecker.Desktop.Views.PromptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="Overrides are stored by the backend and only affect future corrections."
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,18,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Save overrides" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}" IsEnabled="{Binding IsAvailable}" />
                <Button Content="Restore built-in" Command="{Binding ClearCommand}" Margin="0"
                        IsEnabled="{Binding IsAvailable}" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,10"
                        Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Read-only on this account" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding UnavailableText}" FontSize="11.5" Margin="0,3,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"
                        Visibility="{Binding Info, Converter={StaticResource NullToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="About these overrides" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding Info}" FontSize="12.5" Margin="0,7,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" LineHeight="19" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="System prompt override" Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="Applies to every correction"
                                   Style="{StaticResource CardSubtitle}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             IsReadOnly="{Binding IsUnavailable}"
                             VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}"
                             FontSize="12" Margin="0" />
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="User prompt override" Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="Wraps each uploaded paper"
                                   Style="{StaticResource CardSubtitle}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBox Text="{Binding UserPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             IsReadOnly="{Binding IsUnavailable}"
                             VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}"
                             FontSize="12" Margin="0" />
                </DockPanel>
            </Border>
        </Grid>
    </ui:PageFrame>
</UserControl>
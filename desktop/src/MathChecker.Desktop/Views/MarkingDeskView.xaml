<UserControl x:Class="MathChecker.Desktop.Views.MarkingDeskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MathChecker.Desktop.Controls"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI"
             Focusable="True" IsTabStop="False" Background="Transparent">
    <UserControl.Resources>
        <!-- One subquestion row: its own identifier, its own mark, and the
             scheme evidence that belongs to that part. An UNMARKED part says
             so instead of showing a 0 the marker never awarded. -->
        <DataTemplate x:Key="SubquestionRow">
            <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="10"
                    Background="{DynamicResource CanvasBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                    AutomationProperties.Name="{Binding LabelText}">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
                                    <Setter Property="Padding" Value="8,2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="ok">
                                            <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="warn">
                                            <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="err">
                                            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding VerdictText}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding LabelText}" FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MarkText}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding HasAnswers, Converter={StaticResource BoolToVis}}">
                        <Run Text="Scheme answer: " FontWeight="SemiBold" />
                        <Run Text="{Binding AnswersText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding HasMarkCodes, Converter={StaticResource BoolToVis}}">
                        <Run Text="Marking points: " FontWeight="SemiBold" />
                        <Run Text="{Binding MarkCodesText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <CollectionViewSource x:Key="GroupedQuestions" Source="{Binding Questions}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Topic" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="RailItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="{TemplateBinding Background}"
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MarkButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStaged}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProvenanceChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProvenanceTone}" Value="lime">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentInkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProvenanceTone}" Value="lime-outline">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProvenanceTone}" Value="amber">
                    <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProvenanceTone}" Value="mint">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuestionChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveQuestion.StateTone}" Value="amber">
                    <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActiveQuestion.StateTone}" Value="lime">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActiveQuestion.StateTone}" Value="mint">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeskSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ShowsPreview" Value="False" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <!-- The desk used to be the only page rendered outside the shared frame, so
         it had no title, no eyebrow and no error strip. It now lives inside the
         same PageFrame as every other page and keeps its own paper band as the
         first row of the body. -->
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="One paper at a time: the questions, the script and the marks, side by side."
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,16,0,0">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: whose paper, how it scores, how it came to be. -->
        <Border Grid.Row="0" Padding="0,0,0,14" BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding HasPaper, Converter={StaticResource BoolToVis}}">
            <ui:HeaderPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StudentName}" FontSize="20" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding PaperLine}" Style="{StaticResource CardSubtitle}"
                               Margin="0,3,0,0" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Style="{StaticResource ProvenanceChip}" Margin="0,0,14,0"
                            AutomationProperties.Name="{Binding ProvenanceLabel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ProvenanceGlyph}" FontWeight="Bold"
                                       FontSize="12" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding ProvenanceLabel}" FontSize="11.5"
                                       FontWeight="Medium" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- The score, read like a mark sheet's total box: the figure
                         with its percentage beside it, the band underneath. -->
                    <StackPanel Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ScoreText}" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="22" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PercentageText}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding GradeText}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>

                    <!-- Compact layout only: the question rail collapses, so the
                         desk needs a way to switch between paper and questions. -->
                    <Button x:Name="QuestionsToggle" Content="Questions" Visibility="Collapsed"
                            Style="{StaticResource GhostButton}" Height="34" Padding="12,6"
                            Click="OnToggleQuestions"
                            AutomationProperties.Name="Show the question list" />

                    <Button Content="Results" Style="{StaticResource GhostButton}"
                            Command="{Binding OpenResultsCommand}" Height="34" Padding="12,6" />

                    <!-- Utilities belong behind one control, not in a row of
                         buttons that outshouts the paper. -->
                    <Button Content="More" Style="{StaticResource GhostButton}"
                            Height="34" Padding="12,6" Margin="0"
                            ui:ClickMenu.OpenOnClick="True"
                            ToolTip="Export, re-mark or reload this paper"
                            AutomationProperties.Name="More actions for this paper">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Export as PDF" Command="{Binding ExportPdfCommand}" />
                                <MenuItem Header="Re-mark with AI" Command="{Binding RemarkCommand}" />
                                <MenuItem Header="Reload this paper" Command="{Binding RefreshCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </WrapPanel>
            </ui:HeaderPanel>
        </Border>

        <!-- No paper open: an invitation, not an empty shell. -->
        <Border Grid.Row="1" Style="{StaticResource EmptyState}" Margin="0,16,0,0"
                VerticalAlignment="Center" MaxWidth="620"
                Visibility="{Binding HasNoPaper, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="No paper open" Style="{StaticResource EmptyTitle}" />
                <TextBlock Style="{StaticResource EmptyText}" MaxWidth="440"
                           Text="Open a correction from Results, then the student's paper appears here: the questions, the script and the marks side by side." />
                <Button Content="Go to Results" Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenResultsCommand}" HorizontalAlignment="Center"
                        Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <!-- The desk: questions, paper, decision. -->
        <Grid Grid.Row="1" Margin="0,14,0,0"
              Visibility="{Binding HasPaper, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="QuestionColumn" Width="220" MinWidth="176" />
                <ColumnDefinition x:Name="QuestionSplitColumn" Width="12" />
                <ColumnDefinition x:Name="PaperColumn" Width="*" MinWidth="330" />
                <ColumnDefinition x:Name="PaperSplitColumn" Width="12" />
                <ColumnDefinition x:Name="MarkingColumn" Width="360" MinWidth="320" MaxWidth="480" />
            </Grid.ColumnDefinitions>

            <Border x:Name="QuestionPane" Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="0"
                    CornerRadius="20">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,14,14,10">
                        <DockPanel>
                            <TextBlock Text="1 · Questions" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Questions.Count, StringFormat={}{0}}"
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>
                    <ListBox x:Name="QuestionRail" ItemsSource="{Binding Source={StaticResource GroupedQuestions}}"
                             SelectedItem="{Binding ActiveQuestion, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource RailItem}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.IsVirtualizingWhenGrouping="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Questions">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                   Typography.Capitals="AllSmallCaps"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="16,12,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="3,0,0,0" Padding="8,8,8,8"
                                        AutomationProperties.Name="{Binding AutomationName}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAttention}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding RailGlyph}" Width="18" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Number}" FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StateLabel}" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding MarkText}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="QuestionSplitter" Grid.Column="1" Style="{StaticResource DeskSplitter}" />

            <Border x:Name="PaperPane" Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0"
                    CornerRadius="20" Background="{DynamicResource SurfaceBrush}">
                <DockPanel>
                    <!-- The desk reads left to right: pick a question, check the
                         paper, set the mark. The three pane labels say which
                         pane is which, which nothing on the page said before. -->
                    <TextBlock DockPanel.Dock="Top" Text="2 · The paper"
                               Style="{StaticResource SectionLabel}" Margin="16,12,16,0" />
                    <controls:PaperPaneView x:Name="PaperView" DataContext="{Binding Paper}"
                                            Margin="16,8,16,12" />
                </DockPanel>
            </Border>

            <GridSplitter x:Name="PaperSplitter" Grid.Column="3" Style="{StaticResource DeskSplitter}" />

            <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0" Padding="0"
                    CornerRadius="20" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="18,14,16,12" BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="0,0,0,1" Background="{DynamicResource SurfaceRaisedBrush}"
                            Visibility="{Binding HasActiveQuestion, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="3 · Mark this question" Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,6" />
                            <DockPanel>
                                <TextBlock Text="{Binding ActiveQuestion.Number, StringFormat=Question {0}}"
                                           FontFamily="{StaticResource DisplayFont}" FontSize="21"
                                           FontWeight="Medium" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveQuestion.MarkText}"
                                           FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </DockPanel>
                            <DockPanel Margin="0,3,0,0">
                                <TextBlock Text="{Binding ActiveQuestion.Topic}" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding QuestionPosition}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <Border Style="{StaticResource QuestionChip}" Margin="0,9,0,0">
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextBrush}">
                                    <Run Text="{Binding ActiveQuestion.StateGlyph, Mode=OneWay}"
                                         FontWeight="Bold" />
                                    <Run Text=" " />
                                    <Run Text="{Binding ActiveQuestion.StateLabel, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding ActiveQuestion.AttentionText}"
                                       FontSize="11" Margin="0,7,0,0"
                                       Foreground="{DynamicResource WarningTextBrush}"
                                       Visibility="{Binding ActiveQuestion.AttentionText, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="MarkPanelFocus" Grid.Row="1" Focusable="True"
                            KeyboardNavigation.IsTabStop="True"
                            FocusVisualStyle="{x:Null}" Background="Transparent">
                        <ScrollViewer x:Name="MarkPanelScroll" Focusable="False" IsTabStop="False"
                                      VerticalScrollBarVisibility="Auto" Padding="18,14,14,16">
                            <StackPanel>
                                <TextBlock Text="Select a question on the left to review its mark."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveQuestion}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="This correction stored totals only. The PDF report has the feedback."
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding HasNoQuestionData, Converter={StaticResource BoolToVis}}" />

                                <StackPanel Visibility="{Binding HasActiveQuestion, Converter={StaticResource BoolToVis}}">
                                    <!-- Each subquestion keeps its own mark, so a
                                         question that lost marks in one part can
                                         never read as uniformly correct. -->
                                    <StackPanel Margin="0,2,0,12"
                                                Visibility="{Binding ActiveQuestion.HasSubquestions, Converter={StaticResource BoolToVis}}">
                                        <DockPanel Margin="0,0,0,7">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding ActiveQuestion.SubquestionSummary}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="Subquestions" Style="{StaticResource SectionTitle}"
                                                       Margin="0" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding ActiveQuestion.Subquestions}"
                                                      ItemTemplate="{StaticResource SubquestionRow}"
                                                      AutomationProperties.Name="Subquestions" />
                                    </StackPanel>

                                    <TextBlock Text="How the mark was built" Style="{StaticResource SectionTitle}"
                                               Margin="0,2,0,3" />
                                    <TextBlock Text="Every marking point the scheme defines, and whether this paper earned it."
                                               FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <ItemsControl ItemsSource="{Binding ActiveQuestion.Source.MarkBreakdown}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3,0,3">
                                                    <TextBlock DockPanel.Dock="Left" Width="18" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="✗" />
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Awarded}" Value="True">
                                                                        <Setter Property="Text" Value="✓" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Code}"
                                                               Width="44" FontWeight="SemiBold" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Reason}" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No mark breakdown was stored for this question."
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveQuestion.HasBreakdown}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="Why marks were lost" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding ActiveQuestion.LossReasonText}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />

                                    <TextBlock Text="What the student wrote" Style="{StaticResource SectionTitle}" />
                                    <Border Background="{DynamicResource CanvasBrush}"
                                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                            CornerRadius="12" Padding="12">
                                        <TextBlock Text="{Binding ActiveQuestion.StudentAnswerText}"
                                                   FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                                    </Border>

                                    <Border Background="{DynamicResource WarningSurfaceBrush}"
                                            BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                            CornerRadius="14" Padding="12" Margin="0,14,0,0"
                                            Visibility="{Binding ActiveQuestion.HasSchemeCheck, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Scheme check" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource WarningTextBrush}" />
                                            <TextBlock Text="{Binding ActiveQuestion.SchemeCheck.Evidence}"
                                                       TextWrapping="Wrap" FontSize="11.5" Margin="0,5,0,0"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="Scheme answer: " FontWeight="SemiBold" />
                                                <Run Text="{Binding ActiveQuestion.SchemeCheck.SchemeAnswer, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="Independently verified: " FontWeight="SemiBold" />
                                                <Run Text="{Binding ActiveQuestion.SchemeCheck.IndependentlyVerifiedAnswer, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding ActiveQuestion.SchemeCheck.DiscrepancyTypeText}"
                                                       Foreground="{DynamicResource WarningTextBrush}"
                                                       FontSize="11" Margin="0,5,0,0"
                                                       Visibility="{Binding ActiveQuestion.SchemeCheck.HasDiscrepancyType, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- The decision is one block: the marks, the two
                                         buttons that commit them, and their own
                                         error, so nothing else can be mistaken
                                         for the action. -->
                                    <Border Style="{StaticResource Panel}" Padding="14" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Your mark" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="Digits stage a mark; it is written to this question only when you set it."
                                                       FontSize="11" Margin="0,3,0,10" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}" />

                                        <ItemsControl ItemsSource="{Binding MarkChoices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Text}" Style="{StaticResource MarkButton}"
                                                            AutomationProperties.Name="{Binding Text, StringFormat=Mark {0}}"
                                                            Command="{Binding DataContext.StageMarkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Value}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding ActiveQuestion.MaxZeroText}"
                                                   Foreground="{DynamicResource WarningTextBrush}" FontSize="11"
                                                   Visibility="{Binding ActiveQuestion.MaxZeroText, Converter={StaticResource NullToVisibility}}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Accept" Command="{Binding AcceptCommand}"
                                                    Height="38" Padding="16,7"
                                                    ToolTip="Accept without writing (Enter)" />
                                            <Button Content="{Binding SetMarkText}" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding CommitDraftCommand}"
                                                    IsEnabled="{Binding HasDraft}"
                                                    ToolTip="Write the staged mark (Enter)" />
                                        </StackPanel>
                                        <TextBlock Text="Enter accepts when nothing is staged. Digits stage; nothing is saved until Set."
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ActiveQuestion.LedgerLine}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11" Margin="0,7,0,0"
                                                   Visibility="{Binding ActiveQuestion.LedgerLine, Converter={StaticResource NullToVisibility}}" />

                                        <Border Style="{StaticResource ErrorBanner}" Margin="0,10,0,0"
                                                Visibility="{Binding HasQuestionError, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding QuestionError}" Style="{StaticResource ErrorText}" />
                                        </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Approval sheet: one durable whole-paper decision. -->
                                <Border x:Name="ApprovePanel" Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource HairlineStrongBrush}"
                                        BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,16,0,0"
                                        Visibility="{Binding IsApprovePanelOpen, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="Approve this paper" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding ApproveHint}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="Whole-paper mark" VerticalAlignment="Center"
                                                       FontSize="11.5" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBox Width="76" Text="{Binding WholePaperMarkText, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Whole-paper mark" />
                                        </StackPanel>
                                        <TextBlock Text="Leave empty to approve the engine's marks as they stand."
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="Confirm approval" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding ConfirmApproveCommand}"
                                                    IsEnabled="{Binding IsApproving, Converter={StaticResource InverseBool}}" />
                                            <Button Content="Cancel" Command="{Binding CancelApproveCommand}" />
                                        </StackPanel>
                                        <Border Style="{StaticResource ErrorBanner}" Margin="0,10,0,0"
                                                Visibility="{Binding HasApproveError, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding ApproveError}" Style="{StaticResource ErrorText}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Shortcut sheet: pointer users keep every action too. -->
            <Border Grid.ColumnSpan="5" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="380" Margin="0,10,12,0" Padding="16" Panel.ZIndex="10"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1"
                    CornerRadius="18"
                    Visibility="{Binding IsShortcutsOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold" FontSize="13" />
                        <Button DockPanel.Dock="Right" Content="Close" Height="28" Padding="10,3"
                                HorizontalAlignment="Right" Margin="0"
                                Command="{Binding ToggleShortcutsCommand}" />
                    </DockPanel>
                    <TextBlock Text="{Binding ShortcutText}" FontFamily="{StaticResource MonoFont}"
                               FontSize="11.5" Margin="0,10,0,0" TextWrapping="NoWrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer: three honest counts and the one durable action. -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0"
                Padding="2,12,2,2" Margin="0,14,0,0"
                Visibility="{Binding HasPaper, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Undo change" Command="{Binding UndoCommand}"
                            Height="36" Padding="14,6" IsEnabled="{Binding HasChanges}"
                            ToolTip="Ctrl+Z" />
                    <Button Content="Approve paper" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApproveCommand}" Height="36" Padding="18,6"
                            IsEnabled="{Binding CanApprove}" Margin="0"
                            ToolTip="Approve the paper (A)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="N/P question  ·  Shift+N/P paper  ·  Enter accept  ·  A approve"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="NoWrap" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
    </ui:PageFrame>
</UserControl>

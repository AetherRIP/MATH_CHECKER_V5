<UserControl x:Class="MathChecker.Desktop.Views.MarkingDeskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MathChecker.Desktop.Controls"
             Focusable="True" IsTabStop="False" Background="Transparent">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedQuestions" Source="{Binding Questions}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Topic" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="RailItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource LimeFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="{TemplateBinding Background}"
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{StaticResource LimeSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MarkButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource LimeFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{StaticResource LimeBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{StaticResource LimeBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource TextMutedBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStaged}" Value="True">
                    <Setter Property="Background" Value="{StaticResource LimeBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource LimeInkBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource LimeBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProvenanceChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProvenanceTone}" Value="lime">
                    <Setter Property="Background" Value="{StaticResource LimeBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource LimeBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource LimeInkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProvenanceTone}" Value="lime-outline">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="{StaticResource LimeBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProvenanceTone}" Value="amber">
                    <Setter Property="Background" Value="{StaticResource OrangeSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource OrangeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProvenanceTone}" Value="mint">
                    <Setter Property="Background" Value="{StaticResource LimeSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource LimeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuestionChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveQuestion.StateTone}" Value="amber">
                    <Setter Property="Background" Value="{StaticResource OrangeSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource OrangeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActiveQuestion.StateTone}" Value="lime">
                    <Setter Property="Background" Value="{StaticResource LimeSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource LimeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActiveQuestion.StateTone}" Value="mint">
                    <Setter Property="Background" Value="{StaticResource LimeSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource LimeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeskSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ShowsPreview" Value="False" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: whose paper, how it scores, how it came to be. -->
        <Border Grid.Row="0" Padding="2,0,2,14" BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding HasPaper, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource ProvenanceChip}" Margin="0,0,16,0"
                            AutomationProperties.Name="{Binding ProvenanceLabel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ProvenanceGlyph}" FontWeight="Bold"
                                       FontSize="12" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding ProvenanceLabel}" FontSize="11.5"
                                       FontWeight="Medium" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ScoreText}" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="22" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PercentageText}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding GradeText}" FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>

                    <Button Content="Results" Style="{StaticResource GhostButton}"
                            Command="{Binding OpenResultsCommand}" Height="34" Padding="12,6" />
                    <Button Content="Export PDF" Style="{StaticResource GhostButton}"
                            Command="{Binding ExportPdfCommand}" Height="34" Padding="12,6" />
                    <Button Content="Re-mark with AI" Command="{Binding RemarkCommand}"
                            Height="34" Padding="12,6" Margin="0" />
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StudentName}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="26" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding PaperLine}" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="  ·  Paper review" FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- A failed detail load keeps the paper visible; the marks are what failed. -->
        <Border Grid.Row="1" Style="{StaticResource ErrorBanner}" Margin="0,12,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Try again" Command="{Binding RefreshCommand}"
                        Height="30" Padding="12,5" Margin="10,0,0,0" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" />
            </DockPanel>
        </Border>

        <!-- No paper open. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="36" Margin="0,14,0,0"
                Visibility="{Binding HasNoPaper, Converter={StaticResource BoolToVis}}">
            <StackPanel MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No paper open" FontFamily="{StaticResource DisplayFont}"
                           FontSize="24" FontWeight="Medium" TextAlignment="Center" />
                <TextBlock Text="Open a correction from Results, then the student's paper appears here."
                           Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center" />
                <Button Content="Go to Results" Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenResultsCommand}" HorizontalAlignment="Center"
                        Margin="0,18,0,0" />
            </StackPanel>
        </Border>

        <!-- The desk: questions, paper, decision. -->
        <Grid Grid.Row="2" Margin="0,14,0,0"
              Visibility="{Binding HasPaper, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="176" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="330" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="360" MinWidth="320" MaxWidth="480" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="0"
                    CornerRadius="20">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,14,14,10">
                        <DockPanel>
                            <TextBlock Text="QUESTIONS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Questions.Count, StringFormat={}{0}}"
                                       FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>
                    <ListBox x:Name="QuestionRail" ItemsSource="{Binding Source={StaticResource GroupedQuestions}}"
                             SelectedItem="{Binding ActiveQuestion, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource RailItem}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.IsVirtualizingWhenGrouping="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Questions">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="9.5" FontWeight="SemiBold"
                                                   Typography.Capitals="AllSmallCaps"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="16,12,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="3,0,0,0" Padding="8,8,8,8"
                                        AutomationProperties.Name="{Binding AutomationName}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAttention}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource OrangeBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding RailGlyph}" Width="18" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Number}" FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StateLabel}" FontSize="10.5"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding MarkText}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource DeskSplitter}" />

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0"
                    CornerRadius="20" Background="{StaticResource SurfaceBrush}">
                <controls:PaperPaneView x:Name="PaperView" DataContext="{Binding Paper}"
                                        Margin="16,14,16,12" />
            </Border>

            <GridSplitter Grid.Column="3" Style="{StaticResource DeskSplitter}" />

            <Border Grid.Column="4" Style="{StaticResource Card}" Margin="0" Padding="0"
                    CornerRadius="20" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="18,14,16,12" BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="0,0,0,1" Background="{StaticResource SurfaceRaisedBrush}"
                            Visibility="{Binding HasActiveQuestion, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding ActiveQuestion.Number, StringFormat=Question {0}}"
                                           FontFamily="{StaticResource DisplayFont}" FontSize="21"
                                           FontWeight="Medium" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveQuestion.MarkText}"
                                           FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"
                                           Foreground="{StaticResource LimeBrush}" />
                            </DockPanel>
                            <DockPanel Margin="0,3,0,0">
                                <TextBlock Text="{Binding ActiveQuestion.Topic}" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding QuestionPosition}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <Border Style="{StaticResource QuestionChip}" Margin="0,9,0,0">
                                <TextBlock FontSize="10.5" Foreground="{StaticResource TextBrush}">
                                    <Run Text="{Binding ActiveQuestion.StateGlyph, Mode=OneWay}"
                                         FontWeight="Bold" />
                                    <Run Text=" " />
                                    <Run Text="{Binding ActiveQuestion.StateLabel, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding ActiveQuestion.AttentionText}"
                                       FontSize="10.5" Margin="0,7,0,0"
                                       Foreground="{StaticResource OrangeTextBrush}"
                                       Visibility="{Binding ActiveQuestion.AttentionText, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="MarkPanelFocus" Grid.Row="1" Focusable="True"
                            KeyboardNavigation.IsTabStop="True"
                            FocusVisualStyle="{x:Null}" Background="Transparent">
                        <ScrollViewer x:Name="MarkPanelScroll" Focusable="False" IsTabStop="False"
                                      VerticalScrollBarVisibility="Auto" Padding="18,14,14,16">
                            <StackPanel>
                                <TextBlock Text="Select a question on the left to review its mark."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveQuestion}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="This correction stored totals only. The PDF report has the feedback."
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding HasNoQuestionData, Converter={StaticResource BoolToVis}}" />

                                <StackPanel Visibility="{Binding HasActiveQuestion, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="HOW THE MARK WAS BUILT" Style="{StaticResource SectionTitle}"
                                               Margin="0,2,0,8" />
                                    <ItemsControl ItemsSource="{Binding ActiveQuestion.Source.MarkBreakdown}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3,0,3">
                                                    <TextBlock DockPanel.Dock="Left" Width="18" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="✗" />
                                                                <Setter Property="Foreground" Value="{StaticResource OrangeBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Awarded}" Value="True">
                                                                        <Setter Property="Text" Value="✓" />
                                                                        <Setter Property="Foreground" Value="{StaticResource LimeBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Code}"
                                                               Width="44" FontWeight="SemiBold" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Reason}" FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No mark breakdown was stored for this question."
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveQuestion.HasBreakdown}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="WHY MARKS WERE LOST" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding ActiveQuestion.LossReasonText}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" />

                                    <TextBlock Text="WHAT THE STUDENT WROTE" Style="{StaticResource SectionTitle}" />
                                    <Border Background="{StaticResource CanvasBrush}"
                                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                            CornerRadius="12" Padding="12">
                                        <TextBlock Text="{Binding ActiveQuestion.StudentAnswerText}"
                                                   FontSize="12.5" Foreground="{StaticResource TextBrush}" />
                                    </Border>

                                    <Border Background="{StaticResource OrangeSurfaceBrush}"
                                            BorderBrush="{StaticResource OrangeBrush}" BorderThickness="1"
                                            CornerRadius="14" Padding="12" Margin="0,14,0,0"
                                            Visibility="{Binding ActiveQuestion.HasSchemeCheck, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Scheme check" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{StaticResource OrangeTextBrush}" />
                                            <TextBlock Text="{Binding ActiveQuestion.SchemeCheck.Evidence}"
                                                       TextWrapping="Wrap" FontSize="11.5" Margin="0,5,0,0"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="Scheme answer: " FontWeight="SemiBold" />
                                                <Run Text="{Binding ActiveQuestion.SchemeCheck.SchemeAnswer, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="Independently verified: " FontWeight="SemiBold" />
                                                <Run Text="{Binding ActiveQuestion.SchemeCheck.IndependentlyVerifiedAnswer, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding ActiveQuestion.SchemeCheck.DiscrepancyType}"
                                                       Foreground="{StaticResource OrangeTextBrush}"
                                                       FontSize="10.5" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="YOUR MARK" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding MarkChoices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Text}" Style="{StaticResource MarkButton}"
                                                        AutomationProperties.Name="{Binding Text, StringFormat=Mark {0}}"
                                                        Command="{Binding DataContext.StageMarkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Value}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding ActiveQuestion.MaxZeroText}"
                                               Foreground="{StaticResource OrangeTextBrush}" FontSize="11"
                                               Visibility="{Binding ActiveQuestion.MaxZeroText, Converter={StaticResource NullToVisibility}}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Accept" Command="{Binding AcceptCommand}"
                                                Height="38" Padding="16,7"
                                                ToolTip="Accept without writing (Enter)" />
                                        <Button Content="{Binding SetMarkText}" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding CommitDraftCommand}"
                                                IsEnabled="{Binding HasDraft}"
                                                ToolTip="Write the staged mark (Enter)" />
                                    </StackPanel>
                                    <TextBlock Text="Enter accepts when nothing is staged. Digits stage; nothing is saved until Set."
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"
                                               Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ActiveQuestion.LedgerLine}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" Margin="0,7,0,0"
                                               Visibility="{Binding ActiveQuestion.LedgerLine, Converter={StaticResource NullToVisibility}}" />

                                    <Border Style="{StaticResource ErrorBanner}" Margin="0,10,0,0"
                                            Visibility="{Binding HasQuestionError, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding QuestionError}" Style="{StaticResource ErrorText}" />
                                    </Border>
                                </StackPanel>

                                <!-- Approval sheet: one durable whole-paper decision. -->
                                <Border x:Name="ApprovePanel" Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource HairlineStrongBrush}"
                                        BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,16,0,0"
                                        Visibility="{Binding IsApprovePanelOpen, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="Approve this paper" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding ApproveHint}" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="Whole-paper mark" VerticalAlignment="Center"
                                                       FontSize="11.5" Margin="0,0,8,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBox Width="76" Text="{Binding WholePaperMarkText, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Whole-paper mark" />
                                        </StackPanel>
                                        <TextBlock Text="Leave empty to approve the engine's marks as they stand."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"
                                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="Confirm approval" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding ConfirmApproveCommand}"
                                                    IsEnabled="{Binding IsApproving, Converter={StaticResource InverseBool}}" />
                                            <Button Content="Cancel" Command="{Binding CancelApproveCommand}" />
                                        </StackPanel>
                                        <Border Style="{StaticResource ErrorBanner}" Margin="0,10,0,0"
                                                Visibility="{Binding HasApproveError, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding ApproveError}" Style="{StaticResource ErrorText}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Shortcut sheet: pointer users keep every action too. -->
            <Border Grid.ColumnSpan="5" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="380" Margin="0,10,12,0" Padding="16" Panel.ZIndex="10"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1"
                    CornerRadius="18"
                    Visibility="{Binding IsShortcutsOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold" FontSize="13" />
                        <Button DockPanel.Dock="Right" Content="Close" Height="28" Padding="10,3"
                                HorizontalAlignment="Right" Margin="0"
                                Command="{Binding ToggleShortcutsCommand}" />
                    </DockPanel>
                    <TextBlock Text="{Binding ShortcutText}" FontFamily="{StaticResource MonoFont}"
                               FontSize="11.5" Margin="0,10,0,0" TextWrapping="NoWrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer: three honest counts and the one durable action. -->
        <Border Grid.Row="3" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0"
                Padding="2,12,2,2" Margin="0,14,0,0"
                Visibility="{Binding HasPaper, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Undo change" Command="{Binding UndoCommand}"
                            Height="36" Padding="14,6" IsEnabled="{Binding HasChanges}"
                            ToolTip="Ctrl+Z" />
                    <Button Content="Approve paper" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApproveCommand}" Height="36" Padding="18,6"
                            IsEnabled="{Binding CanApprove}" Margin="0"
                            ToolTip="Approve the paper (A)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="N/P question  ·  Shift+N/P paper  ·  Enter accept  ·  A approve"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"
                               VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="NoWrap" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

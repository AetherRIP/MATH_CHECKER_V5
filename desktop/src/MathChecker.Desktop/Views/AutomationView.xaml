<UserControl x:Class="MathChecker.Desktop.Views.AutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="{Binding WorkerText}" StatusText="{Binding CountsText}"
                  ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,18,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Worker on/off" Command="{Binding ToggleWorkerCommand}" />
                <Button Content="Run now" Style="{StaticResource PrimaryButton}" Command="{Binding RunNowCommand}" />
                <Button Content="Reconcile" Command="{Binding ReconcileCommand}" Margin="0" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="AUTOMATION SETTINGS" Style="{StaticResource SectionLabel}" />
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox Content="Automation enabled" IsChecked="{Binding Enabled}" />
                        <CheckBox Content="Review mode (wait for a teacher)" IsChecked="{Binding ReviewMode}" />
                        <CheckBox Content="Draft grades only" IsChecked="{Binding DraftOnly}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,2,0,0">
                        <CheckBox Content="Attach report" IsChecked="{Binding AttachReport}" />
                        <CheckBox Content="Submit grade" IsChecked="{Binding SubmitGrade}" />
                        <CheckBox Content="Return work" IsChecked="{Binding ReturnWork}" />
                    </WrapPanel>

                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,10,0,10" />

                    <WrapPanel>
                        <TextBlock Text="Interval (min)" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="84" ItemsSource="{Binding Intervals}"
                                  SelectedItem="{Binding IntervalMinutes}" />
                        <TextBlock Text="Report detail" Style="{StaticResource FieldLabel}" Margin="10,0,6,0" />
                        <ComboBox Width="120" ItemsSource="{Binding ReportDetails}"
                                  SelectedValuePath="Value" SelectedValue="{Binding ReportDetail}" />
                        <Button Content="Save settings" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveSettingsCommand}" Height="34" Padding="14,4" />
                        <Button Content="Approve selected" Command="{Binding ApproveCommand}"
                                Height="34" Padding="12,4" IsEnabled="{Binding HasSelection}"
                                ToolTip="Select a job row first" />
                        <Button Content="Retry selected" Command="{Binding RetryCommand}"
                                IsEnabled="{Binding HasSelection}" ToolTip="Select a job row first"
                                Height="34" Padding="12,4" Margin="0" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TableCard}" Height="300">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                        <TextBlock Text="Automation jobs" Style="{StaticResource RowTitle}" />
                    </Border>
                    <Grid>
                        <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="7" ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding Selected}" AutomationProperties.Name="Automation jobs">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Student" Binding="{Binding Name}" Width="150" />
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="140" />
                                <DataGridTextColumn Header="Pipeline" Binding="{Binding PipelineLabel}" Width="190"
                                                    ui:TableLayout.Priority="2" />
                                <DataGridTextColumn Header="Stage" Binding="{Binding StageIndex}" Width="66"
                                                    ui:TableLayout.Priority="2" />
                                <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="66"
                                                    ui:TableLayout.Priority="1" />
                                <DataGridTextColumn Header="Retry from" Binding="{Binding RetryFrom}" Width="120"
                                                    ui:TableLayout.Priority="3" />
                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" Width="128"
                                                    ui:TableLayout.Priority="1" />
                                <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Style="{StaticResource EmptyState}" MaxWidth="360"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Nothing is automated yet" Style="{StaticResource EmptyTitle}" />
                                <TextBlock Text="Jobs appear here once the worker picks up a paper."
                                           Style="{StaticResource EmptyText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="AUTOMATION ACTIVITY" Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Clear log" Command="{Binding ClearLogCommand}"
                                Height="26" Padding="9,2" HorizontalAlignment="Right" />
                    </DockPanel>
                    <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding LogLines}" AutomationProperties.Name="Automation log">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Margin="0,2"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Expander Header="Technical details" Margin="0,10,0,0"
                              Visibility="{Binding HasLogRaw, Converter={StaticResource BoolToVis}}">
                        <TextBox Style="{StaticResource JsonBox}" Text="{Binding LogRaw, Mode=OneWay}"
                                 Margin="0,4,0,0" MinHeight="110" MaxHeight="240" />
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </ui:PageFrame>
</UserControl>
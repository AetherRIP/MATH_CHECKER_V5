<UserControl x:Class="MathChecker.Desktop.Views.AutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">

    <UserControl.Resources>
        <!-- The assignment's name is the link into its own page. -->
        <Style x:Key="TitleLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CountChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="CountText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="Choose an assignment, check exactly what will be corrected, then start. Every paper's progress appears in Correction monitor."
                  StatusText="{Binding QueueSummary}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  Sync="{Binding SyncService}"
                  BodyPadding="0,16,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Correction monitor" Command="{Binding OpenMonitorCommand}"
                        ToolTip="Watch each paper being corrected, with real stages and progress" />
                <Button Content="Assignments" Command="{Binding OpenAssignmentsCommand}" Margin="0"
                        ToolTip="Sync and inspect every assignment, including ones with no mark scheme" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- One filter bar for the assignment list; it never affects the
                 queue or the review panel. -->
            <Border Grid.Row="0" Style="{StaticResource FilterBar}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Find an assignment" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Find an assignment" />
                    <TextBlock Grid.Column="2" Text="Class" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="12,0,8,0" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding ClassFilters}"
                              SelectedItem="{Binding ClassFilter}"
                              AutomationProperties.Name="Filter by class" />
                    <Border Grid.Column="4" Style="{StaticResource Chip}" Padding="9,3"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding ShownText}" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- ================================================== 1 · pick -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="1 · CHOOSE AN ASSIGNMENT"
                                   Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock Text="The counts come from Google Classroom as last synced."
                                   FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="NoWrap" />
                    </DockPanel>

                    <Border Style="{StaticResource EmptyState}" MaxWidth="520" Margin="0,0,0,12"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource EmptyTitle}" />
                            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource EmptyText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="220" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <Button Style="{StaticResource TitleLink}"
                                                    Command="{Binding DataContext.OpenAssignmentCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Title}"
                                                    ToolTip="Open this assignment's students and submission statuses">
                                                <TextBlock Text="{Binding Title}" FontSize="15"
                                                           FontWeight="SemiBold" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Button>
                                            <TextBlock Text="{Binding ClassText}" FontSize="11.5"
                                                       Margin="0,3,0,0" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding DueText}" FontSize="10.5"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="NoWrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" Margin="14,0,0,0">
                                            <WrapPanel HorizontalAlignment="Right">
                                                <Border Style="{StaticResource CountChip}">
                                                    <TextBlock Text="{Binding RosterText}" Style="{StaticResource CountText}" />
                                                </Border>
                                                <Border Style="{StaticResource CountChip}">
                                                    <TextBlock Text="{Binding SubmittedText}" Style="{StaticResource CountText}" />
                                                </Border>
                                                <Border Style="{StaticResource CountChip}">
                                                    <TextBlock Text="{Binding AwaitingText}" Style="{StaticResource CountText}"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <Border Style="{StaticResource CountChip}">
                                                    <TextBlock Text="{Binding CorrectedText}" Style="{StaticResource CountText}" />
                                                </Border>
                                                <Border Style="{StaticResource CountChip}"
                                                        Visibility="{Binding HasProcessing, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding ProcessingText}" Style="{StaticResource CountText}" />
                                                </Border>
                                            </WrapPanel>

                                            <DockPanel Margin="0,8,0,0" HorizontalAlignment="Right">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ReadyText}"
                                                           FontSize="10.5" Margin="10,0,0,0"
                                                           VerticalAlignment="Center" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <Button Content="Auto-correct"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Height="30" Padding="12,3" Margin="0"
                                                        IsEnabled="{Binding IsReady}"
                                                        Command="{Binding DataContext.SelectCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Title, StringFormat=Auto-correct {0}}"
                                                        ToolTip="{Binding ReadyText}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ================================================ 2 · review -->
                    <TextBlock Text="2 · REVIEW BEFORE STARTING" Style="{StaticResource SectionLabel}"
                               Margin="0,10,0,8" />

                    <Border Style="{StaticResource Card}" Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="Pick an assignment above: its papers, the blockers and the exact number to correct appear here before anything is queued."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Open full details"
                                        Command="{Binding OpenAssignmentCommand}" VerticalAlignment="Top"
                                        ToolTip="See every student's submission and correction status" />
                                <StackPanel>
                                    <TextBlock Text="{Binding ReviewTitle}" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PreviewSummary}" FontSize="12.5" Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource WarningBanner}" Margin="0,12,0,0"
                                    Visibility="{Binding HasBlockers, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="This assignment cannot be corrected yet"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                    <ItemsControl ItemsSource="{Binding Blockers}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap"
                                                           Margin="0,1"
                                                           Foreground="{DynamicResource WarningTextBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InfoBanner}" Margin="0,12,0,0"
                                    Visibility="{Binding HasSyncWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SyncWarning}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>

                            <DockPanel Margin="0,14,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Check again" Command="{Binding ReviewAgainCommand}"
                                            ToolTip="Re-read Classroom and recompute these numbers" />
                                    <Button Content="{Binding StartText}" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding StartCommand}" Margin="0"
                                            ToolTip="Queue exactly these papers; one failure never stops the rest" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="PAPERS THAT WILL BE CORRECTED"
                                               Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="Each paper is its own queued job."
                                               FontSize="10.5" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource TableCard}" Margin="0,8,0,0" MaxHeight="180">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                                        <ItemsControl ItemsSource="{Binding PreviewPapers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="11.5" Margin="0,2"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Border Style="{StaticResource EmptyState}" Margin="12"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                            Visibility="{Binding PreviewPapers.Count, Converter={StaticResource ZeroToVis}}">
                                        <TextBlock Text="No paper meets the requirements right now."
                                                   Style="{StaticResource EmptyText}" TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </Border>

                            <DockPanel Margin="0,10,0,0"
                                       Visibility="{Binding HasSkippedPapers, Converter={StaticResource BoolToVis}}">
                                <TextBlock DockPanel.Dock="Left" Text="SKIPPED" Style="{StaticResource SectionLabel}"
                                           VerticalAlignment="Top" Margin="0,2,14,0" />
                                <ItemsControl ItemsSource="{Binding SkippedPapers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="11" Margin="0,1"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>

                            <Border Style="{StaticResource InfoBanner}" Margin="0,12,0,0"
                                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ResultText}" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ================================================= 3 · queue -->
                    <TextBlock Text="3 · QUEUE" Style="{StaticResource SectionLabel}" Margin="0,10,0,8" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Open Correction monitor"
                                    Style="{StaticResource PrimaryButton}" Command="{Binding OpenMonitorCommand}"
                                    Height="32" Padding="14,4" Margin="14,0,0,0"
                                    ToolTip="See each queued and running paper, with real progress" />
                            <StackPanel>
                                <TextBlock Text="{Binding QueueSummary}" FontSize="13.5" FontWeight="SemiBold"
                                           TextWrapping="NoWrap" />
                                <TextBlock Text="{Binding QueueDetail}" FontSize="11" Margin="0,3,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ============================================== advanced -->
                    <Expander Header="Advanced settings — background checks and Classroom posting"
                              Margin="0,14,0,0">
                        <StackPanel Margin="0,4,0,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="BACKGROUND CHECK" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="A separate, scheduled scan: it looks for work that was handed in after you last looked. It does not correct an assignment you have not allow-listed."
                                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10" />

                                    <WrapPanel>
                                        <CheckBox Content="Scan for new work automatically" IsChecked="{Binding Enabled}"
                                                  ToolTip="Runs the background scheduler at the interval below" />
                                        <CheckBox Content="Hold each result for teacher review"
                                                  IsChecked="{Binding ReviewMode}"
                                                  ToolTip="Nothing is returned to students until you approve it" />
                                        <CheckBox Content="Save grades as drafts only" IsChecked="{Binding DraftOnly}"
                                                  ToolTip="Classroom keeps the grade as a draft instead of releasing it" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,2,0,0">
                                        <CheckBox Content="Attach the correction report" IsChecked="{Binding AttachReport}"
                                                  ToolTip="Adds the PDF report to the Classroom submission" />
                                        <CheckBox Content="Post the grade to Classroom" IsChecked="{Binding SubmitGrade}"
                                                  ToolTip="Writes the earned marks into Classroom's grade field" />
                                        <CheckBox Content="Return the work to the student" IsChecked="{Binding ReturnWork}"
                                                  ToolTip="Marks the submission as returned, so the student can see it" />
                                    </WrapPanel>

                                    <Border Style="{StaticResource Divider}" Margin="0,10" />

                                    <WrapPanel>
                                        <TextBlock Text="Check every" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Width="84" ItemsSource="{Binding Intervals}"
                                                  SelectedItem="{Binding IntervalMinutes}"
                                                  ToolTip="Minutes between background scans" />
                                        <TextBlock Text="minutes" Style="{StaticResource FieldLabel}" Margin="6,0,10,0" />
                                        <TextBlock Text="Report detail" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Width="120" ItemsSource="{Binding ReportDetails}"
                                                  SelectedValuePath="Value" SelectedValue="{Binding ReportDetail}"
                                                  ToolTip="How much question-level detail the attached report contains" />
                                        <Button Content="Save background settings" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding SaveSettingsCommand}" Height="34" Padding="14,4" />
                                        <Button Content="Check now" Command="{Binding RunNowCommand}" Height="34"
                                                Padding="12,4"
                                                ToolTip="Run one scan immediately, without waiting for the interval" />
                                        <Button Content="Re-check with Classroom" Command="{Binding ReconcileCommand}"
                                                Height="34" Padding="12,4" Margin="0"
                                                ToolTip="Re-read the state of jobs that were already queued" />
                                    </WrapPanel>

                                    <DockPanel Margin="0,10,0,0">
                                        <Button DockPanel.Dock="Right" Content="Start / stop background worker"
                                                Command="{Binding ToggleWorkerCommand}" Height="28" Padding="10,3"
                                                ToolTip="Stops or starts the scheduler process without changing settings" />
                                        <TextBlock Text="{Binding WorkerText}" FontSize="11" VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource TableCard}" Margin="0,10,0,0" Height="220">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="Release selected" Command="{Binding ApproveCommand}"
                                                        IsEnabled="{Binding HasSelectedAutomationJob}"
                                                        Height="26" Padding="9,2"
                                                        ToolTip="Select a job waiting for a decision" />
                                                <Button Content="Retry selected" Command="{Binding RetryAutomationCommand}"
                                                        IsEnabled="{Binding HasSelectedAutomationJob}"
                                                        Height="26" Padding="9,2" Margin="0"
                                                        ToolTip="Select a failed job" />
                                            </StackPanel>
                                            <TextBlock Text="Background jobs" Style="{StaticResource RowTitle}"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <Grid>
                                        <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding AutomationJobs}"
                                                  SelectedItem="{Binding SelectedAutomationJob}"
                                                  AutomationProperties.Name="Background jobs">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Student" Binding="{Binding Name}" Width="150" />
                                                <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="140" />
                                                <DataGridTextColumn Header="Stage" Binding="{Binding PipelineLabel}" Width="*" />
                                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" Width="128" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Border Style="{StaticResource EmptyState}" MaxWidth="360"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsEmptyAutomation, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="No background jobs yet" Style="{StaticResource EmptyTitle}" />
                                                <TextBlock Text="Nothing has been picked up by the scheduled scan."
                                                           Style="{StaticResource EmptyText}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Clear log"
                                                Command="{Binding ClearLogCommand}" Height="26" Padding="9,2" />
                                        <TextBlock Text="BACKGROUND ACTIVITY" Style="{StaticResource SectionLabel}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding LogLines}"
                                                      AutomationProperties.Name="Background activity">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="11.5" Margin="0,2"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Expander Header="Technical details" Margin="0,10,0,0"
                                              Visibility="{Binding HasLogRaw, Converter={StaticResource BoolToVis}}">
                                        <TextBox Style="{StaticResource JsonBox}" Text="{Binding LogRaw, Mode=OneWay}"
                                                 Margin="0,4,0,0" MinHeight="110" MaxHeight="220" />
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </ui:PageFrame>
</UserControl>

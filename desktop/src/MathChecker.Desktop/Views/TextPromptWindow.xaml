<Window x:Class="MathChecker.Desktop.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Math Checker" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" Margin="0,0,0,8" />
        <TextBox x:Name="ValueBox" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="OK" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>

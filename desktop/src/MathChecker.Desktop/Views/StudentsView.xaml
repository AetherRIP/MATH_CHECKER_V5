<UserControl x:Class="MathChecker.Desktop.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI"
             xmlns:views="clr-namespace:MathChecker.Desktop.Views">
    <UserControl.Resources>
        <!-- The theme wraps every TextBlock by default, which defeats
             trimming; these cells must stay on one line. -->
        <Style x:Key="FactLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FactValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- Headline counts, sized like the monitor's tiles rather than the page
             title: they are evidence, not decoration. -->
        <Style x:Key="SummaryTile" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="132" />
        </Style>

        <Style x:Key="SummaryNumber" TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
            <Setter Property="FontSize" Value="21" />
        </Style>

        <!-- Each roster row stacks three lines (name, latest activity, email).
             The shared table style's fixed 38 DIP row is too short for that, so
             the email was drawn over the next student's name; these rows size
             themselves instead. -->
        <Style x:Key="RosterTable" TargetType="DataGrid" BasedOn="{StaticResource DataTable}">
            <!-- NaN is the DataGrid's own "size to content" row height; the
                 string "Auto" is a GridLength, not a Double, and throws. -->
            <Setter Property="RowHeight" Value="{x:Static sys:Double.NaN}" />
            <Setter Property="MinRowHeight" Value="38" />
        </Style>
    </UserControl.Resources>

    <ui:PageFrame Eyebrow="{Binding HeaderEyebrow}" Title="{Binding HeaderTitle}"
                  Description="{Binding HeaderDescription}"
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  Sync="{Binding SyncService}"
                  BodyPadding="0,14,0,0">
        <ui:PageFrame.Actions>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                            Visibility="{Binding IsProfileClosed, Converter={StaticResource BoolToVis}}">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                    <Button Content="Open profile" Style="{StaticResource PrimaryButton}"
                            Command="{Binding OpenProfileCommand}"
                            ToolTip="Everything stored for the selected student" />
                    <Button Content="Results" Command="{Binding OpenResultsCommand}" Margin="0"
                            ToolTip="Open this person's stored corrections" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                            Visibility="{Binding IsProfileOpen, Converter={StaticResource BoolToVis}}">
                    <Button Content="Back to students" Command="{Binding CloseProfileCommand}" />
                    <Button Content="Refresh" Command="{Binding Profile.RefreshCommand}" />
                    <Button Content="Export report" Command="{Binding Profile.ReportCommand}" />
                    <Button Content="Results" Command="{Binding OpenResultsCommand}" Margin="0" />
                </StackPanel>
            </Grid>
        </ui:PageFrame.Actions>

        <Grid>
            <!-- ============================================================
                 ROSTER
                 ============================================================ -->
            <!-- A short window used to squeeze the roster to nothing: the two
                 auto rows (tiles, filters) took the whole body and the star row
                 got what was left. The roster row's height is worked out in
                 code-behind instead: the rest of the viewport when there is
                 room, a readable floor otherwise, and the page scrolls when
                 even the floor does not fit. -->
            <ScrollViewer x:Name="RosterScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          SizeChanged="OnRosterViewportChanged"
                          Visibility="{Binding IsProfileClosed, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ClassroomRow" Height="Auto" />
                    <RowDefinition x:Name="TilesRow" Height="Auto" />
                    <RowDefinition x:Name="FilterRow" Height="Auto" />
                    <RowDefinition x:Name="RosterRow" Height="240" />
                </Grid.RowDefinitions>

                <!-- Where the roster comes from, and the one action that starts
                     it: without this card a fresh copy had no way to connect a
                     Google Classroom account at all. -->
                <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="14,0,0,0">
                            <Button Content="{Binding ClassroomActionText}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ConnectClassroomCommand}"
                                    IsEnabled="{Binding CanConnect}"
                                    ToolTip="Sign in with the teacher's Google account"
                                    AutomationProperties.Name="Connect Google Classroom" />
                            <Button Content="Disconnect" Command="{Binding DisconnectClassroomCommand}"
                                    Margin="0"
                                    Visibility="{Binding ClassroomConnected, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Forget the stored Google token; local data is kept" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="GOOGLE CLASSROOM" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding ClassroomStateText}"
                                       Style="{StaticResource CardTitle}" Margin="0,5,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ClassroomHint}" Style="{StaticResource Muted}"
                                       Margin="0,3,0,0" />
                            <TextBlock Text="{Binding ClassroomProblem}"
                                       Style="{StaticResource WarningText}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasClassroomProblem, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Headline counts as tiles, with the sync provenance beside
                     them: the numbers line up because each sits in its own tile
                     instead of a WrapPanel. -->
                <DockPanel Grid.Row="1" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center"
                                HorizontalAlignment="Right" Margin="10,0,0,0">
                        <TextBlock Text="{Binding LastSyncText}" FontSize="10.5"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <!-- Google does return addresses for every account type,
                             so the page says where they came from. -->
                        <TextBlock Text="{Binding EmailSource, StringFormat=Email source: {0}}"
                                   FontSize="10.5" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>

                    <WrapPanel>
                        <Border Style="{StaticResource SummaryTile}">
                            <StackPanel>
                                <TextBlock Text="STUDENTS" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding StudentsCountText}"
                                           Style="{StaticResource SummaryNumber}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryTile}">
                            <StackPanel>
                                <TextBlock Text="CLASSES" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding ClassesCountText}"
                                           Style="{StaticResource SummaryNumber}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryTile}">
                            <StackPanel>
                                <TextBlock Text="CORRECTIONS" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding CorrectionsCountText}"
                                           Style="{StaticResource SummaryNumber}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryTile}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="IN PROGRESS" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding InProgressCountText}"
                                           Style="{StaticResource SummaryNumber}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </DockPanel>

                <Border Grid.Row="2" Style="{StaticResource FilterBar}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <!-- Flexible with caps, not fixed 240/220: the two
                                 fixed columns plus the 80 DIP hint summed past
                                 the page at the window's minimum width. -->
                            <ColumnDefinition Width="*" MinWidth="170" MaxWidth="240" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="140" MaxWidth="220" />
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Search" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search students" />

                        <TextBlock Grid.Column="2" Text="Class" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="14,0,8,0" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding ClassFilters}"
                                  SelectedItem="{Binding ClassFilter}"
                                  AutomationProperties.Name="Class filter" />

                        <TextBlock Grid.Column="4" Text="Select a row to open the full profile."
                                   FontSize="10.5" VerticalAlignment="Center" Margin="14,0,10,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextMutedBrush}" />

                        <Border Grid.Column="5" Style="{StaticResource Chip}" Padding="9,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ShownText}"
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource TableCard}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="9,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ShownText}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                                <TextBlock Text="Roster" Style="{StaticResource RowTitle}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <Grid>
                            <!-- A table, not a hand-built list: the header and the
                                 cells are the same columns, so the labels line up
                                 at every window width and the numeric block can
                                 never be pushed off the row. -->
                            <DataGrid Style="{StaticResource RosterTable}"
                                      ItemsSource="{Binding Items}"
                                      SelectedItem="{Binding Selected}"
                                      AutomationProperties.Name="Students">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Student" Width="1.15*" MinWidth="170"
                                                            ui:TableLayout.Priority="0">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding CoursesText}"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBlock Text="{Binding SummaryLine}" FontSize="10.5"
                                                               Margin="0,2,0,0"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding CoursesText}"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding EmailText}" FontSize="10.5"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding EmailText}"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Three labelled facts, each from a different
                                         source, so a Classroom grade is never read
                                         as a score. -->
                                    <DataGridTemplateColumn Header="Latest activity" Width="1.35*"
                                                            MinWidth="160"
                                                            ui:TableLayout.Priority="1">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LatestSubmissionText}"
                                                               FontSize="11.5"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding LatestSubmissionText}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding CorrectionText}"
                                                               FontSize="11.5" Margin="0,3,0,0"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding CorrectionText}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding ClassroomGradeText}"
                                                               FontSize="11.5" Margin="0,3,0,0"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ClassroomGradeText}"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- A star width, not Auto: three facts of
                                         differing length made the column wider
                                         than the table and pushed the last
                                         value under the window edge. -->
                                    <!-- Priorities keep the roster inside a narrow
                                         window: three 160-DIP floors cannot all fit
                                         in a 480-DIP body, and the grid used to
                                         spill past the window edge. -->
                                    <DataGridTemplateColumn Header="Records" Width="1.1*" MinWidth="250"
                                                            ui:TableLayout.Priority="2">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <UniformGrid Columns="3" Margin="0,4" VerticalAlignment="Center">
                                                    <StackPanel>
                                                        <TextBlock Text="SUBMITTED"
                                                                   Style="{StaticResource FactLabel}" />
                                                        <TextBlock Text="{Binding SubmittedText}"
                                                                   Style="{StaticResource FactValue}" />
                                                        <TextBlock Text="{Binding PendingText}" FontSize="10.5"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Visibility="{Binding Pending,
                                                                       Converter={StaticResource NonZeroToVis}}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="8,0,0,0">
                                                        <TextBlock Text="MATH CHECKER"
                                                                   Style="{StaticResource FactLabel}" />
                                                        <TextBlock Text="{Binding TotalText}"
                                                                   Style="{StaticResource FactValue}" />
                                                        <TextBlock Text="{Binding Corrections, StringFormat={}{0} corrections}"
                                                                   FontSize="10.5" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="8,0,0,0">
                                                        <TextBlock Text="LAST SYNC"
                                                                   Style="{StaticResource FactLabel}" />
                                                        <TextBlock Text="{Binding SyncText}"
                                                                   Style="{StaticResource FactValue}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Style="{StaticResource EmptyState}" MaxWidth="380"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVis}}">
                                <StackPanel>
                                    <TextBlock Text="No students match" Style="{StaticResource EmptyTitle}" />
                                    <TextBlock Text="Clear the search or pick another class. If the roster is empty, sync Google Classroom first."
                                               Style="{StaticResource EmptyText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
            </ScrollViewer>

            <!-- ============================================================
                 PROFILE
                 ============================================================ -->
            <!-- The profile's DataContext is the profile view model, so its
                 visibility must come from the PAGE, not from that DataContext
                 (a null DataContext would otherwise leave it visible). -->
            <views:StudentProfileView DataContext="{Binding Profile}"
                                      Visibility="{Binding DataContext.IsProfileOpen,
                                          RelativeSource={RelativeSource AncestorType={x:Type UserControl}},
                                          Converter={StaticResource BoolToVis}}" />

            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                    Style="{StaticResource Chip}" Padding="12,5"
                    Visibility="{Binding IsProfileLoading, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Loading student profile…" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
        </Grid>
    </ui:PageFrame>
</UserControl>

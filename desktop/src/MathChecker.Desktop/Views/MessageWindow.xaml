<Window x:Class="MathChecker.Desktop.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Math Checker"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="500"
        TextOptions.TextFormattingMode="Ideal"
        MouseLeftButtonDown="OnChromeMouseDown">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource DialogRadius}"
            Padding="24" Margin="18"
            Effect="{DynamicResource FloatingShadow}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Mark" Width="38" Height="38" CornerRadius="12"
                        Background="{DynamicResource AccentSoftBrush}" Margin="0,0,13,0">
                    <TextBlock x:Name="MarkGlyph" Text="&#xE8BD;"
                               FontFamily="{StaticResource IconFont}" FontSize="17"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="KindText" FontSize="10.5" FontWeight="SemiBold"
                               Margin="0,2,0,0" TextWrapping="NoWrap"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="MessageText" Margin="0,18,0,0"
                       FontSize="13" LineHeight="20" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"
                        Click="OnCancel" Margin="0,0,8,0" />
                <Button x:Name="OkButton" Content="Confirm" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="OnOk" Margin="0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

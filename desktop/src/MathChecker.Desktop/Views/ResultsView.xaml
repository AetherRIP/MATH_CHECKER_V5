<UserControl x:Class="MathChecker.Desktop.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">

    <UserControl.Resources>
        <!-- Compact figures for the detail pane: the page's job is one
             correction at a time, not a wall of numbers. -->
        <Style x:Key="MiniTile" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="MiniValue" TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>
    </UserControl.Resources>

    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="{Binding Summary}"
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,16,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <!-- Every action below reads the selected correction; with no row
                     selected they used to look available and do nothing. -->
                <Button Content="Open paper" Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenDeskCommand}" IsEnabled="{Binding HasSelection}" Margin="0"
                        ToolTip="Open the selected correction on the marking desk" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================================================ find a row -->
            <Border Grid.Row="0" Style="{StaticResource FilterBar}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!-- Flexible, not 260: the seven fixed columns summed
                             to 761 DIP, so at the window's minimum width the
                             row count and the hint were pushed off the page. -->
                        <ColumnDefinition Width="*" MinWidth="170" MaxWidth="280" />
                        <ColumnDefinition Width="Auto" />
                        <!-- The status label needs only its own text; the 150
                             DIP column was dead space. -->
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Search" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Grid Grid.Column="1">
                        <TextBox Margin="0" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search results" />
                        <TextBlock Text="Student or assignment…"
                                   FontSize="12.5" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"
                                   TextWrapping="NoWrap"
                                   Visibility="{Binding Query, Converter={StaticResource EmptyToVisibility}}" />
                    </Grid>

                    <Button Grid.Column="2" Content="Apply" Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryButton}" Height="32" Padding="16,5"
                            ToolTip="Re-read stored corrections with this search" />

                    <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="14,0,8,0" />
                    <ComboBox Grid.Column="4" ItemsSource="{Binding StatusOptions}"
                              SelectedValuePath="Value" SelectedValue="{Binding StatusFilter}"
                              AutomationProperties.Name="Filter by status" />

                    <TextBlock Grid.Column="5" Text="Select a row to inspect its marks and attempts."
                               FontSize="11" VerticalAlignment="Center" Margin="14,0,10,0"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <Border Grid.Column="6" Style="{StaticResource Chip}" Padding="9,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Items.Count, StringFormat={}{0} rows}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================== list + detail -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" MinWidth="220" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.35*" MinWidth="210" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TableCard}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="9,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Items.Count, StringFormat={}{0} stored}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                                <TextBlock Text="Stored corrections" Style="{StaticResource RowTitle}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <Grid>
                            <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="1"
                                      ItemsSource="{Binding Items}"
                                      SelectedItem="{Binding Selected}"
                                      AutomationProperties.Name="Stored corrections">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Student" Binding="{Binding Name}" Width="118"
                                                        ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Assignment" Binding="{Binding AssignmentTitle}"
                                                        Width="*" MinWidth="150"
                                                        ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Score" Binding="{Binding ScoreText}" Width="64" />
                                    <DataGridTextColumn Header="%" Binding="{Binding PercentageText}" Width="54"
                                                        ui:TableLayout.Priority="2" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="96"
                                                        ui:TableLayout.Priority="1" />
                                    <!-- 112 clipped the timestamp; 132 holds the full
                                         value at 100 % and 125 % scaling. -->
                                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" Width="132"
                                                        ui:TableLayout.Priority="2" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Style="{StaticResource EmptyState}" MaxWidth="340"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource EmptyTitle}" />
                                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource EmptyText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- ======================================== selected result -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="16,14"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Selected correction" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding DetailHeader}" Style="{StaticResource CardTitle}"
                                       FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"
                                       TextTrimming="None" />
                            <TextBlock Text="{Binding DetailNote}" Style="{StaticResource CardSubtitle}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />

                            <!-- Two figures, not three: the confidence is already
                                 spelled out in the line above, and a third tile
                                 squeezed its label at the window's minimum
                                 width. -->
                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                <Border Style="{StaticResource MiniTile}">
                                    <StackPanel>
                                        <TextBlock Text="Score" Style="{StaticResource StatLabel}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail.ScoreText}" Style="{StaticResource MiniValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MiniTile}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Percentage" Style="{StaticResource StatLabel}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail.PercentageText}"
                                                   Style="{StaticResource MiniValue}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock Text="Marking decisions" Style="{StaticResource SectionLabel}"
                                       Margin="0,14,0,6" />
                            <WrapPanel>
                                <Button Content="Re-mark with AI" Command="{Binding RemarkCommand}"
                                        Height="28" Padding="10,2" IsEnabled="{Binding HasDetail}"
                                        ToolTip="Mark this paper again; the previous attempt is kept" />
                                <Button Content="Use new attempt" Command="{Binding AcceptRemarkCommand}"
                                        Height="28" Padding="10,2" IsEnabled="{Binding HasDetail}"
                                        ToolTip="Make the newest attempt the student's result" />
                                <Button Content="Restore attempt" Command="{Binding RestoreLatestVersionCommand}"
                                        Height="28" Padding="10,2" IsEnabled="{Binding HasDetail}"
                                        ToolTip="Go back to the attempt that was in force before" />
                                <Button Content="Override mark…" Command="{Binding OverrideCommand}"
                                        Height="28" Padding="10,2" IsEnabled="{Binding HasDetail}"
                                        ToolTip="Set the total yourself; the engine result is kept as an attempt" />
                                <Button Content="Set question mark…" Command="{Binding SetQuestionMarkCommand}"
                                        Height="28" Padding="10,2" Margin="0"
                                        IsEnabled="{Binding HasDetail}"
                                        ToolTip="Select a question row first, then change just that mark" />
                            </WrapPanel>

                            <TextBlock Text="Questions" Style="{StaticResource SectionTitle}" />
                            <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="3"
                                      ItemsSource="{Binding Questions}"
                                      SelectedItem="{Binding SelectedQuestion}" Height="180"
                                      AutomationProperties.Name="Questions">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Q" Binding="{Binding NumberText}" Width="52" />
                                    <DataGridTextColumn Header="Mark" Binding="{Binding MarkText}" Width="72" />
                                    <DataGridTextColumn Header="Topic" Binding="{Binding Topic}" Width="130"
                                                        ui:TableLayout.Priority="2"
                                                        ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Loss reason" Binding="{Binding LossReason}"
                                                        Width="*"
                                                        ElementStyle="{StaticResource CellText}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- The parts of the row selected above, from the same
                                 stored result. Hidden when the question has none. -->
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding HasSelectedSubquestions, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Subquestions" Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding SelectedQuestion.Subquestions}"
                                              AutomationProperties.Name="Subquestions">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2,0,2">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding MarkText}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding LabelText}"
                                                           Width="54" FontSize="11.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding VerdictText}" FontSize="11.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="No per-question breakdown was stored for this correction."
                                       Style="{StaticResource CardSubtitle}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasQuestions, Converter={StaticResource InverseBoolToVis}}" />

                            <TextBlock Text="Export this correction" Style="{StaticResource SectionLabel}"
                                       Margin="0,14,0,6" />
                            <WrapPanel>
                                <Button Content="PDF" Command="{Binding ExportPdfCommand}"
                                        IsEnabled="{Binding HasSelection}" Height="28" Padding="12,2"
                                        ToolTip="Export the selected correction as PDF" />
                                <Button Content="CSV" Command="{Binding ExportCsvCommand}"
                                        IsEnabled="{Binding HasSelection}" Height="28" Padding="12,2"
                                        ToolTip="Export the selected correction as CSV" />
                                <Button Content="Markdown" Command="{Binding ExportMarkdownCommand}"
                                        IsEnabled="{Binding HasSelection}" Height="28" Padding="12,2" Margin="0"
                                        ToolTip="Export the selected correction as Markdown" />
                            </WrapPanel>

                            <Expander Header="All attempts" Margin="0,14,0,0">
                                <StackPanel Margin="0,4,0,0">
                                    <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="3"
                                              ItemsSource="{Binding Versions}" Height="140"
                                              AutomationProperties.Name="Attempts">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Version}" Width="46" />
                                            <DataGridTextColumn Header="Score" Binding="{Binding ScoreText}" Width="84" />
                                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}"
                                                                Width="112" ui:TableLayout.Priority="2"
                                                                ElementStyle="{StaticResource CellText}" />
                                            <DataGridTextColumn Header="Model" Binding="{Binding MarkingModel}"
                                                                Width="*"
                                                                ElementStyle="{StaticResource CellText}" />
                                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}"
                                                                Width="120" ui:TableLayout.Priority="1" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="This correction has a single attempt."
                                               Style="{StaticResource CardSubtitle}" Margin="0,8,0,0"
                                               Visibility="{Binding HasVersions, Converter={StaticResource InverseBoolToVis}}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource EmptyState}" VerticalAlignment="Top"
                        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Choose a correction" Style="{StaticResource EmptyTitle}" />
                        <TextBlock Text="Select a row to inspect its marks, its attempts and the export options."
                                   Style="{StaticResource EmptyText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ui:PageFrame>
</UserControl>

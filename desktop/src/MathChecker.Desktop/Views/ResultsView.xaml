<UserControl x:Class="MathChecker.Desktop.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="{Binding Summary}"
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,18,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Open paper" Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenDeskCommand}" />
                <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" />
                <Button Content="CSV" Command="{Binding ExportCsvCommand}" />
                <Button Content="Markdown" Command="{Binding ExportMarkdownCommand}" Margin="0" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource FilterBar}">
                <WrapPanel>
                    <TextBox Width="240" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search results" />
                    <Button Content="Apply" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}"
                            Height="38" Padding="16,7" />
                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}" Margin="12,0,6,0" />
                    <ComboBox Width="150" ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding StatusFilter}" />
                    <Border Style="{StaticResource Chip}" Padding="9,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Items.Count, StringFormat={}{0} rows}"
                                   FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </WrapPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.35*" MinWidth="200" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.3*" MinWidth="190" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TableCard}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                            <TextBlock Text="Corrections" Style="{StaticResource RowTitle}" />
                        </Border>

                        <Grid>
                            <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="1" ItemsSource="{Binding Items}"
                                      SelectedItem="{Binding Selected}"
                                      AutomationProperties.Name="Stored corrections">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Student" Binding="{Binding Name}" Width="118" />
                                    <DataGridTextColumn Header="Assignment" Binding="{Binding AssignmentTitle}"
                                                        Width="*" MinWidth="150" />
                                    <DataGridTextColumn Header="Score" Binding="{Binding ScoreText}" Width="64" />
                                    <DataGridTextColumn Header="%" Binding="{Binding PercentageText}" Width="54"
                                                        ui:TableLayout.Priority="2" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="96"
                                                        ui:TableLayout.Priority="1" />
                                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" Width="112"
                                                        ui:TableLayout.Priority="2" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Style="{StaticResource EmptyState}" MaxWidth="340"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="No corrections match" Style="{StaticResource EmptyTitle}" />
                                    <TextBlock Text="Clear the search or choose another status to see stored results."
                                               Style="{StaticResource EmptyText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="SELECTED CORRECTION" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding DetailHeader}" Style="{StaticResource CardTitle}"
                                       FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"
                                       TextTrimming="None" />
                            <TextBlock Text="{Binding DetailNote}" Style="{StaticResource CardSubtitle}"
                                       Margin="0,6,0,0" />

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Re-mark with AI" Command="{Binding RemarkCommand}"
                                        Height="30" Padding="10,3" IsEnabled="{Binding HasDetail}" />
                                <Button Content="Use new attempt" Command="{Binding AcceptRemarkCommand}"
                                        Height="30" Padding="10,3" IsEnabled="{Binding HasDetail}" />
                                <Button Content="Restore attempt" Command="{Binding RestoreLatestVersionCommand}"
                                        Height="30" Padding="10,3" IsEnabled="{Binding HasDetail}" />
                                <Button Content="Override mark…" Command="{Binding OverrideCommand}"
                                        Height="30" Padding="10,3" IsEnabled="{Binding HasDetail}" />
                                <Button Content="Set question mark…" Command="{Binding SetQuestionMarkCommand}"
                                        Height="30" Padding="10,3" Margin="0" IsEnabled="{Binding HasDetail}" />
                            </WrapPanel>

                            <TextBlock Text="Questions" Style="{StaticResource SectionTitle}" />
                            <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="3" ItemsSource="{Binding Questions}"
                                      SelectedItem="{Binding SelectedQuestion}" Height="190"
                                      AutomationProperties.Name="Questions">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Q" Binding="{Binding NumberText}" Width="52" />
                                    <DataGridTextColumn Header="Mark" Binding="{Binding MarkText}" Width="72" />
                                    <DataGridTextColumn Header="Topic" Binding="{Binding Topic}" Width="130"
                                                        ui:TableLayout.Priority="2" />
                                    <DataGridTextColumn Header="Loss reason" Binding="{Binding LossReason}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No per-question breakdown was stored for this correction."
                                       Style="{StaticResource CardSubtitle}" Margin="0,8,0,0"
                                       Visibility="{Binding HasQuestions, Converter={StaticResource InverseBoolToVis}}" />

                            <TextBlock Text="Attempts" Style="{StaticResource SectionTitle}" />
                            <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="3" ItemsSource="{Binding Versions}"
                                      Height="140" AutomationProperties.Name="Attempts">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Version}" Width="46" />
                                    <DataGridTextColumn Header="Score" Binding="{Binding ScoreText}" Width="84" />
                                    <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="112"
                                                        ui:TableLayout.Priority="2" />
                                    <DataGridTextColumn Header="Model" Binding="{Binding MarkingModel}" Width="*" />
                                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" Width="120"
                                                        ui:TableLayout.Priority="1" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="This correction has a single attempt."
                                       Style="{StaticResource CardSubtitle}" Margin="0,8,0,0"
                                       Visibility="{Binding HasVersions, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource EmptyState}" VerticalAlignment="Top"
                        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Choose a correction" Style="{StaticResource EmptyTitle}" />
                        <TextBlock Text="Select a row to inspect its marks, attempts and export options."
                                   Style="{StaticResource EmptyText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ui:PageFrame>
</UserControl>
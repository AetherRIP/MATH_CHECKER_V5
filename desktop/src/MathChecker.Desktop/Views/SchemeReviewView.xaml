<UserControl x:Class="MathChecker.Desktop.Views.SchemeReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}" Description="{Binding Summary}"
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,18,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <!-- Staging and recording a decision read the selected discrepancy;
                     approve and reject read the selected proposal. -->
                <Button Content="Stage correction" Command="{Binding ProposeCommand}"
                        IsEnabled="{Binding HasDiscrepancy}" ToolTip="Select a discrepancy row first" />
                <Button Content="Record decision…" Command="{Binding DecideCommand}"
                        IsEnabled="{Binding HasDiscrepancy}" ToolTip="Select a discrepancy row first" />
                <Button Content="Approve proposal" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ApproveProposalCommand}"
                        IsEnabled="{Binding HasProposal}" ToolTip="Select a staged proposal first" />
                <Button Content="Reject proposal" Command="{Binding RejectProposalCommand}" Margin="0"
                        IsEnabled="{Binding HasProposal}" ToolTip="Select a staged proposal first" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <Border Style="{StaticResource TableCard}" Height="320">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource WarningChip}" Padding="9,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Discrepancies.Count, StringFormat={}{0} open}"
                                           FontSize="10.5" Foreground="{DynamicResource WarningTextBrush}" />
                            </Border>
                            <TextBlock Text="Discrepancies" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Grid>
                        <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="3" ItemsSource="{Binding Discrepancies}"
                                  SelectedItem="{Binding SelectedDiscrepancy}"
                                  AutomationProperties.Name="Discrepancies">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Question" Binding="{Binding Question}" Width="84" />
                                <DataGridTextColumn Header="Assignment" Binding="{Binding Assignment}" Width="200" />
                                <DataGridTextColumn Header="Student" Binding="{Binding Student}" Width="140"
                                                    ui:TableLayout.Priority="2" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"
                                                    ui:TableLayout.Priority="1" />
                                <DataGridTextColumn Header="Finding" Binding="{Binding Detail}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="No discrepancies are open." Style="{StaticResource EmptyText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Discrepancies.Count, Converter={StaticResource ZeroToVis}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource TableCard}" Margin="0,12,0,0" Height="200">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                        <TextBlock Text="Staged proposals" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                    </Border>
                    <Grid>
                        <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="3" ItemsSource="{Binding Proposals}"
                                  SelectedItem="{Binding SelectedProposal}"
                                  AutomationProperties.Name="Staged proposals">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Question" Binding="{Binding Question}" Width="84" />
                                <DataGridTextColumn Header="Assignment" Binding="{Binding Assignment}" Width="200" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"
                                                    ui:TableLayout.Priority="1" />
                                <DataGridTextColumn Header="What changes" Binding="{Binding Detail}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Nothing is staged." Style="{StaticResource EmptyText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Proposals.Count, Converter={StaticResource ZeroToVis}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="DISCREPANCY RECORD" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="A staged proposal changes nothing until it is explicitly approved. The backend records every decision."
                               Style="{StaticResource CardSubtitle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailNote}" FontSize="12.5" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                               Visibility="{Binding HasDetailNote, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding DetailFacts}" Margin="0,8,0,0"
                                  ItemTemplate="{StaticResource FactRowTemplate}"
                                  Visibility="{Binding HasDetailFacts, Converter={StaticResource BoolToVis}}" />
                    <Expander Header="Technical details" Margin="0,12,0,0"
                              Visibility="{Binding HasDetailRaw, Converter={StaticResource BoolToVis}}">
                        <TextBox Style="{StaticResource JsonBox}" Text="{Binding DetailRaw, Mode=OneWay}"
                                 Margin="0,4,0,0" MinHeight="120" MaxHeight="260" />
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </ui:PageFrame>
</UserControl>
<UserControl x:Class="MathChecker.Desktop.Views.SchemeReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}" Description="{Binding Summary}"
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,18,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Stage correction" Command="{Binding ProposeCommand}" />
                <Button Content="Record decision…" Command="{Binding DecideCommand}" />
                <Button Content="Approve proposal" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ApproveProposalCommand}" />
                <Button Content="Reject proposal" Command="{Binding RejectProposalCommand}" Margin="0" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <Border Style="{StaticResource TableCard}" Height="320">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                        <DockPanel>
                            <TextBlock Text="Discrepancies" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" Style="{StaticResource WarningChip}" Padding="9,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Discrepancies.Count, StringFormat={}{0} open}"
                                           FontSize="10.5" Foreground="{StaticResource WarningTextBrush}" />
                            </Border>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="3" ItemsSource="{Binding Discrepancies}"
                                  SelectedItem="{Binding SelectedDiscrepancy}"
                                  AutomationProperties.Name="Discrepancies">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="170" />
                                <DataGridTextColumn Header="Question" Binding="{Binding Title}" Width="200" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"
                                                    ui:TableLayout.Priority="1" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="No discrepancies are open." Style="{StaticResource EmptyText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Discrepancies.Count, Converter={StaticResource ZeroToVis}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource TableCard}" Margin="0,12,0,0" Height="200">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                        <TextBlock Text="Staged proposals" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                    </Border>
                    <Grid>
                        <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="3" ItemsSource="{Binding Proposals}"
                                  SelectedItem="{Binding SelectedProposal}"
                                  AutomationProperties.Name="Staged proposals">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="170" />
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="200" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"
                                                    ui:TableLayout.Priority="1" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Nothing is staged." Style="{StaticResource EmptyText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Proposals.Count, Converter={StaticResource ZeroToVis}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Height="160" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="A staged proposal changes nothing until it is explicitly approved. The backend records every decision."
                               Style="{StaticResource CardSubtitle}" Margin="2,0,0,6" />
                    <TextBox Style="{StaticResource JsonBox}" Text="{Binding DetailText, Mode=OneWay}" Margin="0" />
                </DockPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </ui:PageFrame>
</UserControl>
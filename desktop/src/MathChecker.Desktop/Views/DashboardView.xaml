<UserControl x:Class="MathChecker.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI"
             Background="Transparent">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="What the desk has marked, what is still moving, and what needs a decision."
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  Sync="{Binding SyncService}"
                  BodyPadding="0,16,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Review queue" Command="{Binding OpenReviewCommand}"
                        Margin="0,0,8,0" />
                <Button Content="New correction" Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenCorrectionCommand}" Margin="0,0,8,0" />
                <Button Content="More" Style="{StaticResource GhostButton}"
                        ui:ClickMenu.OpenOnClick="True"
                        AutomationProperties.Name="More dashboard actions">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" />
                            <MenuItem Header="All jobs" Command="{Binding OpenJobsCommand}" />
                            <MenuItem Header="AI keys" Command="{Binding OpenAiKeysCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </ui:PageFrame.Actions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================================================
                 The one ink panel: the backlog, its figure, and the single
                 action that clears it. The readout beside it carries the three
                 facts the number itself does not state, separated by the rule
                 that divides reading from acting.
                 ============================================================ -->
            <Border CornerRadius="{StaticResource PanelRadius}"
                    Background="{DynamicResource HeroBrush}"
                    BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1"
                    Padding="24,20" Margin="0,0,0,16"
                    Effect="{DynamicResource CardShadowEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="3" Height="12" CornerRadius="1.5" Margin="0,0,9,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Today's desk" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource HeroMutedBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding PendingText}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="44" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource HeroInkBrush}" />
                            <!-- Pending counts queued jobs AND allow-listed papers
                                 that have no correction yet, so it is a backlog,
                                 not running work. -->
                            <TextBlock Text="papers awaiting correction" FontSize="14.5" FontWeight="Medium"
                                       Foreground="{DynamicResource HeroInkBrush}"
                                       VerticalAlignment="Bottom" Margin="9,0,0,7" />
                        </StackPanel>
                        <TextBlock Text="{Binding TodayText, StringFormat={}{0} corrected today}"
                                   FontSize="12.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource HeroMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- The rule that separates reading from acting. -->
                    <Border Grid.Column="1" Width="1" Margin="24,2,24,2"
                            Background="{DynamicResource AccentLineBrush}" />

                    <!-- The readout: only what the figure above does not say. -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="196">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CompletedText}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource HeroInkBrush}" />
                            <TextBlock Grid.Column="1" Text="Completed, all time"
                                       FontSize="11.5" Margin="12,0,0,0"
                                       Foreground="{DynamicResource HeroMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FailedText}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource HeroInkBrush}" />
                            <TextBlock Grid.Column="1" Text="Failed, need a retry"
                                       FontSize="11.5" Margin="12,0,0,0"
                                       Foreground="{DynamicResource HeroMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ProcessingText}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource HeroInkBrush}" />
                            <TextBlock Grid.Column="1" Text="Processing now"
                                       FontSize="11.5" Margin="12,0,0,0"
                                       Foreground="{DynamicResource HeroMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <Button Grid.Column="3" Content="Open queue"
                            Style="{StaticResource HeroActionButton}"
                            Command="{Binding OpenJobsCommand}"
                            VerticalAlignment="Center" Margin="24,0,0,0" />
                </Grid>
            </Border>

            <!-- ============================================================
                 Body: the ledger beside the facts that need a decision.
                 ============================================================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="320" MinWidth="260" MaxWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- Recent jobs: the one table on the landing screen. -->
                <Border Grid.Column="0" Style="{StaticResource TableCard}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="All jobs"
                                        Style="{StaticResource GhostButton}" Height="28" Padding="10,3"
                                        Margin="0"
                                        Command="{Binding OpenJobsCommand}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="Recent jobs" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="The newest corrections and where they stopped."
                                               Style="{StaticResource CardSubtitle}" Margin="0,1,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Padding="12,8"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
                            <DockPanel>
                                <TextBlock Text="{Binding LastUpdated, StringFormat=Updated {0}}"
                                           Style="{StaticResource CardSubtitle}" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <!-- Both act on the selected row only. Disabled until one
                                         is picked, so neither looks like it did something. -->
                                    <Button Content="Cancel job" Style="{StaticResource GhostButton}"
                                            Height="28" Padding="10,3" Margin="0,0,6,0"
                                            Command="{Binding CancelSelectedJobCommand}"
                                            IsEnabled="{Binding HasSelectedJob}"
                                            ToolTip="Select a job row first" />
                                    <Button Content="Retry job" Style="{StaticResource GhostButton}"
                                            Height="28" Padding="10,3" Margin="0"
                                            Command="{Binding RetrySelectedJobCommand}"
                                            IsEnabled="{Binding HasSelectedJob}"
                                            ToolTip="Select a job row first" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="1"
                                      ItemsSource="{Binding RecentJobs}"
                                      SelectedItem="{Binding SelectedJob}"
                                      AutomationProperties.Name="Recent jobs">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Student" Binding="{Binding StudentName}"
                                                        Width="132" ElementStyle="{StaticResource CellText}" />
                                    <!-- One stage column, not a status beside a stage that
                                         repeats it: PhaseText says what the pipeline is
                                         doing in words a person reads. -->
                                    <DataGridTextColumn Header="Stage" Binding="{Binding PhaseText}"
                                                        Width="*" MinWidth="160"
                                                        ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Attempt" Binding="{Binding Attempts}"
                                                        Width="72" ui:TableLayout.Priority="2"
                                                        HeaderStyle="{StaticResource NumberHeader}"
                                                        ElementStyle="{StaticResource CellNumber}" />
                                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}"
                                                        Width="128" ui:TableLayout.Priority="1"
                                                        ElementStyle="{StaticResource CellText}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="No corrections yet. Start one from the header."
                                       Style="{StaticResource EmptyText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasRecentJobs, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <StackPanel>

                        <!-- Needs attention: one severity per row, no decoration. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <!-- Docked first so the ghost button keeps its own
                                         width instead of becoming the whole row's hit area. -->
                                    <Button DockPanel.Dock="Right" Content="Review"
                                            Style="{StaticResource GhostButton}" Height="26" Padding="9,2"
                                            Margin="0" FontSize="11.5"
                                            Command="{Binding OpenReviewCommand}" VerticalAlignment="Center" />
                                    <TextBlock Text="Needs attention" Style="{StaticResource CardTitle}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding AttentionSummary}" Style="{StaticResource CardSubtitle}"
                                           Margin="0,2,0,0" />

                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                              Margin="0,8,0,0"
                                              Visibility="{Binding HasAttention, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding AttentionItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource RowHairlineBrush}"
                                                        BorderThickness="0,0,0,1" Padding="0,8">
                                                    <StackPanel>
                                                        <!-- Wrapped: a middle-dot string is not a
                                                             reason to lose the class and paper
                                                             names at desktop width. -->
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="13" FontWeight="Medium"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <!-- Wrapped, not ellipsised: the detail is
                                                             the part that says how to fix it. -->
                                                        <TextBlock Text="{Binding Detail}"
                                                                   FontSize="11.5" Margin="0,2,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="Nothing needs attention."
                                           Style="{StaticResource EmptyText}" FontSize="11.5"
                                           Margin="0,10,0,2"
                                           Visibility="{Binding HasAttention, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- System: the quiet facts behind the buttons. -->
                        <Border Style="{StaticResource Card}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="System" Style="{StaticResource SectionLabel}" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="AI keys" Style="{StaticResource CardSubtitle}"
                                               VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{Binding ApiHealthText}" FontSize="11.5"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                               Margin="12,0,0,0" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Classroom" Style="{StaticResource CardSubtitle}"
                                               VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{Binding ClassroomText}" FontSize="11.5"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                               Margin="12,0,0,0" />
                                </Grid>
                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource CardSubtitle}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,10,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="AI &amp; keys" Style="{StaticResource GhostButton}"
                                            Command="{Binding OpenAiKeysCommand}" Padding="8,2" Height="26"
                                            FontSize="11.5" />
                                    <Button Content="Job history" Style="{StaticResource GhostButton}"
                                            Command="{Binding OpenJobsCommand}" Padding="8,2" Height="26"
                                            FontSize="11.5" Margin="0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </ui:PageFrame>
</UserControl>

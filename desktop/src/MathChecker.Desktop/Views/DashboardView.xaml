<UserControl x:Class="MathChecker.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI"
             Background="Transparent">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="What the desk has marked, what is still moving, and what needs a decision."
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  Sync="{Binding SyncService}"
                  BodyPadding="0,14,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="New correction" Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenCorrectionCommand}" />
                <Button Content="Review queue" Command="{Binding OpenReviewCommand}" Margin="0" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <!-- The one hero card, echoing the reference's coloured
                 "continue" surface: what is moving right now, and the
                 shortcut to it. Everything in it is live state. -->
            <Border CornerRadius="{StaticResource PanelRadius}"
                    Background="{DynamicResource HeroBrush}"
                    Padding="24,20" Margin="0,0,0,12"
                    Effect="{DynamicResource CardShadowEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TODAY'S DESK" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource HeroMutedBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding PendingText}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="32" FontWeight="Bold"
                                       Foreground="{DynamicResource HeroInkBrush}" />
                            <!-- Pending counts queued jobs AND allow-listed papers
                                 that have no correction yet, so it is a backlog,
                                 not running work (it read "69 in flight" beside
                                 "0 in progress" after a result reset). -->
                            <TextBlock Text="papers awaiting correction" FontSize="14.5" FontWeight="Medium"
                                       Foreground="{DynamicResource HeroInkBrush}"
                                       VerticalAlignment="Bottom" Margin="8,0,0,6" />
                        </StackPanel>
                        <TextBlock Text="{Binding TodayCaption}" FontSize="12.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource HeroMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open queue"
                            Style="{StaticResource HeroActionButton}"
                            Command="{Binding OpenJobsCommand}"
                            VerticalAlignment="Center" Margin="20,0,0,0" />
                </Grid>
            </Border>

            <!-- Metric strip: the day at a glance, in one row of numbers. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatTile}" Margin="0,0,10,0"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentLineBrush}">
                    <StackPanel>
                        <TextBlock Text="TODAY" Style="{StaticResource SectionLabel}"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding TodayFigure}" Style="{StaticResource DisplayFigure}"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{Binding TodayCaption}" Style="{StaticResource CardSubtitle}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatTile}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="COMPLETED" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding CompletedText}" Style="{StaticResource DisplayFigure}"
                                   Margin="0,2,0,0" />
                        <!-- The figure is the all-time COMPLETED job count; only the
                             TODAY tile is scoped to today, so this must not say
                             "finished today" (it showed 3 beside a TODAY of 0). -->
                        <TextBlock Text="All time" Style="{StaticResource CardSubtitle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatTile}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="AWAITING" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding PendingText}" Style="{StaticResource DisplayFigure}"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{Binding ProcessingText, StringFormat={}{0} processing now}"
                                   Style="{StaticResource CardSubtitle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource StatTile}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="FAILED" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding FailedText}" Style="{StaticResource DisplayFigure}"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                        <TextBlock Text="Need a retry" Style="{StaticResource CardSubtitle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,12,0,0" MinHeight="320">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.9*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <!-- Recent jobs: the one table on the landing screen. -->
                <Border Grid.Column="0" Style="{StaticResource TableCard}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="All jobs"
                                        Style="{StaticResource GhostButton}" Height="26" Padding="9,2"
                                        Margin="0"
                                        Command="{Binding OpenJobsCommand}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="Recent jobs" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="The newest corrections and where they stopped."
                                               Style="{StaticResource CardSubtitle}" Margin="0,1,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Padding="12,6"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
                            <DockPanel>
                                <TextBlock Text="{Binding LastUpdated, StringFormat=Updated {0}}"
                                           Style="{StaticResource CardSubtitle}" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <!-- Both act on the selected row only. Disabled until one
                                         is picked, so neither looks like it did something. -->
                                    <Button Content="Cancel job" Style="{StaticResource GhostButton}"
                                            Height="26" Padding="9,2" Margin="0,0,6,0"
                                            Command="{Binding CancelSelectedJobCommand}"
                                            IsEnabled="{Binding HasSelectedJob}"
                                            ToolTip="Select a job row first" />
                                    <Button Content="Retry job" Style="{StaticResource GhostButton}"
                                            Height="26" Padding="9,2" Margin="0"
                                            Command="{Binding RetrySelectedJobCommand}"
                                            IsEnabled="{Binding HasSelectedJob}"
                                            ToolTip="Select a job row first" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="2" ItemsSource="{Binding RecentJobs}"
                                      SelectedItem="{Binding SelectedJob}"
                                      AutomationProperties.Name="Recent jobs">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="132"  ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="94"  ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Stage" Binding="{Binding StageText}" Width="*" MinWidth="120"  ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Attempt" Binding="{Binding Attempts}" Width="68"
                                                        ui:TableLayout.Priority="2"  ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" Width="124"
                                                        ui:TableLayout.Priority="1"  ElementStyle="{StaticResource CellText}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="No corrections yet. Start one from the header."
                                       Style="{StaticResource EmptyText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasRecentJobs, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Column="2">

                    <!-- Needs attention: one severity per row, no decoration. -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel>
                                <!-- Docked first so the ghost button keeps its own
                                     width instead of becoming the whole row's hit area. -->
                                <Button DockPanel.Dock="Right" Content="Review"
                                        Style="{StaticResource GhostButton}" Height="24" Padding="8,2"
                                        Margin="0" FontSize="11"
                                        Command="{Binding OpenReviewCommand}" VerticalAlignment="Center" />
                                <TextBlock Text="Needs attention" Style="{StaticResource CardTitle}" />
                            </DockPanel>
                            <TextBlock Text="{Binding AttentionSummary}" Style="{StaticResource CardSubtitle}"
                                       Margin="0,1,0,0" />

                            <ScrollViewer MaxHeight="176" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                                          Visibility="{Binding HasAttention, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding AttentionItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource RowHairlineBrush}"
                                                    BorderThickness="0,0,0,1" Padding="0,7">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource RowDetail}"
                                                               Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="Nothing needs attention."
                                       Style="{StaticResource EmptyText}" FontSize="11.5" Margin="0,10,0,2"
                                       Visibility="{Binding HasAttention, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- System: the quiet facts behind the buttons. -->
                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="SYSTEM" Style="{StaticResource SectionLabel}" />
                            <!-- A two-column grid, not a DockPanel: a right-docked
                                 last child used to overlap the label and clip the
                                 start of the value ("Classroom1 as …"). -->
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="AI keys" Style="{StaticResource CardSubtitle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ApiHealthText}" FontSize="11.5"
                                           Foreground="{DynamicResource TextBrush}" TextWrapping="NoWrap"
                                           TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                           Margin="12,0,0,0" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Classroom" Style="{StaticResource CardSubtitle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ClassroomText}" FontSize="11.5"
                                           Foreground="{DynamicResource TextBrush}" TextWrapping="NoWrap"
                                           TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                           Margin="12,0,0,0"
                                           ToolTip="{Binding ClassroomText}" />
                            </Grid>
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource CardSubtitle}"
                                       Margin="0,6,0,0" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding VersionText}" />
                            <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,8,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="AI &amp; keys" Style="{StaticResource GhostButton}"
                                        Command="{Binding OpenAiKeysCommand}" Padding="8,2" Height="24"
                                        FontSize="11" />
                                <Button Content="Job history" Style="{StaticResource GhostButton}"
                                        Command="{Binding OpenJobsCommand}" Padding="8,2" Height="24"
                                        FontSize="11" Margin="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </ui:PageFrame>
</UserControl>

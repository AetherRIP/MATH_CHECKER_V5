<UserControl x:Class="MathChecker.Desktop.Views.ClassroomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ProblemText}" Style="{StaticResource WarningText}" />
                <TextBlock Text="{Binding LastSyncText, StringFormat=Last sync: {0}}" Style="{StaticResource Muted}" />
            </StackPanel>
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Connect" Command="{Binding ConnectCommand}" />
                <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                <Button Content="Sync now" Command="{Binding SyncCommand}" />
                <Button Content="Open Classroom" Command="{Binding OpenExternalCommand}" />
            </WrapPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Course" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="300" ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Assignment" Style="{StaticResource FieldLabel}" />
                <ComboBox Width="320" ItemsSource="{Binding Assignments}" SelectedItem="{Binding SelectedAssignment}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TitleText}" TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,6,0,0">
            <Button Content="Correct selected submission" Command="{Binding CorrectSelectedCommand}" />
            <Button Content="Correct whole assignment" Command="{Binding CorrectAllCommand}" />
            <Button Content="Allow-list assignment" Command="{Binding ToggleAllowlistCommand}" />
            <Button Content="Upload mark scheme…" Command="{Binding UploadMarkSchemeCommand}" />
            <Button Content="Push draft grades" Command="{Binding PushGradesCommand}" />
        </WrapPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Submissions}" SelectedItem="{Binding SelectedSubmission}"
                  Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Student" Binding="{Binding TitleText}" Width="220" />
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="180" />
                <DataGridTextColumn Header="Grade" Binding="{Binding GradeText}" Width="90" />
                <DataGridTextColumn Header="Submission id" Binding="{Binding Id}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Last backend response" Style="{StaticResource SectionTitle}"
                           Margin="0,0,0,2" />
                <TextBox Style="{StaticResource JsonBox}" Text="{Binding DetailText, Mode=OneWay}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

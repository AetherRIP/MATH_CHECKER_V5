<UserControl x:Class="MathChecker.Desktop.Views.ClassroomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="Courses, assignments and submissions read straight from Google Classroom."
                  StatusText="{Binding SyncDetail}"
                  ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  Sync="{Binding SyncService}"
                  BodyPadding="0,16,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <!-- Sync is the frame's shared header control: the same one
                     Classes, Students, Assignments and Today use. -->
                <Button Content="Connect Google" Command="{Binding ConnectCommand}" Margin="0"
                        Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}"
                        ToolTip="Sign in with the Google account that owns the classes" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The chosen course and assignment stay visible on every tab: the
                 actions below must always name their target. -->
            <Border Grid.Row="0" Style="{StaticResource FilterBar}">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="Course" Style="{StaticResource FieldLabel}" />
                        <Grid Width="300">
                            <ComboBox ItemsSource="{Binding Courses}"
                                      SelectedItem="{Binding SelectedCourse}"
                                      IsEnabled="{Binding IsConnected}"
                                      ToolTip="Connect Classroom to load the courses">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Choose a course" FontSize="12.5" Margin="11,0,28,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="NoWrap"
                                       Visibility="{Binding SelectedCourse, Converter={StaticResource EmptyToVisibility}}" />
                        </Grid>
                        <TextBlock Text="Assignment" Style="{StaticResource FieldLabel}" Margin="12,0,6,0" />
                        <Grid Width="330">
                            <ComboBox ItemsSource="{Binding Assignments}"
                                      SelectedItem="{Binding SelectedAssignment}"
                                      IsEnabled="{Binding HasCourse}"
                                      ToolTip="Choose a course first">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TitleText}" TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Choose an assignment" FontSize="12.5" Margin="11,0,28,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="NoWrap"
                                       Visibility="{Binding SelectedAssignment, Converter={StaticResource EmptyToVisibility}}" />
                        </Grid>
                        <Border Style="{StaticResource Chip}" Padding="9,3" Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SubmissionsSummary}" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="NoWrap" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="Connect Google Classroom first: courses and assignments are read from the account, never invented."
                               Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}" />
                    <TextBlock Text="{Binding AssignmentMetaText}" Style="{StaticResource Muted}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <ListBox Grid.Row="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                     Style="{StaticResource SpaceTabs}" Margin="0,0,0,14"
                     AutomationProperties.Name="Classroom sections" />

            <Grid Grid.Row="2">

                <!-- ================================================== connection -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"
                              Visibility="{Binding ShowConnection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>

                        <Border Background="{DynamicResource HeroBrush}"
                                CornerRadius="{StaticResource PanelRadius}" Padding="24,22"
                                Effect="{DynamicResource CardShadowEffect}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="GOOGLE ACCOUNT" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource HeroMutedBrush}"
                                               TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding StateTitle}" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="32" FontWeight="Bold" Margin="0,4,0,0"
                                               Foreground="{DynamicResource HeroInkBrush}" TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding StateDetail}" FontSize="13" Margin="0,4,0,0"
                                               Foreground="{DynamicResource HeroMutedBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ConnectedSinceText}" FontSize="11.5" Margin="0,10,0,0"
                                               Foreground="{DynamicResource HeroMutedBrush}" TextWrapping="NoWrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="20,0,0,0">
                                    <Button Content="Connect Google" Style="{StaticResource HeroActionButton}"
                                            Command="{Binding ConnectCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Open in Classroom" Style="{StaticResource HeroGhostButton}"
                                            Command="{Binding OpenExternalCommand}" Margin="0,0,8,0"
                                            IsEnabled="{Binding CanOpenClassroom}"
                                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Open the chosen course in the browser" />
                                    <Button Content="Disconnect" Style="{StaticResource HeroGhostButton}"
                                            Command="{Binding DisconnectCommand}" Margin="0"
                                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,12"
                                Visibility="{Binding ProblemText, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding ProblemText}" FontSize="12"
                                       Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="SYNC" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="Pull courses, coursework and submissions from Google again."
                                               Style="{StaticResource CardSubtitle}" Margin="0,6,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SyncDetail}" FontSize="11.5" Margin="0,10,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="NoWrap" />

                                    <!-- Live state of the real backend run: the
                                         stage it is in, its own percentage, and
                                         the final summary with any problems. -->
                                    <ProgressBar Height="4" Margin="0,12,0,0"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding SyncService.Percent, Mode=OneWay}"
                                                 IsIndeterminate="{Binding SyncService.IsIndeterminate, Mode=OneWay}"
                                                 AutomationProperties.Name="Synchronization progress"
                                                 Visibility="{Binding SyncService.ShowProgress, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding SyncService.StatusText}" FontSize="11.5"
                                               Margin="0,8,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding SyncService.HasState, Converter={StaticResource BoolToVis}}"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <!-- Only when it adds something: the failure reason
                                         or the failed parts. A clean run already reads
                                         clearly on the line above. -->
                                    <TextBlock Text="{Binding SyncService.DetailText}" FontSize="11"
                                               Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Visibility="{Binding SyncService.HasProblems, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Sync now" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding SyncCommand}" HorizontalAlignment="Left"
                                            Margin="0,12,0,0" />
                                    <Button Content="Retry failed parts" Command="{Binding SyncService.RetryFailedCommand}"
                                            HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Visibility="{Binding SyncService.CanRetry, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Re-sync only the parts that failed" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="WHAT CLASSROOM OWNS" Style="{StaticResource SectionLabel}" />
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="Courses" Style="{StaticResource CardSubtitle}" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   Text="{Binding CourseCountText}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextBrush}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock Text="Assignments" Style="{StaticResource CardSubtitle}" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   Text="{Binding AssignmentCountText}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextBrush}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock Text="Draft write-back" Style="{StaticResource CardSubtitle}" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   Text="{Binding WriteBackLabel}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextBrush}" />
                                    </DockPanel>
                                    <TextBlock Text="Identity and submission states come from Google. Marks stay local until you push them."
                                               Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="LAST RESPONSE" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding DetailNote}" Style="{StaticResource CardSubtitle}"
                                           Margin="0,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding DetailFacts}" Margin="0,8,0,0"
                                              ItemTemplate="{StaticResource FactRowTemplate}"
                                              Visibility="{Binding DetailFacts.Count, Converter={StaticResource NonZeroToVis}}" />
                                <Expander Header="Technical details" Margin="0,12,0,0"
                                          Visibility="{Binding HasDetailRaw, Converter={StaticResource BoolToVis}}">
                                    <TextBox Style="{StaticResource JsonBox}" Text="{Binding DetailRaw, Mode=OneWay}"
                                             Margin="0,4,0,0" MinHeight="110" MaxHeight="240" />
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================================================= assignments -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"
                              Visibility="{Binding ShowAssignments, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="TARGET" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding SelectedAssignmentText}"
                                               FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                               FontWeight="SemiBold" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding AssignmentMetaText}" Style="{StaticResource CardSubtitle}"
                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedCourseText}" FontSize="11.5"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Allow-list assignment" Command="{Binding ToggleAllowlistCommand}"
                                                IsEnabled="{Binding HasAssignmentTarget}"
                                                ToolTip="Let automatic corrections pick this assignment up" />
                                        <Button Content="Correct whole assignment" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding CorrectAllCommand}" Margin="0"
                                                IsEnabled="{Binding HasAssignmentTarget}"
                                                ToolTip="Queue every eligible paper in this assignment" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="MARK SCHEME" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="Every question is marked against the scheme attached to this assignment."
                                               Style="{StaticResource CardSubtitle}" Margin="0,6,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="Uploading replaces the previous scheme for the chosen assignment only."
                                               Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <Button Content="Upload mark scheme…" Command="{Binding UploadMarkSchemeCommand}"
                                            HorizontalAlignment="Left" Margin="0,12,0,0"
                                            IsEnabled="{Binding HasAssignmentTarget}"
                                            ToolTip="Attach the PDF used to mark this assignment" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="HOW A BULK CORRECTION RUNS" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="1.  Students who have not handed anything in are skipped."
                                           Style="{StaticResource CardSubtitle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="2.  Each paper is read against the uploaded mark scheme."
                                           Style="{StaticResource CardSubtitle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="3.  Results land in Results and Review; nothing is written to Google until you push grades."
                                           Style="{StaticResource CardSubtitle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================================================= submissions -->
                <Border Style="{StaticResource TableCard}"
                        Visibility="{Binding ShowSubmissions, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Correct selected submission"
                                        Style="{StaticResource PrimaryButton}" Margin="0"
                                        Command="{Binding CorrectSelectedCommand}"
                                        IsEnabled="{Binding HasSubmissionTarget}"
                                        ToolTip="Mark only the selected paper" />
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="9,3"
                                        Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SubmissionsSummary}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                                <TextBlock Text="Submissions" Style="{StaticResource RowTitle}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <Grid>
                            <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="3"
                                      ItemsSource="{Binding Submissions}"
                                      SelectedItem="{Binding SelectedSubmission}"
                                      AutomationProperties.Name="Classroom submissions">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Student" Binding="{Binding TitleText}" Width="220"
                                                        ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="180"
                                                        ElementStyle="{StaticResource CellText}"
                                                        ui:TableLayout.Priority="1" />
                                    <DataGridTextColumn Header="Grade" Binding="{Binding GradeText}" Width="90"
                                                        ElementStyle="{StaticResource CellText}"
                                                        ui:TableLayout.Priority="2" />
                                    <DataGridTextColumn Header="Timing" Binding="{Binding LateText}" Width="*"
                                                        ElementStyle="{StaticResource CellText}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Style="{StaticResource EmptyState}" MaxWidth="380"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Submissions.Count, Converter={StaticResource ZeroToVis}}">
                                <StackPanel>
                                    <TextBlock Text="No submissions loaded" Style="{StaticResource EmptyTitle}" />
                                    <TextBlock Text="Pick a course and assignment, then sync to pull Classroom work in."
                                               Style="{StaticResource EmptyText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- ====================================================== grades -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"
                              Visibility="{Binding ShowGrades, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="DRAFT GRADES" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="Write corrected marks back to Google Classroom"
                                           FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                           FontWeight="SemiBold" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedAssignmentText}" Style="{StaticResource CardSubtitle}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WriteBackText}" FontSize="12" Margin="0,12,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Push draft grades" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding PushGradesCommand}" Margin="0"
                                            IsEnabled="{Binding CanPushGrades}"
                                            ToolTip="Write corrected marks to Classroom as draft grades" />
                                    <Border Style="{StaticResource Chip}" Padding="9,3" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WriteBackLabel}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="WHAT THIS DOES" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="Each corrected paper keeps its mark; only the grade field in Classroom changes."
                                           Style="{StaticResource CardSubtitle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="Assignments are left as drafts — nothing is returned or published to students."
                                           Style="{StaticResource CardSubtitle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="Turn write-back on in Config → Settings. It stays off until you decide otherwise."
                                           Style="{StaticResource CardSubtitle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </ui:PageFrame>
</UserControl>

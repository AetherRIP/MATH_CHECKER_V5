<UserControl x:Class="MathChecker.Desktop.Views.ClassroomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}"
                  Description="{Binding StatusText}" StatusText="{Binding LastSyncText, StringFormat=Last sync: {0}}"
                  ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,18,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Connect" Command="{Binding ConnectCommand}" />
                <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                <Button Content="Sync now" Style="{StaticResource PrimaryButton}" Command="{Binding SyncCommand}" />
                <Button Content="Open Classroom" Command="{Binding OpenExternalCommand}" Margin="0" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <StackPanel>
                <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,12"
                        Visibility="{Binding ProblemText, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding ProblemText}" FontSize="12"
                               Foreground="{StaticResource WarningTextBrush}" TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SOURCE" Style="{StaticResource SectionLabel}" />
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="Course" Style="{StaticResource FieldLabel}" />
                            <ComboBox Width="300" ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Assignment" Style="{StaticResource FieldLabel}" Margin="10,0,6,0" />
                            <ComboBox Width="320" ItemsSource="{Binding Assignments}"
                                      SelectedItem="{Binding SelectedAssignment}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TitleText}" TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </WrapPanel>

                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Correct selected submission"
                                    Command="{Binding CorrectSelectedCommand}" Height="34" Padding="12,4" />
                            <Button Content="Correct whole assignment" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding CorrectAllCommand}" Height="34" Padding="14,4" />
                            <Button Content="Allow-list assignment" Command="{Binding ToggleAllowlistCommand}"
                                    Height="34" Padding="12,4" />
                            <Button Content="Upload mark scheme…" Command="{Binding UploadMarkSchemeCommand}"
                                    Height="34" Padding="12,4" />
                            <Button Content="Push draft grades" Command="{Binding PushGradesCommand}"
                                    Height="34" Padding="12,4" Margin="0" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource TableCard}" Height="330">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                        <DockPanel>
                            <TextBlock Text="Submissions" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="9,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Submissions.Count, StringFormat={}{0} submissions}"
                                           FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="3" ItemsSource="{Binding Submissions}"
                                  SelectedItem="{Binding SelectedSubmission}"
                                  AutomationProperties.Name="Classroom submissions">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Student" Binding="{Binding TitleText}" Width="200" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="180" />
                                <DataGridTextColumn Header="Grade" Binding="{Binding GradeText}" Width="90" />
                                <DataGridTextColumn Header="Submission id" Binding="{Binding Id}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Style="{StaticResource EmptyState}" MaxWidth="360"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Submissions.Count, Converter={StaticResource ZeroToVis}}">
                            <StackPanel>
                                <TextBlock Text="No submissions loaded" Style="{StaticResource EmptyTitle}" />
                                <TextBlock Text="Pick a course and assignment, then sync to pull Classroom work in."
                                           Style="{StaticResource EmptyText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Height="130" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LAST BACKEND RESPONSE" Style="{StaticResource SectionLabel}"
                               Margin="2,0,0,6" />
                    <TextBox Style="{StaticResource JsonBox}" Text="{Binding DetailText, Mode=OneWay}" Margin="0" />
                </DockPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </ui:PageFrame>
</UserControl>
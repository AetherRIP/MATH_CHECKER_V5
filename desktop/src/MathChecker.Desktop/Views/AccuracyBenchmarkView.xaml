<UserControl x:Class="MathChecker.Desktop.Views.AccuracyBenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MathChecker.Desktop.Core.UI">
    <ui:PageFrame Eyebrow="{Binding Eyebrow}" Title="{Binding Title}" Description="{Binding Summary}"
                  StatusText="{Binding Status}" ErrorText="{Binding Error}" IsBusy="{Binding IsBusy}"
                  BodyPadding="0,18,0,0">
        <ui:PageFrame.Actions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="Refresh benchmark" />
                <Button Content="Recompute recorded run" Command="{Binding ReproduceCommand}"
                        IsEnabled="{Binding CanReproduce}" Margin="0"
                        ToolTip="Replays the latest run from its stored reference snapshot and raw outcomes. It contacts no provider."
                        AutomationProperties.Name="Recompute recorded benchmark run" />
            </StackPanel>
        </ui:PageFrame.Actions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- ========================================================
                     THE ONE RESULT THAT MUST NOT BE FABRICATED
                     ======================================================== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Certified accuracy" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding CertifiedHeadline}" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="28" FontWeight="Bold" Margin="0,7,0,0"
                                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                       AutomationProperties.Name="Certified accuracy headline" />
                            <TextBlock Text="{Binding CertifiedStatusText}" FontSize="13" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       MaxWidth="760" HorizontalAlignment="Left"
                                       AutomationProperties.Name="Certified accuracy status" />

                            <Border Style="{StaticResource WarningBanner}" Margin="0,12,0,0"
                                    Visibility="{Binding HasCertificationReason, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Why the score is not available"
                                               Style="{StaticResource SectionLabel}"
                                               Foreground="{DynamicResource WarningTextBrush}" />
                                    <TextBlock Text="{Binding CertificationReason}" Margin="0,4,0,0"
                                               FontSize="12" Foreground="{DynamicResource WarningTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Top">
                            <Border Style="{StaticResource Chip}" Padding="10,4" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding DatasetVersionText}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="{Binding DatasetReferenceCountText}" FontSize="11.5"
                                       Margin="0,8,0,0" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding DatasetShaText}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Verified / unverified / disputed / holdout / dataset size. -->
                <ui:ResponsiveGridPanel MinItemWidth="150" Gap="12" Margin="0,0,0,12">
                    <Border Style="{StaticResource StatTile}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Teacher verified" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding VerifiedCountText}" Style="{StaticResource DisplayFigure}"
                                       FontSize="30" Margin="0,6,0,0" Foreground="{DynamicResource SuccessTextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Unverified" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding UnverifiedCountText}" Style="{StaticResource DisplayFigure}"
                                       FontSize="30" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Disputed" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding DisputedCountText}" Style="{StaticResource DisplayFigure}"
                                       FontSize="30" Margin="0,6,0,0" Foreground="{DynamicResource DangerTextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Incomplete" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding IncompleteCountText}" Style="{StaticResource DisplayFigure}"
                                       FontSize="30" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Holdout items" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding HoldoutCountText}" Style="{StaticResource DisplayFigure}"
                                       FontSize="30" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </ui:ResponsiveGridPanel>

                <!-- Certified metrics are shown ONLY when the backend says the run
                     is certified against the current dataset and assessments. -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                        Visibility="{Binding ShowCertifiedMetrics, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Teacher-verified measurements" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding CertifiedSampleText}" FontSize="11.5" Margin="0,5,0,10"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                        <ui:ResponsiveGridPanel MinItemWidth="230" Gap="12">
                            <Border Style="{StaticResource Panel}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Item agreement" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding CertifiedItemsText}" FontSize="12" Margin="0,5,0,0"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Question agreement" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding CertifiedQuestionsText}" FontSize="12" Margin="0,5,0,0"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Subquestion agreement" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding CertifiedSubquestionsText}" FontSize="12" Margin="0,5,0,0"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Total-mark agreement" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding CertifiedTotalText}" FontSize="12" Margin="0,5,0,0"
                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Mean absolute error" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding CertifiedMaeText}" FontSize="12" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding CertifiedOverText}" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CertifiedUnderText}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Coverage and review" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding CertifiedCoverageText}" FontSize="12" Margin="0,5,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CertifiedReviewText}" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </ui:ResponsiveGridPanel>
                    </StackPanel>
                </Border>

                <!-- ========================================================
                     THE RUN AND THE DATASET
                     ======================================================== -->
                <ui:ResponsiveGridPanel MinItemWidth="330" Gap="12" Margin="0,0,0,12">
                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="9,2">
                                    <TextBlock Text="{Binding LatestRunStatus}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                                <TextBlock Text="Latest benchmark run" Style="{StaticResource SectionLabel}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding LatestRunId}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="13" Margin="0,9,0,0" TextWrapping="Wrap" />

                            <StackPanel Margin="0,10,0,0">
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="Model" Style="{StaticResource CardSubtitle}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LatestRunModel}" FontSize="12" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="Mode" Style="{StaticResource CardSubtitle}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LatestRunMode}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="Started" Style="{StaticResource CardSubtitle}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LatestRunStarted}" FontSize="12" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="Finished" Style="{StaticResource CardSubtitle}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LatestRunFinished}" FontSize="12" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="Dataset" Style="{StaticResource CardSubtitle}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LatestRunDataset}" FontSize="11.5"
                                               TextWrapping="Wrap" MaxWidth="280" TextAlignment="Right" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="Assessments" Style="{StaticResource CardSubtitle}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LatestRunVerification}" FontSize="11.5"
                                               TextWrapping="Wrap" MaxWidth="280" TextAlignment="Right" />
                                </DockPanel>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,11,0,10" />
                            <TextBlock Text="Reproducibility" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding LatestRunReproduction}" FontSize="12" Margin="0,5,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RunControlNote}" FontSize="11" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Reference dataset" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding DatasetCompositionText}" FontSize="12.5" Margin="0,7,0,0"
                                       TextWrapping="Wrap" />
                            <DockPanel Margin="0,7,0,0">
                                <TextBlock Text="Version" Style="{StaticResource CardSubtitle}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DatasetVersionText}" FontSize="12" />
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="SHA-256" Style="{StaticResource CardSubtitle}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DatasetShaText}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11" />
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="Partitions" Style="{StaticResource CardSubtitle}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DatasetPartitionsText}" FontSize="11.5"
                                           TextWrapping="Wrap" MaxWidth="270" TextAlignment="Right" />
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="Provenance" Style="{StaticResource CardSubtitle}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DatasetProvenanceText}" FontSize="11.5"
                                           TextWrapping="Wrap" MaxWidth="270" TextAlignment="Right" />
                            </DockPanel>

                            <TextBlock Text="{Binding RunsRootText}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="11" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextMutedBrush}" />

                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Dataset limitations" Style="{StaticResource SectionLabel}" />
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0">
                                    <ItemsControl ItemsSource="{Binding Warnings}"
                                                  AutomationProperties.Name="Dataset limitations">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Panel}" Margin="0,0,0,4" Padding="9,6">
                                                    <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource WarningTextBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ui:ResponsiveGridPanel>

                <!-- ========================================================
                     REFERENCES AND THE TEACHER VERIFICATION WORKFLOW
                     ======================================================== -->
                <ui:ResponsiveGridPanel MinItemWidth="380" Gap="12">
                    <Border Style="{StaticResource TableCard}" Margin="0" Height="650">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource TableToolbar}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="9,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding References.Count}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <TextBlock Text="Reference items" Style="{StaticResource RowTitle}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Grid>
                                <DataGrid Style="{StaticResource DataTable}" ui:TableLayout.FillColumn="1"
                                          ItemsSource="{Binding References}"
                                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                                          AutomationProperties.Name="Benchmark references">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Item" Binding="{Binding QuestionLabel}" Width="72" />
                                        <DataGridTextColumn Header="Paper" Binding="{Binding PaperId}" Width="*"
                                                            MinWidth="95" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="118" />
                                        <DataGridTextColumn Header="Teacher" Binding="{Binding TeacherMarkText}" Width="96"
                                                            ui:TableLayout.Priority="2" />
                                        <DataGridTextColumn Header="AI" Binding="{Binding AiMarkText}" Width="84"
                                                            ui:TableLayout.Priority="3" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Style="{StaticResource EmptyState}" MaxWidth="300"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasNoReferences, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="No references" Style="{StaticResource EmptyTitle}" />
                                        <TextBlock Text="The configured benchmark dataset returned no reference items."
                                                   Style="{StaticResource EmptyText}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0" MinHeight="650">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"
                                          Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedMention}" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding DetailPaper}" Style="{StaticResource CardTitle}"
                                               FontSize="20" Margin="0,7,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DetailIdentifiers}" FontSize="11.5" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DetailBoard}" FontSize="11.5" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />

                                    <WrapPanel Margin="0,9,0,0">
                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding DetailPartition}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding DetailProvenance}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding DetailMaxText}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </WrapPanel>

                                    <Border Style="{StaticResource Panel}" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="The question" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="{Binding DetailPrompt}" FontSize="13.5" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="The three marks are different things" Style="{StaticResource SectionLabel}"
                                               Margin="0,14,0,2" />
                                    <TextBlock Text="The scheme-derived reference is not a teacher mark, and the AI mark is not ground truth."
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,8" />

                                    <ui:ResponsiveGridPanel MinItemWidth="185" Gap="8">
                                        <Border Style="{StaticResource Panel}" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="Official mark scheme" Style="{StaticResource SectionLabel}"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding DetailSchemeMarkText}" FontSize="22"
                                                           FontWeight="SemiBold" Margin="0,6,0,0" />
                                                <TextBlock Text="scheme-derived reference mark"
                                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                <ItemsControl ItemsSource="{Binding SchemeLines}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontSize="11.5" Margin="0,0,0,4"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Panel}" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="AI-awarded mark · latest run"
                                                           Style="{StaticResource SectionLabel}"
                                                           Foreground="{DynamicResource WarningTextBrush}" />
                                                <TextBlock Text="{Binding AiMarkText}" FontSize="22"
                                                           FontWeight="SemiBold" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource WarningTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding AiMarkDetail}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="Not ground truth and never counted as teacher evidence."
                                                           FontSize="11" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Panel}" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="Teacher-confirmed mark"
                                                           Style="{StaticResource SectionLabel}"
                                                           Foreground="{DynamicResource SuccessTextBrush}" />
                                                <TextBlock Text="{Binding DetailTeacherMarkText}" FontSize="22"
                                                           FontWeight="SemiBold" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource SuccessTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DetailTeacherStatus}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding DetailEligibility}" FontSize="11" Margin="0,5,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </ui:ResponsiveGridPanel>

                                    <Border Style="{StaticResource WarningBanner}" Margin="0,10,0,0"
                                            Visibility="{Binding HasConflict, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding DetailConflict}" FontSize="12"
                                                   Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
                                    </Border>

                                    <Border Style="{StaticResource Panel}" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Reference ruling" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="Scheme-derived rationale; it is not teacher confirmation."
                                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DetailRuling}" FontSize="12.5" Margin="0,6,0,0"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DetailBasis}" FontSize="11" Margin="0,5,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <WrapPanel Margin="0,9,0,0">
                                        <ItemsControl ItemsSource="{Binding Categories}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Chip}" Margin="0,0,5,4">
                                                        <TextBlock Text="{Binding}" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>

                                    <Border Style="{StaticResource Panel}" Margin="0,6,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Candidate working" Style="{StaticResource SectionLabel}" />
                                            <ItemsControl ItemsSource="{Binding AnswerLines}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Margin="0,12,0,0">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="9,2">
                                                <TextBlock Text="{Binding Assessments.Count}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <TextBlock Text="Assessment history" Style="{StaticResource SectionLabel}"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="Append-only. Every teacher assessment is preserved; a conflict is never silently resolved."
                                                   FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Assessments}" Margin="0,7,0,0"
                                                      AutomationProperties.Name="Assessment history">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Panel}" Margin="0,0,0,5">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding MarkText}"
                                                                           FontSize="12.5" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding AssessorText}" FontSize="12"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" Margin="0,2,0,0"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                            <TextBlock Text="{Binding WhenText}" FontSize="11" Margin="0,2,0,0"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                            <TextBlock Text="{Binding NoteText}" FontSize="11.5" Margin="0,4,0,0"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding AlternativeText}" FontSize="11" Margin="0,3,0,0"
                                                                       TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"
                                                                       Visibility="{Binding HasAlternatives, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                            <TextBlock Text="No teacher has recorded an assessment for this item."
                                                       FontSize="11.5" Margin="0,5,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Visibility="{Binding HasAssessments, Converter={StaticResource InverseBoolToVis}}" />
                                    </StackPanel>

                                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,14,0,12" />

                                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource CardTitle}"
                                               FontSize="18" TextWrapping="Wrap" />
                                    <TextBlock Text="This is your professional judgement, not the AI's. Nothing is recorded until you confirm below."
                                               FontSize="11.5" Margin="0,4,0,10"
                                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />

                                    <TextBlock Text="Decision" Style="{StaticResource SectionLabel}" />
                                    <ComboBox Margin="0,5,0,0" ItemsSource="{Binding DecisionOptions}"
                                              SelectedItem="{Binding Decision, Mode=TwoWay}"
                                              DisplayMemberPath="Label"
                                              AutomationProperties.Name="Assessment decision" />

                                    <ui:ResponsiveGridPanel MinItemWidth="145" Gap="8" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Mark awarded" Style="{StaticResource SectionLabel}" />
                                            <TextBox Margin="0,5,0,0" Text="{Binding MarkText, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Teacher awarded mark" />
                                            <TextBlock Text="{Binding DetailMaxText}" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Assessor" Style="{StaticResource SectionLabel}" />
                                            <TextBox Margin="0,5,0,0" Text="{Binding Assessor, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Assessor" />
                                            <TextBlock Text="Name, initials or role identifier" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Role (optional)" Style="{StaticResource SectionLabel}" />
                                            <TextBox Margin="0,5,0,0" Text="{Binding AssessorRole, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Assessor role" />
                                            <TextBlock Text="For example: Head of Maths" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </ui:ResponsiveGridPanel>

                                    <TextBlock Text="Marking note" Style="{StaticResource SectionLabel}" Margin="0,10,0,0" />
                                    <TextBox Margin="0,5,0,0" Height="62" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Marking note" />
                                    <TextBlock Text="Required for a disputed or incomplete assessment; optional otherwise."
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />

                                    <TextBlock Text="Accepted alternative methods" Style="{StaticResource SectionLabel}"
                                               Margin="0,10,0,0" />
                                    <TextBox Margin="0,5,0,0" Height="52" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                             Text="{Binding AlternativeText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Accepted alternative methods" />
                                    <TextBlock Text="One method per line. These travel with the assessment, not into a student's grade."
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />

                                    <CheckBox Margin="0,12,0,0" IsChecked="{Binding IsConfirmed, Mode=TwoWay}"
                                              Content="I confirm this is my own assessed mark for this reference item."
                                              AutomationProperties.Name="Explicitly confirm this assessment" />

                                    <TextBlock Text="{Binding ValidationHint}" FontSize="11" Margin="0,7,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                               AutomationProperties.Name="Assessment validation hint" />

                                    <Button Content="Record assessment" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding SubmitCommand}" HorizontalAlignment="Left"
                                            Margin="0,9,0,0" Height="34" Padding="16,5"
                                            AutomationProperties.Name="Record teacher assessment" />

                                    <Border Style="{StaticResource InfoBanner}" Margin="0,10,0,0"
                                            Visibility="{Binding HasWorkflowStatus, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding WorkflowStatus}" FontSize="11.5"
                                                   Foreground="{DynamicResource InfoBrush}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Style="{StaticResource EmptyState}" MaxWidth="340"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Pick a reference" Style="{StaticResource EmptyTitle}" />
                                    <TextBlock Text="Select a row to read the scheme, the candidate working and the AI mark before recording your own."
                                               Style="{StaticResource EmptyText}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ErrorBanner}" VerticalAlignment="Top" Margin="0,12,0,0"
                                    Visibility="{Binding HasDetailError, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Retry" Command="{Binding RetryDetailCommand}"
                                            Height="28" Padding="12,4" Margin="10,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="This reference could not be loaded." FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailError}" FontSize="11.5" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                                         Visibility="{Binding IsDetailBusy, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                </ui:ResponsiveGridPanel>
            </StackPanel>
        </ScrollViewer>
    </ui:PageFrame>
</UserControl>

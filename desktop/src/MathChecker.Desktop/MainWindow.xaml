<Window x:Class="MathChecker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MATH_CHECKER_V5" Height="860" Width="1440"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasGradientBrush}"
        TextOptions.TextFormattingMode="Ideal">

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding TogglePaletteCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleRailCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- The rail swaps templates between the 220 DIP list and the 68 DIP
             icon rail. Both read the same space collection. -->
        <Style x:Key="RailItem" TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsRailExpanded, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="False">
                    <Setter Property="Template" Value="{StaticResource NavItemCompactTemplate}" />
                    <Setter Property="Margin" Value="0,2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaletteList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource PaletteItem}" />
            <Setter Property="MaxHeight" Value="320" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- One status dot, used in the menu strip and the rail footer. -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BackendAvailable}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             Menu strip: File / View / Backend, then the ambient facts.
             ============================================================ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{DynamicResource CanvasDeepBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0">

                <Menu DockPanel.Dock="Left" VerticalAlignment="Center">
                    <MenuItem Header="_File">
                        <MenuItem Header="Open data folder" Command="{Binding OpenDataFolderCommand}" />
                        <MenuItem Header="Open desktop log" Command="{Binding OpenLogsCommand}" />
                        <MenuItem Header="Open settings file" Command="{Binding OpenSettingsFileCommand}" />
                        <Separator Style="{StaticResource MenuSeparator}" />
                        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGestureText="Alt+F4" />
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="Search pages" Command="{Binding TogglePaletteCommand}"
                                  InputGestureText="Ctrl+K" />
                        <MenuItem Header="Collapse or expand rail" Command="{Binding ToggleRailCommand}"
                                  InputGestureText="Ctrl+B" />
                    </MenuItem>
                    <MenuItem Header="_Backend">
                        <MenuItem Header="Restart backend" Command="{Binding RestartBackendCommand}" />
                    </MenuItem>
                </Menu>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}" Padding="7,2" Margin="0,0,6,0"
                            Visibility="{Binding IsRailCollapsed, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding BackendShort}" FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource BarButton}" Command="{Binding OpenDataFolderCommand}"
                            ToolTip="Open the data folder" AutomationProperties.Name="Data folder">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" Command="{Binding OpenLogsCommand}"
                            ToolTip="Open the desktop log" AutomationProperties.Name="Open logs">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource IconGlyph}" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" Margin="0" Command="{Binding RestartBackendCommand}"
                            ToolTip="Restart the backend" AutomationProperties.Name="Restart backend">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}" FontSize="12" />
                    </Button>
                </StackPanel>

                <!-- The palette is the primary way to move; it reads as a field. -->
                <Button Command="{Binding TogglePaletteCommand}"
                        Style="{StaticResource GhostButton}"
                        Height="32" Padding="12,0" MaxWidth="420"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                        AutomationProperties.Name="Search pages"
                        ToolTip="Search every page (Ctrl+K)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyph}" FontSize="11"
                                   Margin="0,0,7,0" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="Search pages and actions" FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" />
                        <Border Background="{DynamicResource CanvasDeepBrush}" CornerRadius="2"
                                Padding="5,1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl K" FontSize="9" FontFamily="{StaticResource MonoFont}"
                                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="NoWrap" />
                        </Border>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- ============================================================
             Rail: one entry per destination family.
             ============================================================ -->
        <Border Grid.Row="1" Grid.Column="0" Width="{Binding RailWidth}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0"
                Background="{DynamicResource CanvasDeepBrush}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="12,12,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The compact rail has no room for a wordmark; keep the
                         toggle alone there so the header never crowds. -->
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentBrush}"
                            Visibility="{Binding IsRailExpanded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#x2211;" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentInkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsRailExpanded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Math Checker" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="15" FontWeight="Bold" TextWrapping="NoWrap"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="MARKING WORKSPACE" FontSize="8.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,1,0,0" TextWrapping="NoWrap" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="24"
                            Margin="0" Padding="0" HorizontalAlignment="Right"
                            Command="{Binding ToggleRailCommand}"
                            ToolTip="Collapse or expand the rail (Ctrl+B)"
                            AutomationProperties.Name="Toggle navigation rail">
                        <TextBlock Text="{Binding RailToggleGlyph}" Style="{StaticResource IconGlyph}"
                                   FontSize="11" />
                    </Button>
                </Grid>

                <Border DockPanel.Dock="Bottom" Margin="8,8,8,10" Padding="8,7"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding BackendShort}" FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       MaxWidth="150" VerticalAlignment="Center"
                                       Visibility="{Binding IsRailExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding AppVersion, StringFormat=Desktop {0}}"
                                   FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,4,0,0" TextWrapping="NoWrap"
                                   Visibility="{Binding IsRailExpanded, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Spaces}"
                         SelectedItem="{Binding CurrentSpace, Mode=TwoWay}"
                         Style="{StaticResource NavListBox}"
                         ItemContainerStyle="{StaticResource RailItem}"
                         AutomationProperties.Name="Spaces" />
            </DockPanel>
        </Border>

        <!-- ============================================================
             Content column: space header, banners, page.
             ============================================================ -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="26,0,26,0" MinHeight="46">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding SpaceName}"
                               Style="{StaticResource SectionLabel}" VerticalAlignment="Center"
                               Margin="0,1,16,0" />
                    <ListBox ItemsSource="{Binding SpacePages}"
                             SelectedItem="{Binding Current, Mode=TwoWay}"
                             Style="{StaticResource SpaceTabs}"
                             VerticalAlignment="Center"
                             Visibility="{Binding HasSpaceTabs, Converter={StaticResource BoolToVis}}"
                             AutomationProperties.Name="Pages in this space" />
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,10,20,0">
                <!-- A backend that works but is the WRONG data source (a demo
                     process, or a different data folder) is a warning, not an
                     error: the window must say so before anything is read. -->
                <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,8"
                        Visibility="{Binding HasBackendWarning, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Check which data this window is showing."
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding BackendWarning}" Margin="0,2,0,0" FontSize="11.5"
                                   TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- A backend failure is a first-class state, not a toast. -->
                <Border Style="{StaticResource ErrorBanner}" Margin="0,0,0,8"
                        Visibility="{Binding BackendUnavailable, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Retry" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RestartBackendCommand}" Height="28" Padding="12,4"
                                Margin="12,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="The correction backend is not available."
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding BackendDetail}" Margin="0,2,0,0" FontSize="11.5"
                                       Foreground="{DynamicResource DangerTextBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentLineBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="14,9"
                        Margin="0,0,0,10" HorizontalAlignment="Left"
                        Effect="{DynamicResource CardShadowEffect}"
                        Visibility="{Binding Toast, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding Toast}" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <ContentControl Grid.Row="2" Content="{Binding Current}" Margin="26,16,26,0"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            TextElement.Foreground="{DynamicResource TextBrush}" />
        </Grid>

        <!-- ============================================================
             Status bar: quiet facts, not a second header.
             ============================================================ -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Background="{DynamicResource CanvasDeepBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="{Binding DataFolder, StringFormat=DATA  {0}}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           MaxWidth="460" />

                <TextBlock Grid.Column="1" FontSize="10" Margin="24,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding Current.Status}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               Text="{Binding AppVersion, StringFormat=Desktop {0}}" TextWrapping="NoWrap" />
                    <Border Width="1" Height="10" Margin="10,0" Background="{DynamicResource HairlineBrush}" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               Text="Ctrl+K to jump" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             Command palette overlay.
             ============================================================ -->
        <Grid x:Name="PaletteScrim" Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="90"
              Background="{DynamicResource ScrimBrush}" Focusable="True"
              Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVis}}"
              PreviewKeyDown="OnPaletteKeyDown"
              MouseLeftButtonDown="OnPaletteScrimClick">
            <Border Width="600" VerticalAlignment="Top" Margin="0,120,0,0"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource DialogRadius}" Padding="10"
                    Effect="{DynamicResource FloatingShadow}"
                    MouseLeftButtonDown="OnPaletteCardClick">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBox x:Name="PaletteInput" MinHeight="38" Margin="0" FontSize="13.5"
                                 Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search every page" />
                        <TextBlock Text="Type a page name — Results, Prompts, Students…"
                                   FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding PaletteQuery, Converter={StaticResource EmptyToVisibility}}" />
                    </Grid>

                    <ListBox x:Name="PaletteList" ItemsSource="{Binding PaletteResults}"
                             SelectedItem="{Binding PaletteSelection, Mode=TwoWay}"
                             Style="{StaticResource PaletteList}"
                             AutomationProperties.Name="Page matches" />

                    <TextBlock Text="No page matches that search." Style="{StaticResource EmptyText}"
                               Margin="0,16,0,16" FontSize="11.5"
                               Visibility="{Binding PaletteEmpty, Converter={StaticResource BoolToVis}}" />

                    <DockPanel Margin="8,6,8,2">
                        <TextBlock Text="Enter to open  ·  Esc to close" FontSize="9.5"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="NoWrap" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PaletteHint}" FontSize="9.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Right" TextWrapping="NoWrap" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

<Application x:Class="MathChecker.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MathChecker.Desktop.ViewModels"
             xmlns:views="clr-namespace:MathChecker.Desktop.Views"
             xmlns:conv="clr-namespace:MathChecker.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Swapped for DarkTheme.xaml by ThemeManager when the saved
                     appearance is dark. Must stay first: controls look up
                     every colour from it at runtime. -->
                <ResourceDictionary Source="Themes/LightTheme.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:ZeroToVisibilityConverter x:Key="ZeroToVis" />
            <conv:NonZeroToVisibilityConverter x:Key="NonZeroToVis" />
            <conv:OrdinalConverter x:Key="Ordinal" />

            <!-- View-model to view mapping. Navigation shows a view model; WPF
                 picks the view. Adding a page never changes the shell. -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SearchViewModel}">
                <views:SearchView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CorrectionViewModel}">
                <views:CorrectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WorkersViewModel}">
                <views:WorkersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:JobsViewModel}">
                <views:JobsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AutomationViewModel}">
                <views:AutomationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReviewViewModel}">
                <views:ReviewView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SchemeReviewViewModel}">
                <views:SchemeReviewView />
            </DataTemplate>
            <!-- The per-assignment Mark scheme page: every question and
                 sub-question with its answer, extracted state and handling
                 decision, reached from the assignment it belongs to. -->
            <DataTemplate DataType="{x:Type vm:MarkSchemeViewModel}">
                <views:MarkSchemeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MarkingDeskViewModel}">
                <views:MarkingDeskView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ResultsViewModel}">
                <views:ResultsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsageViewModel}">
                <views:UsageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StudentsViewModel}">
                <views:StudentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AssignmentsViewModel}">
                <views:AssignmentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CreateAssignmentViewModel}">
                <views:CreateAssignmentView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AssignmentDetailViewModel}">
                <views:AssignmentDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AiKeysViewModel}">
                <views:AiKeysView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PromptsViewModel}">
                <views:PromptsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:JsonPageViewModel}">
                <views:JsonPageView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

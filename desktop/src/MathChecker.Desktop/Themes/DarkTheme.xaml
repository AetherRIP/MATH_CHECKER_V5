<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Dark appearance: the same roles as LightTheme, so no view has to
         know which one is active. Indigo is lifted for contrast on ink.
         ============================================================ -->

    <SolidColorBrush x:Key="CanvasBrush" Color="#0F0E17" />
    <SolidColorBrush x:Key="CanvasDeepBrush" Color="#15131F" />
    <SolidColorBrush x:Key="SunkenBrush" Color="#1B1926" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1826" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#221F30" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#252233" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#2E2947" />

    <SolidColorBrush x:Key="HairlineBrush" Color="#2B2839" />
    <SolidColorBrush x:Key="HairlineStrongBrush" Color="#3D3853" />
    <SolidColorBrush x:Key="RowHairlineBrush" Color="#242132" />

    <SolidColorBrush x:Key="TextBrush" Color="#F4F3FA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C3BFD5" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8D89A2" />

    <SolidColorBrush x:Key="AccentBrush" Color="#8C7BFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9E90FF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#7563F2" />
    <SolidColorBrush x:Key="AccentInkBrush" Color="#14121F" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A2543" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="#4B4272" />
    <SolidColorBrush x:Key="FocusBrush" Color="#A799FF" />

    <SolidColorBrush x:Key="WarningBrush" Color="#F0B44C" />
    <SolidColorBrush x:Key="WarningInkBrush" Color="#2A1B05" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#33270F" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFD98F" />

    <SolidColorBrush x:Key="DangerBrush" Color="#FF7A6E" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#3A1C19" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFB3AD" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#5FD3A0" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#16301F" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#A8E8C0" />

    <SolidColorBrush x:Key="InfoBrush" Color="#6FA8F5" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#1B2A44" />

    <SolidColorBrush x:Key="PaperBrush" Color="#FBF9F4" />
    <SolidColorBrush x:Key="PaperInkBrush" Color="#1E1B17" />
    <SolidColorBrush x:Key="PaperSurroundBrush" Color="#0B0A11" />

    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#A60B0A12" />

    <!-- Ink on the one gradient hero card (always a coloured surface). -->
    <SolidColorBrush x:Key="HeroInkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeroMutedBrush" Color="#CFC8F5" />

    <LinearGradientBrush x:Key="CanvasGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#12101C" Offset="0" />
        <GradientStop Color="#0F0E17" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E2849" Offset="0" />
        <GradientStop Color="#1B1828" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="20" ShadowDepth="4"
                      Direction="270" Opacity="0.35" Color="#000000" />
    <DropShadowEffect x:Key="PopShadowEffect" BlurRadius="34" ShadowDepth="10"
                      Direction="270" Opacity="0.50" Color="#000000" />
    <DropShadowEffect x:Key="FloatingShadow" BlurRadius="44" ShadowDepth="16"
                      Direction="270" Opacity="0.55" Color="#000000" />
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Instrument — light. Cool paper, not cream: 1 DIP hairlines carry the
         structure and shadows stay a whisper. The accent is a printer's teal
         dark enough to read as text on paper.
         ============================================================ -->

    <SolidColorBrush x:Key="CanvasBrush" Color="#F3F5F7" />
    <SolidColorBrush x:Key="CanvasDeepBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SunkenBrush" Color="#EAEEF2" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EDF1F5" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#E2EBEF" />

    <SolidColorBrush x:Key="HairlineBrush" Color="#DCE3EA" />
    <SolidColorBrush x:Key="HairlineStrongBrush" Color="#C4CFD9" />
    <SolidColorBrush x:Key="RowHairlineBrush" Color="#E9EEF3" />

    <SolidColorBrush x:Key="TextBrush" Color="#0C1219" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#485663" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64707C" />

    <SolidColorBrush x:Key="AccentBrush" Color="#0B7C86" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#096A73" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#075A62" />
    <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E4F1F2" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="#B7DADD" />
    <SolidColorBrush x:Key="FocusBrush" Color="#0B7C86" />

    <SolidColorBrush x:Key="WarningBrush" Color="#A26513" />
    <SolidColorBrush x:Key="WarningInkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FBF0DD" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#7A4A0C" />

    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FBEBE9" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#97291D" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#147A5B" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#E3F4EC" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#0E6047" />

    <SolidColorBrush x:Key="InfoBrush" Color="#1F6FA8" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#E6F0F8" />

    <!-- The answer sheet stays paper in both appearances. -->
    <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PaperInkBrush" Color="#14181C" />
    <SolidColorBrush x:Key="PaperSurroundBrush" Color="#E4E8ED" />

    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#55101519" />

    <!-- Ink on the one hero panel (always a coloured surface). -->
    <SolidColorBrush x:Key="HeroInkBrush" Color="#F4FBFB" />
    <SolidColorBrush x:Key="HeroMutedBrush" Color="#A9C6CB" />

    <!-- The single light action the hero carries. It is priced against the
         ink panel, not the theme, so its hover is a teal-tinted white rather
         than a palette surface. -->
    <SolidColorBrush x:Key="HeroActionInkBrush" Color="#0E1A1C" />
    <SolidColorBrush x:Key="HeroActionHoverBrush" Color="#E8F6F4" />
    <SolidColorBrush x:Key="HeroActionPressedBrush" Color="#CFEDE9" />

    <LinearGradientBrush x:Key="CanvasGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFBFC" Offset="0" />
        <GradientStop Color="#F2F5F7" Offset="1" />
    </LinearGradientBrush>

    <!-- The same ink hero in both appearances: it is the one moment of colour
         on the page, so it must not turn pale in daylight. -->
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0E3438" Offset="0" />
        <GradientStop Color="#0A1E22" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="10" ShadowDepth="2"
                      Direction="270" Opacity="0.06" Color="#0C1219" />
    <DropShadowEffect x:Key="PopShadowEffect" BlurRadius="24" ShadowDepth="6"
                      Direction="270" Opacity="0.10" Color="#0C1219" />
    <DropShadowEffect x:Key="FloatingShadow" BlurRadius="32" ShadowDepth="10"
                      Direction="270" Opacity="0.12" Color="#0C1219" />
</ResourceDictionary>

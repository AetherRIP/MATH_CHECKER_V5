<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         The visual language: near-black olive canvas, one lime
         decision colour, orange reserved for attention, warm paper.
         ============================================================ -->

    <Color x:Key="CanvasColor">#0B0D08</Color>
    <Color x:Key="CanvasGlowColor">#1A2210</Color>
    <Color x:Key="SurfaceColor">#151910</Color>
    <Color x:Key="SurfaceRaisedColor">#1C2115</Color>
    <Color x:Key="SurfaceHoverColor">#222817</Color>
    <Color x:Key="SurfaceSelectedColor">#293213</Color>
    <Color x:Key="HairlineColor">#2A3021</Color>
    <Color x:Key="HairlineStrongColor">#3B4330</Color>
    <Color x:Key="TextColor">#F3F1E6</Color>
    <Color x:Key="TextSecondaryColor">#A6AA9B</Color>
    <Color x:Key="TextMutedColor">#767C6C</Color>
    <Color x:Key="LimeColor">#DFFF3A</Color>
    <Color x:Key="LimeHoverColor">#E9FF6A</Color>
    <Color x:Key="LimePressedColor">#C6E62B</Color>
    <Color x:Key="LimeInkColor">#101305</Color>
    <Color x:Key="LimeSoftColor">#2A3311</Color>
    <Color x:Key="OrangeColor">#FF8B45</Color>
    <Color x:Key="OrangeInkColor">#24150B</Color>
    <Color x:Key="OrangeSurfaceColor">#342217</Color>
    <Color x:Key="OrangeTextColor">#FFB68E</Color>
    <Color x:Key="DangerColor">#FF6F5E</Color>
    <Color x:Key="DangerSurfaceColor">#341A16</Color>
    <Color x:Key="DangerTextColor">#FFA79C</Color>
    <Color x:Key="PaperColor">#F2F0E6</Color>
    <Color x:Key="PaperSurroundColor">#0E100B</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="CanvasGlowBrush" Color="{StaticResource CanvasGlowColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="{StaticResource SurfaceSelectedColor}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
    <SolidColorBrush x:Key="HairlineStrongBrush" Color="{StaticResource HairlineStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="LimeBrush" Color="{StaticResource LimeColor}" />
    <SolidColorBrush x:Key="LimeHoverBrush" Color="{StaticResource LimeHoverColor}" />
    <SolidColorBrush x:Key="LimePressedBrush" Color="{StaticResource LimePressedColor}" />
    <SolidColorBrush x:Key="LimeInkBrush" Color="{StaticResource LimeInkColor}" />
    <SolidColorBrush x:Key="LimeSoftBrush" Color="{StaticResource LimeSoftColor}" />
    <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}" />
    <SolidColorBrush x:Key="OrangeInkBrush" Color="{StaticResource OrangeInkColor}" />
    <SolidColorBrush x:Key="OrangeSurfaceBrush" Color="{StaticResource OrangeSurfaceColor}" />
    <SolidColorBrush x:Key="OrangeTextBrush" Color="{StaticResource OrangeTextColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}" />
    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
    <SolidColorBrush x:Key="PaperSurroundBrush" Color="{StaticResource PaperSurroundColor}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#B3000000" />

    <!-- The canvas is not flat: a soft olive glow behind everything. -->
    <LinearGradientBrush x:Key="CanvasGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1D2611" Offset="0" />
        <GradientStop Color="#11150C" Offset="0.42" />
        <GradientStop Color="#0B0D08" Offset="1" />
    </LinearGradientBrush>

    <!-- Embedded Space Grotesk. Four static weights are shipped because WPF
         does not select named instances inside a variable font. -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Space Grotesk</FontFamily>
    <FontFamily x:Key="BodyFont">pack://application:,,,/Assets/Fonts/#Space Grotesk</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <CornerRadius x:Key="CardRadius">24</CornerRadius>
    <CornerRadius x:Key="PanelRadius">20</CornerRadius>
    <CornerRadius x:Key="ControlRadius">14</CornerRadius>
    <CornerRadius x:Key="PillRadius">999</CornerRadius>

    <Thickness x:Key="PagePadding">28,24,28,20</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>

    <!-- Dotted overlay used on the lime hero card, echoing the reference. -->
    <DrawingBrush x:Key="DotPatternBrush" TileMode="Tile"
                  Viewport="0,0,16,16" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#26000000">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="2,2" RadiusX="1.1" RadiusY="1.1" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="StripePatternBrush" TileMode="Tile"
                  Viewport="0,0,12,12" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#1F000000">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry Rect="0,0,3,12" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
        <DrawingBrush.RelativeTransform>
            <RotateTransform Angle="45" CenterX="0.5" CenterY="0.5" />
        </DrawingBrush.RelativeTransform>
    </DrawingBrush>
</ResourceDictionary>

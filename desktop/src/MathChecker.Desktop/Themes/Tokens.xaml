<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Theme-neutral tokens. Colour, elevation and gradients live in
         LightTheme.xaml / DarkTheme.xaml, so switching appearance only
         swaps one dictionary. Everything here is the same in both.
         ============================================================ -->

    <!-- Typography: the reference's Plus Jakarta Sans, bundled with the
         application (SIL OFL, see Assets/Fonts/OFL-PlusJakartaSans.txt).
         Cascadia Mono keeps identifiers and raw payloads legible. -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="BodyFont">pack://application:,,,/Assets/Fonts/#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="MediumFont">pack://application:,,,/Assets/Fonts/#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Courier New</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <!-- Geometry: generous squircles, sized for a pointer on a desktop
         rather than a thumb on glass. -->
    <CornerRadius x:Key="ControlRadius">10</CornerRadius>
    <CornerRadius x:Key="TileRadius">8</CornerRadius>
    <CornerRadius x:Key="CardRadius">18</CornerRadius>
    <CornerRadius x:Key="PanelRadius">18</CornerRadius>
    <CornerRadius x:Key="DialogRadius">20</CornerRadius>
    <CornerRadius x:Key="PillRadius">999</CornerRadius>

    <Thickness x:Key="PagePadding">26,20,26,22</Thickness>
    <Thickness x:Key="CardPadding">18</Thickness>

    <!-- 4 / 8 / 12 / 16 / 24 / 32. -->
    <Thickness x:Key="GapXs">4</Thickness>
    <Thickness x:Key="GapSm">8</Thickness>
    <Thickness x:Key="GapMd">12</Thickness>
    <Thickness x:Key="GapLg">16</Thickness>
    <Thickness x:Key="GapXl">24</Thickness>
    <Thickness x:Key="GapXxl">32</Thickness>
    <Thickness x:Key="StackGap">0,0,0,12</Thickness>
    <Thickness x:Key="SectionGap">0,0,0,20</Thickness>
</ResourceDictionary>

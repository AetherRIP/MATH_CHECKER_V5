<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         Theme-neutral tokens: type roles, geometry and spacing. Colour,
         elevation and gradients live in LightTheme.xaml / DarkTheme.xaml,
         so switching appearance still swaps exactly one dictionary.
         ============================================================ -->

    <!-- Two voices, two jobs. Space Grotesk (bundled, SIL OFL) is the
         measurement voice: figures, table numerals, navigation and the
         wordmark. Plus Jakarta Sans is the language voice: titles, body
         copy, labels — everything a teacher reads as a sentence.
         Cascadia Mono carries ids, paths and raw payloads. -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Space Grotesk</FontFamily>
    <FontFamily x:Key="BodyFont">pack://application:,,,/Assets/Fonts/#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="MediumFont">pack://application:,,,/Assets/Fonts/#Space Grotesk</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Courier New</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <!-- Geometry: tight enough to read as an instrument, not a toy. The chip
         radius is deliberately small — a status is a stamp, not a pill. -->
    <CornerRadius x:Key="ControlRadius">8</CornerRadius>
    <CornerRadius x:Key="TileRadius">5</CornerRadius>
    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <CornerRadius x:Key="PanelRadius">12</CornerRadius>
    <CornerRadius x:Key="DialogRadius">14</CornerRadius>
    <CornerRadius x:Key="PillRadius">5</CornerRadius>

    <!-- ============================================================
         Spacing. Four steps, each used by the shared styles and the
         pages: 6 / 12 / 20 / 32. A value that is not here is a defect,
         not a decision.
         ============================================================ -->
    <Thickness x:Key="PagePadding">26,16,26,0</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>

    <Thickness x:Key="TightGap">0,0,0,6</Thickness>
    <Thickness x:Key="StackGap">0,0,0,12</Thickness>
    <Thickness x:Key="SectionGap">0,0,0,20</Thickness>
    <Thickness x:Key="PageGap">0,0,0,32</Thickness>

    <!-- ============================================================
         Layout widths. The score gutter and the form column are the two
         measurements the product repeats on every screen, so they are
         tokens rather than numbers scattered through the views.
         ============================================================ -->
    <sys:Double x:Key="GutterGap">14</sys:Double>
    <sys:Double x:Key="FieldWidth">400</sys:Double>
    <sys:Double x:Key="FormWidth">720</sys:Double>

    <!-- A ColumnDefinition.Width is a GridLength, not a Double. -->
    <GridLength x:Key="LabelColumnWidth">132</GridLength>
</ResourceDictionary>

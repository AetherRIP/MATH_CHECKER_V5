<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <!-- Generated from ui-style-kit-css (paper-editorial / walnut-clay).
             Regenerate with desktop/tools/sync-ui-kit-tokens.mjs. -->
        <ResourceDictionary Source="KitTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================================================
         The desktop register: warm walnut ink, paper light, one
         terracotta decision colour. Brushes named after a kit role
         read that role's generated colour directly, so regenerating
         the kit restyles the application. Only the shades the kit
         does not name (hovers, hairlines, ink) are literal here.
         ============================================================ -->

    <!-- Derived surfaces, from the deepest chrome to the raised control. -->
    <Color x:Key="CanvasDeepColor">#0D0805</Color>
    <Color x:Key="HairlineColor">#3A2A20</Color>
    <Color x:Key="RowHairlineColor">#2F211A</Color>
    <Color x:Key="SurfaceHoverColor">#2E1F18</Color>
    <Color x:Key="SurfaceSelectedColor">#3B2A20</Color>

    <!-- Text: warm paper ink, never pure white. -->
    <Color x:Key="TextMutedColor">#9A8577</Color>

    <!-- The one decision colour: the kit's primary role at desktop weight. -->
    <Color x:Key="AccentInkColor">#120C09</Color>
    <Color x:Key="AccentPressedColor">#C4875F</Color>
    <Color x:Key="AccentSoftColor">#3A2820</Color>
    <Color x:Key="AccentLineColor">#6E4C3B</Color>

    <!-- Attention, warning and danger surfaces; the accents come from the kit. -->
    <Color x:Key="WarningInkColor">#2A1B05</Color>
    <Color x:Key="WarningSurfaceColor">#332614</Color>
    <Color x:Key="WarningTextColor">#FFD98F</Color>

    <Color x:Key="DangerSurfaceColor">#3A1C19</Color>
    <Color x:Key="DangerTextColor">#FFB3AD</Color>

    <Color x:Key="SuccessSurfaceColor">#1D3326</Color>
    <Color x:Key="SuccessTextColor">#A8E8C0</Color>

    <Color x:Key="InfoSurfaceColor">#262B20</Color>

    <!-- The answer sheet itself stays paper, whatever the chrome does. -->
    <Color x:Key="PaperColor">#F8F1E9</Color>
    <Color x:Key="PaperInkColor">#1F1712</Color>
    <Color x:Key="PaperSurroundColor">#0E0907</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource KitBgColor}" />
    <SolidColorBrush x:Key="CanvasDeepBrush" Color="{StaticResource CanvasDeepColor}" />
    <SolidColorBrush x:Key="SunkenBrush" Color="{StaticResource KitSurfaceSoftColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource KitSurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource KitSurfaceStrongColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="{StaticResource SurfaceSelectedColor}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
    <SolidColorBrush x:Key="HairlineStrongBrush" Color="{StaticResource KitBorderColor}" />
    <SolidColorBrush x:Key="RowHairlineBrush" Color="{StaticResource RowHairlineColor}" />

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource KitTextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource KitTextMutedColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource KitPrimaryColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource KitPrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="{StaticResource AccentLineColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource KitFocusColor}" />

    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource KitWarningColor}" />
    <SolidColorBrush x:Key="WarningInkBrush" Color="{StaticResource WarningInkColor}" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{StaticResource WarningSurfaceColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}" />

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource KitDangerColor}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource KitSuccessColor}" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{StaticResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessTextColor}" />

    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource KitSecondaryColor}" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="{StaticResource InfoSurfaceColor}" />

    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
    <SolidColorBrush x:Key="PaperInkBrush" Color="{StaticResource PaperInkColor}" />
    <SolidColorBrush x:Key="PaperSurroundBrush" Color="{StaticResource PaperSurroundColor}" />

    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#CC080403" />

    <!-- Nearly flat: desktop chrome should not look like a marketing page. -->
    <LinearGradientBrush x:Key="CanvasGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource KitSurfaceSoftColor}" Offset="0" />
        <GradientStop Color="{StaticResource KitBgColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- One raised surface for the desk's primary panel. -->
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource KitSurfaceStrongColor}" Offset="0" />
        <GradientStop Color="{StaticResource KitSurfaceColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================================
         Typography: native Windows body text, editorial serif titles.
         Georgia carries the paper register at display sizes only;
         body copy stays Segoe UI for ClearType at 11-13 px.
         ============================================================ -->

    <FontFamily x:Key="DisplayFont">Georgia</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <!-- Desktop geometry: print-square corners, not rounded web cards. -->
    <CornerRadius x:Key="CardRadius">4</CornerRadius>
    <CornerRadius x:Key="PanelRadius">4</CornerRadius>
    <CornerRadius x:Key="ControlRadius">4</CornerRadius>
    <CornerRadius x:Key="PillRadius">999</CornerRadius>

    <Thickness x:Key="PagePadding">20,14,20,16</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>

    <!-- 4 / 8 / 12 / 16 / 24 / 32, as before. -->
    <Thickness x:Key="GapXs">4</Thickness>
    <Thickness x:Key="GapSm">8</Thickness>
    <Thickness x:Key="GapMd">12</Thickness>
    <Thickness x:Key="GapLg">16</Thickness>
    <Thickness x:Key="GapXl">24</Thickness>
    <Thickness x:Key="GapXxl">32</Thickness>
    <Thickness x:Key="StackGap">0,0,0,10</Thickness>
    <Thickness x:Key="SectionGap">0,0,0,18</Thickness>

    <!-- One elevation level only, and a quieter one than before. -->
    <DropShadowEffect x:Key="FloatingShadow" BlurRadius="24" ShadowDepth="6"
                      Direction="270" Opacity="0.45" Color="#000000" />
</ResourceDictionary>

# --- V5: secrets and local data (never commit) -------------------------------
data/
data/secrets.toml
data/secrets/
*.db
*.db-journal
*.db-wal
*.db-shm
client_secret_*.json

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
# NOTE: `*.py[cod]` above ALSO matches every `*.pyd`. In the bundled Windows
# runtime the .pyd files are not optional build debris - they ARE the
# runtime: _socket.pyd, _sqlite3.pyd, _ssl.pyd, _ctypes.pyd, _hashlib.pyd,
# pymupdf/_mupdf.pyd, PIL/_imaging*.pyd. Ignoring them left the packages
# committed in this repository without any of them, so a portable folder
# taken from git could not import socket/sqlite3/ssl and the app could not
# start at all on a clean Windows PC. Keep this negation: without it the
# distribution in git is not runnable.
!MathChecker_Distribution/**/*.pyd
*.egg-info/
.venv/
# setup.bat moves a foreign-platform environment aside instead of deleting it.
# It is recreated on demand and must never be committed.
.venv.foreign/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / frontend ----------------------------------------------------------
node_modules/
frontend/dist/
frontend/node_modules/
*.local

# --- Portable distribution build output --------------------------------------
dist/
portable.flag

# --- Release pipeline working copies ------------------------------------------
# build_release.bat wipes and rewrites these on every build; they are never
# handed to a recipient. Only the finished files in release/ and the bundled
# runtime input in build/ belong in the repository. Keeping several 200 MB
# working copies in history is what once grew .git past 1 GB.
MathChecker_Distribution/portable/
MathChecker_Distribution/release_staging/
MathChecker_Distribution/previous_builds/

# --- .NET / WPF desktop client ------------------------------------------------
# Build output and the ~300 MB staged release (client + backend + Python runtime)
# are reproducible with desktop\build_release.ps1 and must never be committed.
desktop/**/bin/
desktop/**/obj/
desktop/artifacts/
# The finished installer/ZIP/checksums are build output (~190 MB): reproducible
# with desktop\build_release.ps1 and too large for history. The configuration
# that produces them (desktop\installer, desktop\build_release.ps1) is tracked.
release/
desktop/**/TestResults/
*.trx
.vs/
*.user
*.suo

# --- Logs and temp ------------------------------------------------------------
logs/
*.log
tmp/
.DS_Store
Thumbs.db

# --- Dev-only scratch (never shipped, safe to delete) -------------------------
dev_local/
.live_verify/
frontend/tsconfig.tsbuildinfo
frontend/coverage/
frontend/.vite/

# Design-review screenshots were captured against the teacher's live data set and
# therefore show student names; they stay on the machine that captured them.
docs/ui-ux-redesign/screenshots/

# Verification and packaging transcripts are local evidence, not source. The app's
# own logs live in data/logs/ (also ignored). Share a transcript deliberately after
# checking it for student data; never rely on it being in a clean checkout.
docs/logs/
MathChecker_Distribution/logs/

# Loose credential files (moved into data/secrets/)
*.env
API_KEYS.env
!.env.example

# --- graphify (knowledge graph) ---------------------------------------------
# graphify-out/graph.json and GRAPH_REPORT.md are the shared graph artefacts and
# stay trackable: AGENTS.md tells agents to query graph.json before grepping and
# accepts that the whole file is rewritten on every rebuild. Everything else in
# graphify-out/ is machine-local and regenerated from source, so it is not
# versioned: the extraction cache, the incremental manifest, and graphify's own
# bookkeeping files. To drop the graph from version control entirely instead,
# replace the three lines below with a single `graphify-out/`.
graphify-out/cache/
graphify-out/manifest.json
graphify-out/.graphify_*
graphify-out/memory/
# Rendered graph.html is big (>10k nodes) and regenerable via `graphify export html`.
graphify-out/*.html
